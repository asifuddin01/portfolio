{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "audit": "node scripts/audit.mjs",
    "contrast": "node scripts/contrast.mjs",
    "plates": "node scripts/fetch-plates.mjs",
    "og": "node scripts/make-og.mjs",
    "verify": "npm run build && npm run audit && npm run contrast && npm run check",
    "prebuild": "node scripts/sync-cms.mjs",
    "predev": "node scripts/sync-cms.mjs",
    "deploy:manual": "npm run build && wrangler pages deploy dist --project-name=codex",
    "dev:restart": "astro dev stop || true && astro dev"
