  "dependencies": {
    "@astrojs/mdx": "^7.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sveltia/cms": "^0.193.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.124.0"
