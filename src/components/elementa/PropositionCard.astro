---
interface Props {
  bookNumeral: string;
  proposition: number;
  statement: string;
  slug: string;
  status: 'draft' | 'published';
}
const { bookNumeral, proposition, statement, slug, status } = Astro.props;
---
<a class="pcd" href={`/elementa/${slug}`}>
  <span class="pcd-ref">Book {bookNumeral} · Prop. {proposition}</span>
  <span class="pcd-st">{statement}</span>
  {status === 'draft' && <span class="pcd-draft">draft</span>}
</a>
<style>
  .pcd {
    display: block;
    padding: 0.95rem 0;
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent);
    color: var(--ink);
  }
  .pcd-ref {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.22rem;
  }
  .pcd-st { font-family: var(--font-display); font-size: var(--t-md); line-height: 1.4; }
  .pcd:hover .pcd-st { color: var(--fundus); }
  .pcd-draft {
    margin-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--oxblood-text);
    border: var(--rule) solid var(--oxblood);
    padding: 0.05em 0.4em;
  }
</style>
