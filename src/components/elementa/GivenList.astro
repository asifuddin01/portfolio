---
import type { CollectionEntry } from 'astro:content';
import { getBookIndex } from '../../lib/collections';
import { toRoman } from '../../consts';

interface Props {
  given: string[];
  all: CollectionEntry<'elementa'>[];
}
const { given, all } = Astro.props;
const bookIndex = await getBookIndex();

const resolved = given
  .map((slug) => all.find((e) => e.id === slug))
  .filter((e): e is CollectionEntry<'elementa'> => Boolean(e));
---
<div class="gv">
  <p class="gv-label">Given</p>
  {resolved.length === 0 ? (
    <p class="gv-none">Nothing. This proposition stands on its own.</p>
  ) : (
    <ul class="gv-list">
      {resolved.map((p) => (
        <li>
          <a class="link" href={`/elementa/${p.id}`}>
            Book {toRoman(bookIndex.get(p.data.book.id)?.n ?? 0)}, Prop. {p.data.proposition} — {p.data.statement}
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
<style>
  .gv {
    margin: 2rem 0;
    padding: 1rem 0 0;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    max-width: var(--measure);
  }
  .gv-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.6rem;
  }
  .gv-none { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); margin: 0; }
  .gv-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .gv-list li { font-family: var(--font-mono); font-size: var(--t-xs); line-height: 1.7; }
</style>
