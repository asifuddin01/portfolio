---
/**
 * Elementa's plate: one forward pass, then one backward pass.
 *
 * It belongs on this page rather than anywhere else because it is the subject
 * of the book — Book I is the perceptron, backpropagation and optimisation,
 * and this is those three things happening. Signal crosses left to right and
 * the nodes take their values; gradient returns right to left along the same
 * wires, in a different colour, and the edges that carry the most of it are
 * the ones that would move most under an update.
 *
 * It loops, and the caption says so, because one pair of passes is not
 * training — the repetition is. A plate that ran once and stopped would be a
 * diagram of a single step, which is the thing nobody actually does.
 *
 * Nothing is illustrated. Weights come from a seeded generator, activations
 * are what this network computes for a fixed input, and the edge intensities
 * on the way back are real gradients from one backward pass — all in
 * `lib/network.ts`, evaluated at build time. The page ships numbers, not a
 * simulation, and the animation is pure CSS.
 */
import katex from 'katex';
import { build, maxAbs } from '../../lib/network';
/* KaTeX's stylesheet. Imported here rather than relied on from the page, so
   the plate carries what it needs wherever it is placed. Astro dedupes it
   against the Elementa routes that already import the same file. */
import '../../styles/math.css';

/**
 * One formula per completed loop, in the order the animation performs them:
 * the unit computes a weighted sum, an activation shapes it, a loss scores the
 * output, and the update moves the weight. The plate shows the mechanism; these
 * name it.
 *
 * Rendered at build time with `throwOnError`, on the same principle as the
 * rest of the corpus (spec §5.8) — a malformed formula stops the build rather
 * than shipping as a red string nobody notices.
 */
type Eq = { label: string; tex: string };

/** What the forward pass just did — shown once it has crossed. */
const FORWARD_EQ: Eq[] = [
  { label: 'the unit', tex: String.raw`z = \sum_{i=1}^{n} w_i x_i + b = \mathbf{w} \cdot \mathbf{x} + b` },
  { label: 'activation', tex: String.raw`a = f(z)` },
  { label: 'ReLU', tex: String.raw`f(z) = \max(0,\, z)` },
  { label: 'logistic', tex: String.raw`f(z) = \frac{1}{1 + e^{-z}}` },
];

/** What the backward pass just did — shown once the gradient has returned. */
const BACKWARD_EQ: Eq[] = [
  { label: 'the loss', tex: String.raw`L = \tfrac{1}{2}\,(\hat{y} - y)^2` },
  { label: 'the update', tex: String.raw`w_{\text{new}} = w_{\text{old}} - \alpha \, \frac{\partial L}{\partial w_{\text{old}}}` },
];

const render = (e: Eq) => ({
  ...e,
  html: katex.renderToString(e.tex, { displayMode: false, throwOnError: true }),
});
const FWD_EQ = FORWARD_EQ.map(render);
const BWD_EQ = BACKWARD_EQ.map(render);

const LAYERS = build(7);
const W = 300;
const H = 220;
const PAD_X = 26;
const PAD_Y = 22;

/**
 * Column x for a layer, row y for a node.
 *
 * Every layer uses the *widest* layer's spacing and is then centred in the
 * band, so the columns line up and nothing leaves the box. The first version
 * spaced each layer across the full span and then applied a centring fudge,
 * which put the input layer's fourth node at y=233 and the output layer's
 * third at y=251 — in a viewBox 220 tall, with overflow visible, so they
 * painted straight over the caption underneath.
 */
const cx = (l: number) => PAD_X + (l * (W - PAD_X * 2)) / (LAYERS.length - 1);

const SPAN = H - PAD_Y * 2;
const WIDEST = Math.max(...LAYERS.map((l) => l.a.length));
const STEP = SPAN / (WIDEST - 1);

const cy = (l: number, i: number) => {
  const n = LAYERS[l].a.length;
  if (n === 1) return H / 2;
  const top = PAD_Y + (SPAN - (n - 1) * STEP) / 2;
  return top + i * STEP;
};

const wMax = maxAbs(LAYERS, 'w');
const gMax = maxAbs(LAYERS, 'g');

/**
 * Every edge, flattened, with its geometry and its length.
 *
 * `len` is needed per edge because the travelling pulse is a dash moving along
 * the stroke, and a dash pattern is in user units — one shared length would
 * make the short edges pulse fast and the long ones lag.
 */
const EDGES = LAYERS.flatMap((layer, l) =>
  layer.edges.map((e) => {
    const x1 = cx(l - 1), y1 = cy(l - 1, e.from);
    const x2 = cx(l), y2 = cy(l, e.to);
    return {
      ...e,
      layer: l,
      x1, y1, x2, y2,
      len: Math.hypot(x2 - x1, y2 - y1),
      /** Relative magnitudes, for stroke weight and for which edges pulse. */
      rw: Math.abs(e.w) / wMax,
      rg: Math.abs(e.g) / gMax,
    };
  })
);

/**
 * Which edges carry a visible packet.
 *
 * Not all 78: every wire lighting at once is a shimmer rather than a wave, and
 * a weight near zero passes almost nothing, so drawing it as a bright packet
 * would misdescribe the network. At 0.3 of the maximum, 51 of 78 carry signal
 * forward and 39 carry gradient back — enough that the wave reads as crossing
 * the whole layer, few enough that the strong paths still stand out.
 */
const FORWARD = EDGES.filter((e) => e.rw > 0.3);
const BACKWARD = EDGES.filter((e) => e.rg > 0.3);

---
<figure class="np" data-reveal aria-labelledby="np-cap">
  <svg
    class="np-svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="A four-layer neural network. Signal crosses from the input layer to the output, then gradient returns along the same connections in the opposite direction."
  >
    {/* The wires. Width follows |weight|, so the network's shape is visible
        before anything moves. */}
    {EDGES.map((e) => (
      <line
        class="np-wire"
        x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
        stroke-width={(0.25 + e.rw * 0.85).toFixed(2)}
        stroke-opacity={(0.1 + e.rw * 0.3).toFixed(2)}
      />
    ))}

    {/* Forward: a packet of signal crossing each strong wire, layer by layer. */}
    {FORWARD.map((e) => (
      <line
        class="np-fwd"
        x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
        stroke-width={(0.5 + e.rw * 1.1).toFixed(2)}
        style={`--len:${e.len.toFixed(1)}; --end:${(-e.len).toFixed(1)}; --l:${e.layer}`}
      />
    ))}

    {/* Backward: the same wires, the other way, scaled by |dLoss/dw|. */}
    {BACKWARD.map((e) => (
      <line
        class="np-bwd"
        x1={e.x2} y1={e.y2} x2={e.x1} y2={e.y1}
        stroke-width={(0.5 + e.rg * 1.3).toFixed(2)}
        style={`--len:${e.len.toFixed(1)}; --end:${(-e.len).toFixed(1)}; --l:${LAYERS.length - e.layer}`}
      />
    ))}

    {/* The units. The ring is the neuron; the fill is what it computed. */}
    {LAYERS.map((layer, l) =>
      layer.a.map((a, i) => (
        <g class="np-node" style={`--l:${l}`}>
          <circle class="np-ring" cx={cx(l)} cy={cy(l, i)} r="5.4" />
          <circle
            class="np-fill"
            cx={cx(l)} cy={cy(l, i)}
            r={(1.6 + Math.abs(a) * 3.4).toFixed(2)}
            data-sign={a >= 0 ? 'pos' : 'neg'}
          />
        </g>
      ))
    )}
  </svg>

  {/* Two formulae per cycle, each naming the pass that has just finished — the
      forward computation once signal has crossed, the loss and the update once
      gradient has returned. One slot, because they never show at the same
      time, with its height reserved so the caption below never jogs. */}
  <div class="np-eq" aria-hidden="true">
    {FWD_EQ.map((f, i) => (
      <span class="np-eq-i np-eq-f" style={`--i:${i}`}>
        <span class="np-eq-l">{f.label}</span>
        <span class="np-eq-m" set:html={f.html} />
      </span>
    ))}
    {BWD_EQ.map((f, i) => (
      <span class="np-eq-i np-eq-b" style={`--i:${i}`}>
        <span class="np-eq-l">{f.label}</span>
        <span class="np-eq-m" set:html={f.html} />
      </span>
    ))}
  </div>

  <figcaption class="np-cap" id="np-cap">
    <span class="np-cap-n">Figura II</span>
    <span class="np-cap-t">One forward pass, one backward pass — and it continues</span>
    <span class="np-cap-d">
      Signal crosses; the units take their values. Gradient returns along the
      same wires, and the bright ones are where the loss is most sensitive —
      which is to say, where an update would move things. Then it happens
      again. The repetition is the training.
    </span>
  </figcaption>
</figure>

<style>
  /* 9.5s, up from 7.6. The cycle now has to hold four phases rather than
     three — pass, formula, pass, formula — and at the old length the window
     after the forward pass was about a second, which is not long enough to
     read `z = \sum w_i x_i + b`. */
  /* --hop is one layer-to-layer crossing. Three of them make the forward pass,
     and a packet does not leave a layer until the packets feeding it have
     arrived — which is the only order a network actually computes in. */
  .np { margin: 0; display: grid; gap: 0.9rem; --cycle: 9500ms; --hop: 760ms; }
  .np-svg { width: 100%; height: auto; display: block; overflow: visible; }

  .np-wire { stroke: var(--brass); }
  .np-ring { fill: none; stroke: var(--brass); stroke-opacity: 0.5; stroke-width: 0.7; }
  .np-fill { fill: var(--brass-text); }
  /* A negative activation is not a smaller positive one. */
  .np-fill[data-sign='neg'] { fill: var(--verdigris); }

  /* Resting state: both passes invisible, so with motion disabled the plate is
     the network itself — wires, units and their values — and nothing flickers. */
  .np-fwd, .np-bwd { stroke-linecap: round; opacity: 0; }
  .np-fwd { stroke: var(--fundus); }
  .np-bwd { stroke: var(--oxblood-text); }

  /* The formula slot. Height is reserved whether or not anything is showing,
     and the equations are stacked in it rather than swapped, so nothing moves
     when one replaces another. */
  .np-eq {
    position: relative;
    min-height: 2.6rem;
    display: grid;
    align-items: center;
  }
  .np-eq-i {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    /* Only the running one is shown. Without motion the first stands alone —
       see the reduced-motion rule at the end. */
    opacity: 0;
  }
  .np-eq-l {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .np-eq-m { color: var(--ink); }

  .np-cap { display: grid; gap: 0.25rem; max-width: 26rem; }
  .np-cap-n {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .np-cap-t {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--t-sm);
    color: var(--ink);
  }
  .np-cap-d { font-size: var(--t-xs); line-height: 1.65; color: var(--ink-soft); }

  /* With motion disabled nothing cycles, so the first equation stands rather
     than the slot sitting empty under a network with no explanation. */
  @media (prefers-reduced-motion: reduce) {
    /* Nothing cycles, so one from each phase stands rather than the slot
       sitting empty under a network with no explanation. */
    .np-eq { min-height: 5rem; align-content: center; gap: 0.35rem; }
    .np-eq-i { position: static; opacity: 1; }
    .np-eq-f:not(:first-of-type), .np-eq-b:not(:first-of-type) { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The wires and units draw themselves once, outward from the input. */
    :global(.js) .np-node { opacity: 0; transition: opacity 500ms var(--ease-out); }
    :global(.js) .np.is-revealed .np-node {
      opacity: 1;
      transition-delay: calc(var(--l) * 160ms);
    }
    :global(.js) .np-wire { opacity: 0; transition: opacity 700ms var(--ease-out) 240ms; }
    :global(.js) .np.is-revealed .np-wire { opacity: 1; }

    /* A packet is a short dash travelling the length of its own wire. The
       pattern is `dash, len`, so exactly one dash is ever on a wire, and the
       offset carries it from one end to the other. */
    /* One hop at a time.
       `--l` is the crossing's index — 1, 2, 3 going forward, and reversed for
       the return — so `(--l - 1) * --hop` holds each layer back until the one
       feeding it has finished. The stagger used to be 140ms against a 2280ms
       traversal, which is not a wave: every layer was lit at once and the
       whole network flashed. A hop is now the full width of a crossing, so
       the second layer starts as the first arrives. */
    :global(.js) .np.is-revealed .np-fwd {
      stroke-dasharray: 7 var(--len);
      animation: np-fwd var(--cycle) linear infinite;
      animation-delay: calc(900ms + (var(--l) - 1) * var(--hop));
    }
    :global(.js) .np.is-revealed .np-bwd {
      stroke-dasharray: 7 var(--len);
      animation: np-bwd var(--cycle) linear infinite;
      animation-delay: calc(900ms + (var(--l) - 1) * var(--hop));
    }

    /* The cycle in four beats, as fractions of --cycle:
         0–24%   signal crosses
         30–46%  what the forward pass just computed
         48–70%  gradient returns
         76–97%  the loss, and the update it implies
       Everything shares one 900ms origin, and the gaps are sized against the
       *staggered* end of each pass rather than its nominal one. That is what
       went wrong first: layers are offset from each other, so the last
       packet lands well after the keyframe percentage suggests, and the
       formula was opening while the final wire was still lighting. With a
       140ms stagger the last forward packet lands at 3.6s and the formula
       opens at 3.75s; the last backward packet lands at 8.0s and its formula
       opens at 8.1s. Verified by sampling, not by arithmetic alone. */
    /* The offset runs +dash to -len, and getting this backwards is why the
       wires looked dead.
       `stroke-dashoffset: d` shifts the pattern backwards along the path, so
       the dash drawn at [0, 7] in pattern space appears at [-d, 7-d]. The
       first version animated d from len+7 down to 0 — from entirely before the
       start to exactly at the start — so the packet never crossed the wire at
       all. Opacity was animating the whole time, which is why a check for
       "how many are lit" passed while nothing was visible.
       Running d from +7 to -len carries it on at one end and off at the
       other, which is the whole point. */
    /* The end value is emitted by the component as `--end`, not derived here.
       Two earlier versions failed on exactly this line. `stroke-dashoffset:
       calc(var(--len) + 7px)` animating to 0 moved the packet from before the
       start *to* the start, so it never crossed the wire; replacing that with
       `calc(-1 * var(--len))` left the computed offset unresolvable and stuck
       at 7. Both times the opacity animated correctly, so a check for "how
       many are lit" reported success while the wires were visibly dead.
       A plain custom property has nothing left to get wrong. */
    /* A pulse now spans one hop — 8% of the cycle, 760ms — rather than the
       whole pass. Three hops staggered by the same 8% make the forward phase,
       so the packets arrive at a layer and leave it in order. */
    @keyframes np-fwd {
      0%   { stroke-dashoffset: 7; opacity: 0; }
      1%   { opacity: 1; }
      7%   { opacity: 1; }
      8%   { stroke-dashoffset: var(--end); opacity: 0; }
      100% { stroke-dashoffset: var(--end); opacity: 0; }
    }
    @keyframes np-bwd {
      0%, 48% { stroke-dashoffset: 7; opacity: 0; }
      49%     { opacity: 1; }
      55%     { opacity: 1; }
      56%     { stroke-dashoffset: var(--end); opacity: 0; }
      100%    { stroke-dashoffset: var(--end); opacity: 0; }
    }

    /* Two rotations, not one. The four forward formulae take four cycles to
       come round; the two backward ones take two. Each element runs its own
       group's period offset by one cycle, so exactly one of the six is ever
       showing and each appears in the window belonging to the pass it
       describes. Still one timeline and no script.

       The percentages are that window expressed against the group's period:
       28–44% of a single cycle is 7–11% of four, and 75–97% of a single cycle
       is 37.5–48.5% of two. */
    :global(.js) .np.is-revealed .np-eq-f {
      animation: np-eq-f calc(var(--cycle) * 4) linear infinite;
      animation-delay: calc(900ms + var(--i) * var(--cycle));
    }
    :global(.js) .np.is-revealed .np-eq-b {
      animation: np-eq-b calc(var(--cycle) * 2) linear infinite;
      animation-delay: calc(900ms + var(--i) * var(--cycle));
    }
    @keyframes np-eq-f {
      0%, 7.1%     { opacity: 0; transform: translateY(3px); }
      7.5%, 11.1%  { opacity: 1; transform: none; }
      11.5%, 100%  { opacity: 0; transform: translateY(-3px); }
    }
    @keyframes np-eq-b {
      0%, 37.6%    { opacity: 0; transform: translateY(3px); }
      38%, 48.2%   { opacity: 1; transform: none; }
      48.5%, 100%  { opacity: 0; transform: translateY(-3px); }
    }

    /* Each unit brightens as the wave reaches it, and again on the way back. */
    /* A unit brightens when its own inputs land, so the delay is its layer's
       hop rather than a fixed offset. One peak, not two: a second peak timed
       for the return would need the reverse layer order, and running both from
       one keyframe set made the backward wave appear to travel forward. The
       return is carried by the oxblood packets instead. */
    :global(.js) .np.is-revealed .np-fill {
      animation: np-lit var(--cycle) ease-in-out infinite;
      animation-delay: calc(900ms + var(--l) * var(--hop));
      transform-box: fill-box;
      transform-origin: center;
    }
    /* The peak sits at the moment this layer's inputs arrive, which the
       per-layer delay has already placed correctly. */
    @keyframes np-lit {
      0%       { transform: scale(1); }
      3%       { transform: scale(1.55); }
      11%      { transform: scale(1); }
      100%     { transform: scale(1); }
    }
  }
</style>
