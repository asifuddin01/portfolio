---
/**
 * §7.1, Theory — a named formal result, with the boundary of its guarantee.
 *
 * The scope note is not optional and not a footnote: it renders in the same
 * register as the theorem. Universal approximation does not promise a
 * learnable width. Backdoor adjustment does not promise the graph is right.
 * A result stated without its limits has been quoted, not taught.
 */
interface Props { id: string; name: string; statement: string; doesNotPromise: string }
const { id, name, statement, doesNotPromise } = Astro.props;
---
<article class="fr" id={id.replace(/\./g, '-').toLowerCase()}>
  <header class="fr-head">
    <span class="fr-id">{id}</span>
    <h3 class="fr-name">{name}</h3>
  </header>
  <p class="fr-statement">{statement}</p>
  <div class="fr-scope">
    <p class="fr-label">What this does not promise</p>
    <p class="fr-scope-body">{doesNotPromise}</p>
  </div>
</article>

<style>
  .fr {
    max-width: 64rem;
    margin: 1.6rem 0;
    border: var(--rule) solid color-mix(in srgb, var(--brass) 50%, transparent);
    padding: 1rem 1.2rem;
    background: var(--paper-raised);
    scroll-margin-top: 6rem;
  }
  .fr-head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; margin-bottom: 0.5rem; }
  .fr-id {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    color: var(--brass-text);
  }
  .fr-name { font-family: var(--font-display); font-size: var(--t-md); margin: 0; line-height: 1.3; }
  .fr-statement { font-size: var(--t-base); line-height: 1.7; margin: 0 0 0.9rem; max-width: var(--measure); }
  .fr-scope {
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 30%, transparent);
    padding-top: 0.7rem;
  }
  .fr-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oxblood-text);
    margin: 0 0 0.35rem;
  }
  .fr-scope-body { font-size: var(--t-base); line-height: 1.7; margin: 0; max-width: var(--measure); }
</style>
