---
/**
 * "(I.5.4)" as a link. Resolves across books: an equation numbered in Book I
 * is citable from Book IV without either page knowing about the other.
 */
import { getChapters } from '../../lib/collections';

interface Props { id: string }
const { id } = Astro.props;

const chapterId = id.split('.').slice(0, 2).join('.');
const chapters = await getChapters();
const chapter = chapters.find((c) => c.data.id === chapterId);
const href = chapter
  ? `/elementa/${chapter.data.book.id}/${chapter.id.split('--')[1]}#eq-${id.replace(/\./g, '-')}`
  : null;
---
{href
  ? <a class="link eq-ref" href={href}>({id})</a>
  : <span class="eq-ref">({id})</span>}
