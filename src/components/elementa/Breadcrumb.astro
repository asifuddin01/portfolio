---
/**
 * Where the reader is (spec §17). Every Elementa page shows its own position,
 * so the corpus reads as a structure rather than a pile of pages.
 *
 * The numerals come from the ids the content declares, never from a page's
 * position in a list — reordering the shelf must not renumber Book V.
 */
import MathTier from './MathTier.astro';
import type { MathTier as Tier } from '../../lib/elementa-spec';

interface Props {
  bookNumeral?: string;
  bookTitle?: string;
  bookHref?: string;
  chapterN?: number;
  chapterTitle?: string;
  chapterHref?: string;
  proposition?: number;
  tier?: Tier;
  /** A trailing step that is not a chapter, e.g. "Problems". */
  leaf?: string;
}
const {
  bookNumeral, bookTitle, bookHref, chapterN, chapterTitle, chapterHref,
  proposition, tier, leaf,
} = Astro.props;
---
<nav class="bc" aria-label="Position in the corpus">
  <a class="bc-root" href="/elementa">Elementa</a>
  {bookTitle && (
    <>
      <span class="bc-sep" aria-hidden="true">·</span>
      <a class="bc-step" href={bookHref}>
        <span class="bc-n">Book {bookNumeral}</span> {bookTitle}
      </a>
    </>
  )}
  {chapterTitle && (
    <>
      <span class="bc-sep" aria-hidden="true">·</span>
      <a class="bc-step" href={chapterHref}>
        <span class="bc-n">Chapter {chapterN}</span> {chapterTitle}
      </a>
    </>
  )}
  {proposition !== undefined && (
    <>
      <span class="bc-sep" aria-hidden="true">·</span>
      <span class="bc-step bc-here">Proposition {proposition}</span>
    </>
  )}
  {leaf && (
    <>
      <span class="bc-sep" aria-hidden="true">·</span>
      <span class="bc-step bc-here">{leaf}</span>
    </>
  )}
  {tier && <span class="bc-tier"><MathTier value={tier} showName={false} /></span>}
</nav>

<style>
  .bc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin-bottom: 1.8rem;
  }
  .bc-root, .bc-step { color: var(--ink-soft); }
  .bc-root:hover, .bc-step:hover { color: var(--fundus); }
  .bc-sep { color: var(--brass-text); }
  .bc-n {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .bc-here { color: var(--ink); }
  .bc-tier { margin-left: auto; }
</style>
