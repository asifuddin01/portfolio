---
/**
 * The single permitted full-page texture.
 *
 * The turbulence is baked into one 180×180 tile delivered as a data URI and
 * repeated, rather than run as a live filter across the whole viewport. A
 * full-viewport feTurbulence is re-rasterised on every paint and was worth
 * well over a second of main-thread time on its own.
 */
const noise = `<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>`;
const uri = `url("data:image/svg+xml,${encodeURIComponent(noise).replace(/'/g, '%27')}")`;
---
<div class="grain" aria-hidden="true" style={`background-image:${uri}`}></div>
<style>
  .grain {
    position: fixed;
    inset: 0;
    background-repeat: repeat;
    background-size: 180px 180px;
    opacity: 0.035;
    pointer-events: none;
    z-index: 50;
    mix-blend-mode: multiply;
    will-change: auto;
  }
  :global([data-theme='nocturne']) .grain { mix-blend-mode: screen; opacity: 0.05; }
</style>
