---
import LesionRule from '../ornament/LesionRule.astro';
import { getEntry, render } from 'astro:content';
import { EMAIL, GITHUB, LINKEDIN } from '../../consts';

const entry = await getEntry('site', 'colophon');
const Colophon = entry ? (await render(entry)).Content : null;
---
<footer class="cp">
  <div class="codex">
    <LesionRule />
    <div class="cp-body" data-reveal>
      <div class="cp-text">{Colophon && <Colophon />}</div>
      <ul class="cp-links">
        <li><a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li><a class="link" href={GITHUB} rel="me">github</a></li>
        <li><a class="link" href={LINKEDIN} rel="me">linkedin</a></li>
        <li>
          <a class="link" href="/cv/Md-Asif-Uddin-CV.pdf" download>
            curriculum vitae (pdf)
          </a>
        </li>
        <li><a class="link" href="/images">images</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .cp { padding-bottom: 4.5rem; }
  .cp-body {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .cp-text :global(p) { margin: 0; }
  .cp-text {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.9;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0;
  }
  .cp-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.03em;
  }
</style>
