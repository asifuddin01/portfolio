---
import ThemeToggle from './ThemeToggle.astro';
import { NAV, AUTHOR } from '../../consts';

const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="hd">
  <div class="codex hd-inner">
    <a class="hd-name" href="/">{AUTHOR}</a>
    <nav class="hd-nav" aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['hd-link', { 'is-here': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .hd {
    position: relative;
    z-index: 40;
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 55%, transparent);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(8px);
  }
  .hd-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.9rem;
    flex-wrap: wrap;
  }
  .hd-name {
    font-family: var(--font-display);
    font-size: var(--t-base);
    letter-spacing: 0.03em;
    color: var(--ink);
    margin-right: auto;
    white-space: nowrap;
  }
  .hd-nav ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .hd-link {
    font-family: var(--font-mono);
    font-size: var(--t-nav);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hd-link { transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out); }
  }
  .hd-link:hover { color: var(--fundus); border-bottom-color: var(--fundus); }
  .hd-link.is-here { color: var(--fundus); border-bottom-color: var(--brass); }

  @media (max-width: 560px) {
    .hd-inner { gap: 0.85rem; }
    .hd-name { font-size: var(--t-sm); width: 100%; margin-right: 0; }
    .hd-nav ul { gap: 1rem; }
  }
</style>
