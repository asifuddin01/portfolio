---
import { SITE, AUTHOR, ROLE } from '../../consts';
import { getContact } from '../../lib/collections';

interface Props {
  title: string;
  description: string;
  /** Route-level OG image, absolute or root-relative. */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image = '/og.png', type = 'website' } = Astro.props;

const { github, linkedin } = await getContact();
// Astro's pathname keeps a trailing slash; the links and the served URL do
// not. A canonical that names a different address than the one linked is a
// canonical pointing at a redirect.
const path = Astro.url.pathname.replace(/(.+)\/$/, '$1');
const canonical = new URL(path, SITE).href;
const ogImage = new URL(image, SITE).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR,
  jobTitle: 'Deep learning researcher',
  description: ROLE,
  url: SITE,
  sameAs: [github, linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'BRAC University' },
  knowsAbout: [
    'Deep learning', 'Medical image analysis', 'Diabetic retinopathy',
    'Vision-language models', 'Causal inference', 'Single-cell biology',
  ],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR} />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={AUTHOR} />
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#E7E1CE" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#131110" media="(prefers-color-scheme: dark)" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
