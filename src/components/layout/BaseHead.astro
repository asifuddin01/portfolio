---
/**
 * The three faces the first screen is set in, imported for their built URLs.
 *
 * Every @font-face on the site is declared inside the stylesheet, so the
 * browser could not learn a font existed until it had fetched and parsed
 * 58KB of CSS: measured cold, the fonts were not requested until 646ms and
 * did not land until 1043ms, and the page spent that second set in a fallback
 * before re-flowing into the real thing. Naming them here puts them in front
 * of the preload scanner in the first packet of HTML instead.
 *
 * Upright only, and only the latin subsets. The italics and the Greek, maths
 * and symbol subsets are still declared in the stylesheet and still load on
 * the pages that need them — they are simply not worth a head start, and four
 * or five preloads compete with each other for the same bandwidth.
 */
import fontSerif from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import fontDisplay from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url';
import fontMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

import { ogPathFor } from '../../lib/og';
import { SITE, AUTHOR } from '../../consts';
import { getContact, getRole } from '../../lib/collections';

interface Props {
  title: string;
  description: string;
  /** Route-level OG image, absolute or root-relative. */
  image?: string;
  type?: 'website' | 'article';
  /** Emits robots noindex. Used by routes behind Cloudflare Access. */
  noindex?: boolean;
}

const { title, description, image, type = 'website', noindex } = Astro.props;

/**
 * The page's own social card.
 *
 * Every page shared the same one until now, so a link to a proposition and a
 * link to the CV arrived in a chat window looking identical — and the card is
 * the only part of the site most people see before deciding whether to open it.
 *
 * A route may still pass `image` to override this. The file itself is rendered
 * after the build from the address written here; see scripts/build-og.mjs.
 */
const ogPath = image ?? ogPathFor(Astro.url.pathname);

const { github, linkedin } = await getContact();
const role = await getRole();
// Astro's pathname keeps a trailing slash; the links and the served URL do
// not. A canonical that names a different address than the one linked is a
// canonical pointing at a redirect.
const path = Astro.url.pathname.replace(/(.+)\/$/, '$1');
const canonical = new URL(path, SITE).href;
const ogImage = new URL(ogPath, SITE).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR,
  /**
   * Both, and the engineering first — this is the field a search engine reads
   * for a knowledge panel, and it was the last place the site still described
   * him only as a researcher after the frontispiece, the meta tags and the
   * title had all moved.
   */
  /* Both are true and both are searched for, but the order is not cosmetic:
     the first is what he leads with, and research is the strength. */
  jobTitle: ['Deep learning researcher', 'AI/ML engineer'],
  description: role,
  url: SITE,
  sameAs: [github, linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'BRAC University' },
  knowsAbout: [
    'Deep learning', 'Medical image analysis', 'Diabetic retinopathy',
    'Vision-language models', 'Causal inference', 'Single-cell biology',
  ],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Ahead of the stylesheet on purpose: the preload scanner reads these
     before it has fetched any CSS, which is the whole point of them. -->
<link rel="preload" as="font" type="font/woff2" href={fontSerif} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={fontDisplay} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={fontMono} crossorigin />

<title>{title}</title>

<!-- Feed discovery. Without this the feed exists and no reader finds it:
     browsers and feed apps look for exactly this tag on any page of a site. -->
<link rel="alternate" type="application/rss+xml" title={`${AUTHOR} — writing`} href={new URL('rss.xml', SITE).href} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={AUTHOR} />
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#E7E1CE" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#131110" media="(prefers-color-scheme: dark)" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
