---
import Chapter from './Chapter.astro';
import { getProjects } from '../../lib/collections';

const items = await getProjects();
---
<Chapter n={9} title="Appendix" id="appendix">
  <p class="ap-note codex-measure" data-reveal>Engineering work, set smaller than the research chapters.</p>
  <ol class="ap" data-reveal-stagger>
    {items.map((it) => (
      <li class="ap-item">
        <h3 class="ap-title">{it.data.title}</h3>
        <p class="ap-body">{it.data.summary}</p>
      </li>
    ))}
  </ol>
</Chapter>

<style>
  .ap-note {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 1.6rem;
  }
  .ap { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6rem; max-width: 58rem; }
  .ap-item {
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 34%, transparent);
    padding-top: 0.9rem;
  }
  .ap-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.07em;
    font-size: var(--t-base);
    margin: 0 0 0.4rem;
  }
  .ap-body { font-size: var(--t-sm); line-height: 1.7; color: var(--ink-soft); margin: 0; max-width: 66ch; }
</style>
