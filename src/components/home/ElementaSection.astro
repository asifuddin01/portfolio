---
import Chapter from './Chapter.astro';
import { getEntry } from 'astro:content';
import { getElementaTree, getPropositionContexts } from '../../lib/collections';
import { toRoman } from '../../consts';

const tree = await getElementaTree();
const meta = await getEntry('site', 'elementa');

/* The three most recently updated propositions, with the path to reach them. */
const recent = (await getPropositionContexts())
  .sort((a, b) => b.entry.data.updated.getTime() - a.entry.data.updated.getTime())
  .slice(0, 3)
  .map((c) => ({
    href: `/elementa/${c.book.id}/${c.chapter.id.split('--')[1]}/${c.entry.id}`,
    bookN: c.bookN,
    chapterN: c.chapterN,
    statement: c.entry.data.statement,
    proposition: c.entry.data.proposition,
  }));
---
<Chapter n={7} title="Elementa" id="elementa">
  {meta?.data.homeIntro && (
    <p class="el-lede codex-measure" data-reveal>{meta.data.homeIntro}</p>
  )}

  <ol class="el-books" data-reveal-stagger>
    {tree.map((b) => (
      <li class="el-book">
        <a class="el-book-row" href={`/elementa/${b.book.id}`}>
          <span class="el-book-n">Book {toRoman(b.n)}</span>
          <span class="el-book-t">{b.book.data.title}</span>
          <span class="el-book-c">{b.book.data.covers}</span>
        </a>
      </li>
    ))}
  </ol>

  {recent.length > 0 && (
    <ul class="el-recent" data-reveal-stagger>
      {recent.map((p) => (
        <li class="el-recent-item">
          <a class="el-recent-link" href={p.href}>
            <span class="el-recent-ref">
              Book {toRoman(p.bookN)} · Chapter {toRoman(p.chapterN)} · Prop. {p.proposition}
            </span>
            <span class="el-recent-st">{p.statement}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  <p class="el-more" data-reveal>
    <a class="link" href="/elementa">The whole corpus</a>
    <span class="el-sep"> · </span>
    <a class="link" href="/elementa/figures">The figure library</a>
  </p>
</Chapter>

<style>
  .el-lede { font-size: var(--body-size); line-height: var(--body-leading); margin-bottom: 2.2rem; }
  .el-books {
    list-style: none;
    margin: 0 0 2.4rem;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 62rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .el-book-row {
    display: grid;
    color: var(--ink);
    /* minmax(0, …) not 1fr: a bare `1fr` floors at the track's min-content,
       so the longest word in `covers` sets a width the row cannot go below
       and the whole page gains a horizontal scrollbar. */
    grid-template-columns: 7rem 12rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
  }
  .el-book { border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent); }
  .el-book-row:hover .el-book-t { color: var(--fundus); }
  .el-book-n {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .el-book-t { font-family: var(--font-display); font-size: var(--t-md); color: var(--ink); }
  .el-book-c { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); line-height: 1.7; }

  .el-recent { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; gap: 0.9rem; max-width: 62rem; }
  .el-recent-link { display: block; color: var(--ink); }
  .el-recent-ref {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.2rem;
  }
  .el-recent-st { font-family: var(--font-display); font-size: var(--t-md); line-height: 1.4; }
  .el-recent-link:hover .el-recent-st { color: var(--fundus); }
  .el-sep { color: var(--brass-text); }

  /* .el-book is the <li>; the grid is the <a> inside it. Naming the wrong one
     here left the three columns at their desktop widths on every phone: 7rem
     + 12rem + gap is 336px before the third column has said anything. */
  @media (max-width: 700px) {
    .el-book-row { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
