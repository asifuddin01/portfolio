---
import Chapter from './Chapter.astro';
import { getEducation } from '../../lib/collections';
import { getEntry } from 'astro:content';

const entries = await getEducation();
const meta = await getEntry('site', 'chronicle');
const coursework = meta?.data.coursework ?? '';
---
<Chapter n={8} title="Chronicle" id="chronicle">
  <ol class="ch" data-reveal-stagger>
    {entries.map((e) => (
      <li class="ch-row">
        <p class="ch-when">{e.data.period}</p>
        <div class="ch-what">
          <h3 class="ch-place">
            {e.data.institution}<span class="ch-where">, {e.data.location}</span>
          </h3>
          {/* Grades are deliberately absent here; they live on the CV. */}
          <p class="ch-line">{e.data.degree}.</p>
          {e.data.detail && <p class="ch-line">{e.data.detail}</p>}
        </div>
      </li>
    ))}
  </ol>

  {coursework && (
    <p class="ch-course" data-reveal>
      <span class="ch-course-label">Coursework</span>
      {coursework}
    </p>
  )}
</Chapter>

<style>
  .ch { list-style: none; margin: 0; padding: 0; max-width: 62rem; }
  .ch-row {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    padding: 1.15rem 0 1.15rem 1.5rem;
    border-left: var(--rule) solid var(--brass);
    position: relative;
  }
  .ch-row::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 1.55rem;
    width: 5px;
    height: 5px;
    background: var(--brass);
  }
  .ch-when {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--brass-text);
    margin: 0;
    font-variant-numeric: lining-nums;
    padding-top: 0.25rem;
  }
  .ch-place { font-size: var(--t-md); font-family: var(--font-display); margin: 0 0 0.3rem; }
  .ch-where { color: var(--ink-soft); font-size: var(--t-base); }
  .ch-line { margin: 0; font-size: var(--t-base); line-height: 1.65; color: var(--ink-soft); }
  .ch-course {
    margin-top: 2rem;
    padding-top: 1.1rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    font-size: var(--t-base);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .ch-course-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-right: 0.7rem;
  }
  @media (max-width: 700px) {
    .ch-row { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
