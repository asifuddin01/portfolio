---
import Chapter from './Chapter.astro';
import { getCollection, getEntry } from 'astro:content';

const groups = (await getCollection('instrumentarium')).sort(
  (a, b) => a.data.order - b.data.order
);
const meta = await getEntry('site', 'instrumentarium');
const notYet = meta?.data.notYet ?? '';

const ROMAN_LOWER = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x', 'xi', 'xii'];
---
<Chapter n={4} title="Instrumentarium" id="instrumentarium">
  <div class="in-grid" data-reveal-stagger>
    {groups.map((g, i) => (
      <section class="in-item">
        <p class="in-fig">Fig. {ROMAN_LOWER[i] ?? i + 1}</p>
        <h3 class="in-title">{g.data.title}</h3>
        <p class="in-items">{g.data.items}</p>
        <p class="in-note">{g.data.note}</p>
      </section>
    ))}
  </div>

  {notYet && <p class="in-not-yet" data-reveal>{notYet}</p>}
</Chapter>

<style>
  .in-grid {
    display: grid;
    /* min(20rem, 100%), not a bare 20rem: below a 20rem column the track floor
       exceeds the container and the page scrolls sideways. Every auto-fill grid
       on the site carries this guard for the same reason. */
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 2.2rem 3rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    padding-top: 2rem;
  }
  .in-item { max-width: 40ch; }
  .in-fig {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.3rem;
  }
  .in-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.09em;
    font-size: var(--t-md);
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .in-items { font-size: var(--t-base); line-height: 1.65; color: var(--ink); margin: 0 0 0.55rem; }
  .in-note {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }
  .in-not-yet {
    margin-top: 2.6rem;
    padding-top: 1.1rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--t-md);
    color: var(--ink-soft);
  }
</style>
