---
import Chapter from './Chapter.astro';
import { getCollection } from 'astro:content';
import { toRoman } from '../../consts';

const entries = (await getCollection('instrumenta')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Chapter n={6} title="Instrumenta propria" id="instrumenta">
  <ol class="ip" data-reveal-stagger>
    {entries.map((e, i) => (
      <li class="ip-item">
        <p class="ip-fig">Fig. {toRoman(i + 1)}</p>
        <h3 class="ip-name">{e.data.name}</h3>
        <p class="ip-problem">{e.data.problem}</p>
        <p class="ip-decision">{e.data.decision}</p>
        {e.data.rejections.length > 0 && (
          <div class="ip-rej">
            <p class="ip-rej-label">Rejected along the way</p>
            <ul class="ip-rej-list">
              {e.data.rejections.map((r) => <li>{r}</li>)}
            </ul>
            <p class="ip-rej-note">Each of these made the result worse.</p>
          </div>
        )}
      </li>
    ))}
  </ol>
</Chapter>

<style>
  .ip { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.6rem; max-width: 60rem; }
  .ip-item {
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    padding-top: 1.3rem;
  }
  .ip-fig {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.35rem;
  }
  .ip-name { font-size: var(--t-lg); color: var(--ink); margin: 0 0 0.7rem; }
  .ip-problem {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--t-md);
    color: var(--ink-soft);
    max-width: var(--measure);
    margin: 0 0 0.7rem;
    line-height: 1.6;
  }
  .ip-decision { font-size: var(--t-base); line-height: 1.7; max-width: var(--measure); margin: 0; }
  .ip-rej {
    margin-top: 1.1rem;
    padding: 1rem 1.2rem;
    background: var(--paper-raised);
    border-left: 2px solid var(--oxblood);
    max-width: var(--measure);
  }
  .ip-rej-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oxblood-text);
    margin: 0 0 0.5rem;
  }
  .ip-rej-list {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink);
  }
  .ip-rej-list li::before { content: '×  '; color: var(--oxblood-text); }
  .ip-rej-note {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin: 0;
  }
</style>
