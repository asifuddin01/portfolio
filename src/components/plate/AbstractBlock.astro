---
/** The paper abstract, verbatim. Never truncated, never paraphrased,
    no "read more" toggle. It is a quotation and should look like one. */
interface Props { abstract: string }
const { abstract } = Astro.props;
---
<figure class="ab" data-reveal>
  <figcaption class="ab-label">Abstract</figcaption>
  <blockquote class="ab-quote"><p>{abstract}</p></blockquote>
</figure>
<style>
  .ab { margin: 2.5rem 0; max-width: var(--measure); }
  .ab-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
    padding-bottom: 0.6rem;
    border-top: var(--rule) solid var(--brass);
    padding-top: 0.6rem;
  }
  .ab-quote {
    margin: 0;
    padding-left: 1.4rem;
    border-left: 2px solid var(--brass);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--ink);
  }
  .ab-quote p { margin: 0; }
</style>
