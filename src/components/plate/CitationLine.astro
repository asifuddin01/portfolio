---
interface Props { citation: string | null; paperUrl: string | null; repoUrl: string | null }
const { citation, paperUrl, repoUrl } = Astro.props;

/**
 * `[SUPPLY]` is an editorial note meaning the citation is not written yet, and
 * it was rendering as the citation — the same failure the abstract block had.
 * A placeholder is not content and must never reach a reader as if it were.
 */
const cite = citation && /^\s*\[[A-Z\s]+\]\s*$/.test(citation) ? null : citation;
const hasAny = Boolean(cite) || Boolean(paperUrl) || Boolean(repoUrl);
---
{hasAny && (
  <div class="cl" data-reveal>
    {cite && <p class="cl-cite">{cite}</p>}
    {(paperUrl || repoUrl) && (
      <p class="cl-links ref-btns">
        {paperUrl && <a class="ref-btn" href={paperUrl} rel="noopener">{/arxiv\.org\//.test(paperUrl) ? 'Preprint (arXiv)' : 'Paper'}</a>}
        {repoUrl && <a class="ref-btn" href={repoUrl} rel="noopener">Repository</a>}
      </p>
    )}
  </div>
)}
<style>
  .cl {
    margin: 2rem 0;
    padding-top: 1rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.8;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .cl-cite { margin: 0 0 1rem; }
</style>
