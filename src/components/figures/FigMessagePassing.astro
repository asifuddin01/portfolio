---
/**
 * Book I, Ch. XIV, Prop. 1: one round of message passing at one node of the
 * paw graph. The neighbours' states are summed, so their order cannot
 * matter, and the same rule runs at every node.
 */
const NODES = [
  { id: 1, x: 70, y: 70 },
  { id: 2, x: 70, y: 190 },
  { id: 3, x: 160, y: 130 },
  { id: 4, x: 250, y: 130 },
];
const EDGES = [[0, 1], [0, 2], [1, 2], [2, 3]];
---
<svg class="fig" viewBox="0 0 440 320" role="img" aria-labelledby="mp-t mp-d" style="--fig-min: 0px">
  <title id="mp-t">One round of message passing at node 3</title>
  <desc id="mp-d">
    A small graph: a triangle on nodes 1, 2 and 3, and a fourth node joined to
    node 3. Nodes 1, 2 and 4 send their states to node 3. On the right, the
    three messages enter a sum, the sum and node 3's own state enter an update
    function, and the result is node 3's new state. The same rule runs at
    every node, and the sum does not depend on the order of the neighbours.
  </desc>

  <text x="8" y="23" class="t-lab">one round, one node</text>

  {EDGES.map(([a, b]) => (
    <line x1={NODES[a].x} y1={NODES[a].y} x2={NODES[b].x} y2={NODES[b].y} class="wire-soft" />
  ))}
  {[0, 1, 3].map((i) => {
    const s = NODES[i], t = NODES[2];
    const dx = t.x - s.x, dy = t.y - s.y, len = Math.hypot(dx, dy);
    const ex = t.x - (dx / len) * 20, ey = t.y - (dy / len) * 20;
    const sx = s.x + (dx / len) * 18, sy = s.y + (dy / len) * 18;
    return <line x1={sx} y1={sy} x2={ex} y2={ey} class="s3" stroke-width="2" />;
  })}
  {NODES.map((nd) => (
    <g>
      <circle cx={nd.x} cy={nd.y} r="16" style="fill: var(--paper-raised)" />
      <circle cx={nd.x} cy={nd.y} r="16" class={nd.id === 3 ? 'a3' : 'bx-fill'} opacity={nd.id === 3 ? 0.3 : 1} />
      <circle cx={nd.x} cy={nd.y} r="16" class={nd.id === 3 ? 's3' : 'bx'} stroke-width={nd.id === 3 ? 2 : 1} />
      <text x={nd.x} y={nd.y + 5} class="t-md" text-anchor="middle">{nd.id}</text>
    </g>
  ))}

  <rect x="292" y="58" width="132" height="34" class="bx-fill" />
  <text x="358" y="80" class="t-md" text-anchor="middle">h₁ + h₂ + h₄</text>
  <text x="358" y="48" class="t-key" text-anchor="middle">sum: order-free</text>
  <line x1="358" y1="92" x2="358" y2="112" class="wire" />
  <polygon points="353,112 358,122 363,112" class="head" />
  <rect x="292" y="124" width="132" height="34" class="bx-fill" />
  <text x="358" y="146" class="t-md" text-anchor="middle">update φ(h₃, ·)</text>
  <line x1="358" y1="158" x2="358" y2="178" class="wire" />
  <polygon points="353,178 358,188 363,178" class="head" />
  <text x="358" y="206" class="t-md" text-anchor="middle">h₃′</text>

  <text x="8" y="262" class="t-sm">Every node runs the same rule on its own neighbours.</text>
  <text x="8" y="281" class="t-sm">Renumber the nodes and every output moves with its</text>
  <text x="8" y="300" class="t-sm">node: the layer is permutation-equivariant.</text>
</svg>
