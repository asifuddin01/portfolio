---
const cases = [
  { label: 'A', input: [1, 0, 0, 0], output: [1, 0], note: 'First position in the left window.' },
  { label: 'B', input: [0, 1, 0, 0], output: [1, 0], note: 'Move within the window: same output.' },
  { label: 'C', input: [0, 0, 1, 0], output: [0, 1], note: 'Cross the boundary: different output.' },
];
---
<svg class="fig" viewBox="0 0 440 367" role="img" aria-labelledby="pool-t pool-d" style="--fig-min: 0px">
  <title id="pool-t">Pooling hides movement inside a window, not across every boundary</title>
  <desc id="pool-d">One-dimensional max pooling with width two and stride two. Inputs [1,0,0,0] and [0,1,0,0] both give [1,0]. Moving the one across the window boundary to [0,0,1,0] instead gives [0,1].</desc>
  <text x="8" y="23" class="t-lab">Max pooling · width 2 · stride 2</text>
  <text x="45" y="47" class="t-sm">input: two separate windows</text>
  <text x="313" y="47" class="t-sm">output</text>
  {cases.map((item, row) => (
    <g transform={'translate(0,' + (60 + row * 96) + ')'}>
      <text x="8" y="23" class="t-key">{item.label}</text>
      {[0, 1].map(w => <rect x={40 + w * 84} y="-3" width="76" height="40" class="bx-soft" />)}
      {item.input.map((v, i) => (
        <g>
          <rect x={43 + i * 36 + Math.floor(i / 2) * 12} y="0" width="34" height="34" class={v ? 'bx-fill' : 'bx-soft'} />
          <text x={60 + i * 36 + Math.floor(i / 2) * 12} y="23" class="t-md" text-anchor="middle">{v}</text>
        </g>
      ))}
      <line x1="225" y1="17" x2="282" y2="17" class="wire" />
      <polygon points="281,12 290,17 281,22" class="head" />
      {item.output.map((v, i) => (
        <g>
          <rect x={308 + i * 36} y="0" width="34" height="34" class={v ? 'bx-fill' : 'bx-soft'} />
          <text x={325 + i * 36} y="23" class="t-md" text-anchor="middle">{v}</text>
        </g>
      ))}
      <text x="40" y="60" class="t-sm">{item.note}</text>
    </g>
  ))}
  <text x="8" y="351" class="t-sm">The same boundary issue occurs along each image axis.</text>
</svg>
