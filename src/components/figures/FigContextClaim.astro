---
/**
 * Marginalia XVIII — the advertised window against measured comprehension.
 * Retrieval across a window is not comprehension of it.
 */
const M = [
  { t: 'Gemini 2.5 Pro', v: 90.6, cls: 'a4' },
  { t: 'Maverick', v: 28.1, cls: 'a3' },
  { t: 'Scout', v: 15.6, cls: 'a2' },
];
const X0 = 190, W = 400;
---
<svg class="fig" viewBox="0 0 720 280" role="img" aria-labelledby="cc-t cc-d" preserveAspectRatio="xMidYMid meet" style="--fig-min: 640px">
  <title id="cc-t">Long-context comprehension at 120K tokens</title>
  <desc id="cc-d">
    Accuracy on long-context comprehension at a hundred and twenty thousand
    tokens. Scout, which advertises a ten million token window, scores fifteen
    point six percent, well under a competitor at the same length.
  </desc>

  <text x="0" y="22" class="t-lab">comprehension at 120K tokens</text>

  {M.map((m, i) => (
    <g>
      <text x="0" y={72 + i * 52} class="t-md">{m.t}</text>
      <rect x={X0} y={54 + i * 52} width={(m.v / 100) * W} height="26" class={m.cls} />
      <text x={X0 + (m.v / 100) * W + 10} y={73 + i * 52} class="t-key">{m.v}%</text>
    </g>
  ))}

  <line x1="0" y1="222" x2="700" y2="222" class="wire-soft" />
  <text x="0" y="244" class="t-sm">Scout advertises 10,000,000 tokens. Needle-in-a-haystack retrieval across that window is genuinely strong,</text>
  <text x="0" y="262" class="t-sm">and retrieval is not comprehension.</text>
</svg>
