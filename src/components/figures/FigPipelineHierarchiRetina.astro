---
/**
 * The HierarchiRetina pipeline. Hand-written SVG, palette tokens only,
 * no hardcoded black or white so it reads in both themes.
 */
const LESIONS = [
  { cx: 110, label: 'MA',      method: 'HSMoE',      colour: 'var(--lesion-ma)',  full: 'microaneurysms' },
  { cx: 280, label: 'HE',      method: 'MultiScale', colour: 'var(--lesion-he)',  full: 'haemorrhages' },
  { cx: 450, label: 'EX',      method: 'BrightSpot', colour: 'var(--lesion-ex)',  full: 'hard exudates' },
  { cx: 620, label: 'CWS',     method: 'warm-up',    colour: 'var(--lesion-cws)', full: 'cotton wool spots' },
  { cx: 790, label: 'Vessels', method: 'FOV mask',   colour: 'var(--lesion-ves)', full: 'vessels' },
];
---
<svg
  class="pipe"
  viewBox="0 0 900 580"
  role="img"
  aria-labelledby="pipe-title pipe-desc"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="pipe-title">The HierarchiRetina three-stage pipeline</title>
  <desc id="pipe-desc">
    A fundus image enters Stage I screening for referable diabetic retinopathy at
    grade 2 or above. It then branches to five parallel lesion segmentation models —
    microaneurysms, haemorrhages, hard exudates, cotton wool spots and vessels —
    whose masks rejoin the raw image as eight channels into Stage III, the
    lesion-guided grader. Stage III emits either an ordinal severity grade from one
    to four, or an ungradable verdict routed to human review.
  </desc>

  <g class="wire" fill="none" stroke="currentColor" stroke-width="1">
    <line data-draw x1="450" y1="58"  x2="450" y2="97" />
    <line data-draw x1="450" y1="155" x2="450" y2="196" />
    <line data-draw x1="110" y1="196" x2="790" y2="196" />
    {LESIONS.map((l) => <line data-draw x1={l.cx} y1="196" x2={l.cx} y2="226" />)}
    {LESIONS.map((l) => <line data-draw x1={l.cx} y1="290" x2={l.cx} y2="320" />)}
    <line data-draw x1="110" y1="320" x2="790" y2="320" />
    <line data-draw x1="450" y1="320" x2="450" y2="359" />
    <line data-draw x1="450" y1="421" x2="450" y2="458" />
    <line data-draw x1="250" y1="458" x2="650" y2="458" />
    <line data-draw x1="250" y1="458" x2="250" y2="486" />
    <line data-draw x1="650" y1="458" x2="650" y2="486" />
  </g>

  <g class="boxes" fill="none" stroke="currentColor" stroke-width="1" data-fade>
    <rect x="355" y="18"  width="190" height="40" />
    <rect x="290" y="97"  width="320" height="58" />
    <rect x="280" y="359" width="340" height="62" />
    <rect x="125" y="486" width="250" height="62" />
    <rect x="525" y="486" width="250" height="62" />
    {LESIONS.map((l) => <rect x={l.cx - 70} y="226" width="140" height="64" />)}
  </g>

  <g class="accents" data-fade>
    {LESIONS.map((l) => <rect x={l.cx - 70} y="226" width="140" height="4" fill={l.colour} stroke="none" />)}
  </g>

  <g class="labels" data-fade fill="currentColor" text-anchor="middle">
    <text x="450" y="43" class="t-md">Fundus image</text>

    <text x="450" y="121" class="t-md">Stage I · screening</text>
    <text x="450" y="141" class="t-sm">(referable DR, grade ≥ 2)</text>

    {LESIONS.map((l) => (
      <>
        <text x={l.cx} y="256" class="t-md">{l.label}</text>
        <text x={l.cx} y="276" class="t-sm">{l.method}</text>
      </>
    ))}

    <text x="450" y="384" class="t-md">Stage III · LG-DRG</text>
    <text x="450" y="404" class="t-sm">(8 channels: RGB + 5 masks)</text>

    <text x="250" y="512" class="t-md">Severity grade</text>
    <text x="250" y="532" class="t-sm">(CORN ordinal, 1–4)</text>

    <text x="650" y="512" class="t-md">Ungradable</text>
    <text x="650" y="532" class="t-sm">(routed to human review)</text>
  </g>
</svg>

<style>
  .pipe { width: 100%; height: auto; min-width: 620px; color: var(--ink); }
  .wire  { stroke: color-mix(in srgb, var(--ink) 55%, transparent); }
  .boxes { stroke: color-mix(in srgb, var(--brass) 85%, transparent); }
  .t-md { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.02em; }
  .t-sm { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-soft); letter-spacing: 0.02em; }
</style>
