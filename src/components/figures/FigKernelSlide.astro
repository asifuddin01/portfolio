---
const N = 6, S = 28, X0 = 8, Y0 = 54;
---
<svg class="fig" viewBox="0 0 440 290" role="img" aria-labelledby="ks-t ks-d" style="--fig-min: 0px">
  <title id="ks-t">One kernel applied at every position</title>
  <desc id="ks-d">A three by three kernel scans the first two rows of a six by six input. The corresponding output cell moves in step. Valid cross-correlation produces a four by four output, using nine shared weights and one bias.</desc>
  <text x="8" y="24" class="t-lab">6 × 6 input</text>
  <text x="300" y="24" class="t-lab">4 × 4 output</text>
  {Array.from({ length: N * N }, (_, i) => (
    <rect x={X0 + (i % N) * S} y={Y0 + Math.floor(i / N) * S} width={S - 3} height={S - 3} class="bx-soft" />
  ))}
  <g class="anim-scan" style="--dx: 28px; --dy: 28px; --dur: 8s">
    <rect x={X0 - 1} y={Y0 - 1} width={S * 3 - 1} height={S * 3 - 1} class="a2" opacity="0.14" />
    <rect x={X0 - 1} y={Y0 - 1} width={S * 3 - 1} height={S * 3 - 1} class="s2" stroke-width="2" />
  </g>
  <line x1="194" y1="136" x2="278" y2="136" class="wire" />
  <polygon points="277,131 286,136 277,141" class="head" />
  <text x="239" y="113" class="t-key" text-anchor="middle">same</text>
  <text x="239" y="128" class="t-key" text-anchor="middle">9 weights</text>
  {Array.from({ length: 16 }, (_, i) => (
    <rect x={300 + (i % 4) * S} y={82 + Math.floor(i / 4) * S} width={S - 3} height={S - 3} class="bx-soft" />
  ))}
  <g class="anim-scan" style="--dx: 28px; --dy: 28px; --dur: 8s">
    <rect x="299" y="81" width="27" height="27" class="s2" stroke-width="2" />
  </g>
  <text x="8" y="248" class="t-sm">10 parameters, including the shared bias.</text>
  <text x="8" y="269" class="t-sm">A dense 36 → 16 map needs 592, including biases.</text>
</svg>
