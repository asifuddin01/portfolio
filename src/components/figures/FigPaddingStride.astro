---
const cases = [
  { p: 0, s: 1, out: 5, label: 'No padding' },
  { p: 1, s: 1, out: 7, label: 'Keep the size' },
  { p: 1, s: 2, out: 4, label: 'Sample every second position' },
];
---
<svg class="fig" viewBox="0 0 440 350" role="img" aria-labelledby="ps-t ps-d" style="--fig-min: 0px">
  <title id="ps-t">Padding and stride change the output grid</title>
  <desc id="ps-d">For a seven by seven input, a three by three kernel and dilation one: padding zero and stride one give five by five outputs; padding one and stride one give seven by seven; padding one and stride two give four by four.</desc>
  <text x="8" y="23" class="t-lab">7 × 7 input · 3 × 3 kernel · dilation 1</text>
  {cases.map((item, row) => (
    <g transform={'translate(0,' + (42 + row * 96) + ')'}>
      <text x="8" y="13" class="t-key">{item.label}</text>
      <text x="8" y="35" class="t-sm">padding {item.p}, stride {item.s}</text>
      <text x="8" y="57" class="t-sm">{item.out} × {item.out} output</text>
      {Array.from({ length: item.out * item.out }, (_, i) => (
        <rect x={310 + (i % item.out) * 10} y={Math.floor(i / item.out) * 10} width="8" height="8" class="bx-fill" />
      ))}
    </g>
  ))}
  <text x="8" y="338" class="t-sm">Output per axis: floor((7 + 2p − 3) / s) + 1.</text>
</svg>
