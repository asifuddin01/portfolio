---
/**
 * Book I, Ch. IV, Prop. 2 — the same product, three multipliers. A gradient
 * carried back through many steps is a product of many factors, and a product
 * of many factors is almost never near one.
 */
const SERIES = [
  { r: 0.7, cls: 's1', lab: '0.7 — vanishes', col: 'var(--lesion-ves)' },
  { r: 1.0, cls: 's4', lab: '1.0 — steady',   col: 'var(--lesion-cws)' },
  { r: 1.3, cls: 's2', lab: '1.3 — explodes', col: 'var(--lesion-ma)' },
];
const N = 16;
const y = (v: number) => 210 - (84 * Math.log10(Math.max(v, 1e-6))) / 1.6;
---
<svg class="fig" viewBox="0 0 720 320" role="img" aria-labelledby="vg-t vg-d" preserveAspectRatio="xMidYMid meet" style="--fig-min: 620px">
  <title id="vg-t">A gradient carried back through many steps</title>
  <desc id="vg-d">
    Three curves on a logarithmic scale showing a repeated multiplication over
    sixteen steps. A factor below one falls away to nothing, a factor above one
    grows without bound, and only a factor of exactly one holds steady.
  </desc>

  <text x="0" y="22" class="t-lab">magnitude after k steps, log scale</text>

  <line x1="60" y1="266" x2="540" y2="266" class="axis" />
  <line x1="60" y1="266" x2="60" y2="52" class="axis" />
  <text x="540" y="288" class="t-sm" text-anchor="end">steps back</text>

  {SERIES.map((s) => {
    const pts = Array.from({ length: N }, (_, k) => {
      const v = Math.pow(s.r, k);
      return `${60 + k * 30},${Math.min(264, Math.max(56, y(v)))}`;
    }).join(' ');
    return <polyline points={pts} class={s.cls} stroke-width="1.6" />;
  })}

  {SERIES.map((s, i) => (
    <g>
      <line x1="576" y1={104 + i * 30} x2="606" y2={104 + i * 30} stroke={s.col} stroke-width="1.8" />
      <text x="614" y={108 + i * 30} class="t-sm">{s.lab}</text>
    </g>
  ))}

  <text x="0" y="312" class="t-sm">Not specific to recurrence: this is what happens to any long product of numbers that are not exactly one.</text>
</svg>
