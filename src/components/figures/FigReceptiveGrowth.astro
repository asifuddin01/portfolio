---
const rows = [
  { y: 66, lo: 3, hi: 3, label: 'layer 3', span: 'R = 7' },
  { y: 124, lo: 2, hi: 4, label: 'layer 2', span: 'R = 5' },
  { y: 182, lo: 1, hi: 5, label: 'layer 1', span: 'R = 3' },
  { y: 240, lo: 0, hi: 6, label: 'input', span: 'R = 1' },
];
const x = (i: number) => 105 + i * 36;
---
<svg class="fig" viewBox="0 0 440 323" role="img" aria-labelledby="rg-t rg-d" style="--fig-min: 0px">
  <title id="rg-t">Three width-three layers reach seven input positions</title>
  <desc id="rg-d">A single top unit depends on three units below, then five, then seven input positions. All three kernels have width three, stride one and dilation one. Each layer adds two to the receptive-field span.</desc>
  <text x="8" y="23" class="t-lab">Width 3 · stride 1 · dilation 1</text>
  {rows.slice(0, 3).map((row, r) =>
    Array.from({ length: row.hi - row.lo + 1 }, (_, n) => n + row.lo).map(i =>
      [-1, 0, 1].map(d => (
        <line x1={x(i)} y1={row.y + 6} x2={x(i + d)} y2={rows[r + 1].y - 6} class="wire-soft" />
      ))
    )
  )}
  {rows.map(row => (
    <g>
      <text x="8" y={row.y + 4} class="t-sm">{row.label}</text>
      {Array.from({ length: 7 }, (_, i) => (
        <circle cx={x(i)} cy={row.y} r="6" class={i >= row.lo && i <= row.hi ? 'bx-fill' : 'bx-soft'} opacity={i >= row.lo && i <= row.hi ? 1 : 0.25} />
      ))}
      <text x="370" y={row.y + 4} class="t-key">{row.span}</text>
    </g>
  ))}
  <text x="8" y="285" class="t-sm">R is the input span of one unit at that depth.</text>
  <text x="8" y="306" class="t-sm">Overlapping paths widen the span: 1 → 3 → 5 → 7.</text>
</svg>
