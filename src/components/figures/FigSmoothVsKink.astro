---
/** Book I, Ch. III, Prop. 4 — a kink and a curve, and what each does to the derivative. */
type Pt = [number, number];
const relu: Pt[] = [], gelu: Pt[] = [], drelu: Pt[] = [], dgelu: Pt[] = [];
/** Abramowitz–Stegun 7.1.26: enough accuracy to draw with, in eight lines. */
function erf(x: number): number {
  const s = x < 0 ? -1 : 1;
  x = Math.abs(x);
  const t = 1 / (1 + 0.3275911 * x);
  const y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
  return s * y;
}
const Phi = (z: number) => 0.5 * (1 + erf(z / Math.SQRT2));
for (let i = 0; i <= 100; i++) {
  const z = -3 + (6 * i) / 100;
  const X = 60 + (i / 100) * 260;
  relu.push([X, 150 - Math.max(0, z) * 34]);
  gelu.push([X, 150 - z * Phi(z) * 34]);
  drelu.push([400 + (i / 100) * 260, 150 - (z > 0 ? 1 : 0) * 60]);
  dgelu.push([400 + (i / 100) * 260, 150 - (Phi(z) + z * Math.exp(-z * z / 2) / Math.sqrt(2 * Math.PI)) * 60]);
}
const path = (p: Pt[]) =>
  p.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
---
<svg class="fig" viewBox="0 0 720 260" role="img" aria-labelledby="sk-t sk-d" preserveAspectRatio="xMidYMid meet" style="--fig-min: 620px">
  <title id="sk-t">ReLU has a kink where GELU has a curve, and the derivatives differ sharply there</title>
  <desc id="sk-d">
    On the left, ReLU and GELU plotted together: they agree away from the origin
    and differ in a narrow band around it, where GELU dips below zero. On the
    right, their derivatives: ReLU's jumps from zero to one with no value at the
    kink, while GELU's passes smoothly through one half and briefly goes
    negative.
  </desc>

  <text x="0" y="20" class="t-lab">the functions</text>
  <text x="400" y="20" class="t-lab">their derivatives</text>

  <line x1="60" y1="150" x2="326" y2="150" class="axis" />
  <line x1="190" y1="40" x2="190" y2="182" class="axis" />
  <path d={path(relu)} class="wire-soft" fill="none" />
  <path d={path(gelu)} class="wire" fill="none" />
  <text x="300" y="60" class="t-key">ReLU</text>
  <text x="300" y="80" class="t-key">GELU</text>
  <circle cx="190" cy="150" r="4" class="bx" />
  <text x="150" y="176" class="t-xs">kink</text>

  <line x1="400" y1="150" x2="666" y2="150" class="axis" />
  <line x1="530" y1="40" x2="530" y2="182" class="axis" />
  <path d={path(drelu)} class="wire-soft" fill="none" />
  <path d={path(dgelu)} class="wire" fill="none" />
  <line x1="400" y1="120" x2="666" y2="120" class="dash" />
  <text x="672" y="124" class="t-xs">½</text>
  <circle cx="530" cy="120" r="4" class="bx-fill" />
  <text x="536" y="112" class="t-key">GELU′(0) = ½</text>
  <text x="404" y="176" class="t-key" style="fill: var(--oxblood-text)">ReLU′(0) undefined</text>
  <text x="404" y="196" class="t-xs">GELU′ dips to −0.13 near z = −√2</text>

  <text x="0" y="252" class="t-xs">the whole difference lives in a band around the origin — which is where gradients are decided</text>
</svg>
