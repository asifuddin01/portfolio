---
/** I.9.P03: actual dependency paths to one output in a centred convolution. */
const N = 15;
const X0 = 105, DX = 29, CENTRE = 7;
const LAYERS = [
  { y: 226, span: 0, active: Array.from({ length: N }, (_, i) => i), lab: 'input', dil: '' },
  { y: 170, span: 1, active: [1, 3, 5, 7, 9, 11, 13], lab: 'layer 1', dil: 'dil 1 · span 3' },
  { y: 114, span: 2, active: [3, 7, 11], lab: 'layer 2', dil: 'dil 2 · span 7' },
  { y: 58, span: 4, active: [CENTRE], lab: 'layer 3', dil: 'dil 4 · span 15' },
];
const cx = (i: number) => X0 + i * DX;
---
<svg class="fig" viewBox="0 0 720 300" role="img" aria-labelledby="dl-t dl-d" preserveAspectRatio="xMidYMid meet" style="--fig-min: 620px">
  <title id="dl-t">Fifteen input positions reach one dilated-convolution output</title>
  <desc id="dl-d">
    A centred width-three convolution uses dilations one, two and four.
    Tracing the selected top output backward gives three positions in layer
    two, seven in layer one, and all fifteen input positions. Dim nodes are
    not on a path to that output. A causal version shifts the window left.
  </desc>
  {LAYERS.map((L, li) => (
    <g>
      {li > 0 && L.active.flatMap((i) => [-1, 0, 1].map((k) => (
        <line x1={cx(i)} y1={L.y + 5} x2={cx(i + k * L.span)} y2={LAYERS[li - 1].y - 5} class="wire-soft" />
      )))}
      <text x="0" y={L.y + 4} class="t-sm">{L.lab}</text>
      {Array.from({ length: N }, (_, i) => (
        <circle cx={cx(i)} cy={L.y} r="4" class={L.active.includes(i) ? 'a1' : 'a4'} opacity={L.active.includes(i) ? 1 : 0.2} />
      ))}
      {L.dil && <text x="535" y={L.y + 4} class="t-key">{L.dil}</text>}
    </g>
  ))}
  <text x="0" y="267" class="t-sm">Trace the selected output downward: each layer reads three positions below.</text>
  <text x="0" y="289" class="t-sm">Centred windows shown. A causal window reads only the present and past.</text>
</svg>
