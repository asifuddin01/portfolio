---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { toRoman } from '../../consts';

interface Props {
  entry: CollectionEntry<'art'>;
  /** Tabula numeral. Defaults to the entry's own order. */
  n?: number;
  /** Real rendered width of the slot, so the srcset picks a sane candidate. */
  sizes?: string;
  depth?: number;
  eager?: boolean;
  /** Link the caption through to the full note. */
  linked?: boolean;
}
const {
  entry,
  n,
  sizes = '(max-width: 700px) 92vw, 30rem',
  depth = 0.16,
  eager = false,
  linked = true,
} = Astro.props;

const d = entry.data;
const numeral = toRoman(n ?? d.order);
const attribution = [d.artist, d.date].filter(Boolean).join(', ');
const alt = d.alt ?? `${d.title}${d.artist ? `, ${d.artist}` : ''}`;
---
<figure class:list={['art', `art--${d.treatment}`]}>
  <div class="art-frame plate-art" data-parallax={depth}>
    <Image
      src={d.image}
      alt={alt}
      widths={[340, 480, 680, 900]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      quality={70}
    />
  </div>
  <figcaption class="art-cap">
    <span class="art-n">Tabula {numeral}</span>
    {linked ? (
      <a class="art-title art-link" href={`/tabulae/${entry.id}`}>{d.title}</a>
    ) : (
      <span class="art-title">{d.title}</span>
    )}
    <span class="art-attr">{attribution}</span>
    {d.gloss && <span class="art-gloss">{d.gloss}</span>}
    {d.source ? (
      <a class="art-src" href={d.source} rel="noopener">{d.credit}</a>
    ) : (
      <span class="art-src">{d.credit}</span>
    )}
  </figcaption>
</figure>

<style>
  .art { margin: 0; display: grid; gap: 0.9rem; }
  .art-frame {
    border: var(--rule) solid color-mix(in srgb, var(--brass) 60%, transparent);
    padding: clamp(0.75rem, 2vw, 1.4rem);
    background: var(--paper-raised);
    overflow: hidden;
  }
  .art-frame :global(img) { width: 100%; height: auto; display: block; }

  .art-cap {
    display: grid;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.65;
    max-width: 42ch;
  }
  .art-n { color: var(--brass-text); letter-spacing: 0.16em; text-transform: uppercase; }
  .art-title { color: var(--ink); font-style: italic; }
  .art-link:hover { color: var(--fundus); }
  .art-attr { color: var(--ink-soft); }
  .art-gloss {
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: var(--t-base);
    font-style: italic;
    line-height: 1.5;
    margin-top: 0.35rem;
    max-width: 34ch;
  }
  .art-src { color: var(--brass-text); justify-self: start; margin-top: 0.3rem; }
  a.art-src:hover { color: var(--fundus); }
</style>
