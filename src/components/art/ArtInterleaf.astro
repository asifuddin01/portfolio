---
import ArtPlate from './ArtPlate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'art'>; depth?: number }
const { entry, depth = 0.18 } = Astro.props;
---
<aside class:list={['il', `il--${entry.data.side}`]} aria-label="Interleaved plate">
  <div class="il-plate">
    <ArtPlate entry={entry} depth={depth} />
  </div>
</aside>

<style>
  .il { margin-block: var(--chapter-gap); display: flex; }
  .il--right { justify-content: flex-end; }
  .il--left { justify-content: flex-start; }
  .il-plate { width: min(30rem, 100%); }
  @media (max-width: 700px) {
    .il { justify-content: center; }
    .il-plate { width: 100%; }
  }
</style>
