---
import FigureMotionToggle from '../ornament/FigureMotionToggle.astro';
---

<figure
  class="bh"
  data-black-hole
  data-motion-figure
  data-reveal
>
  <div
    class="bh-stage"
    role="img"
    aria-label="A luminous accretion disc bends around the dark event horizon of a rotating black hole."
  >
    <div class="bh-fallback" aria-hidden="true">
      <span class="bh-fallback-ring"></span>
    </div>
    <canvas class="bh-canvas" data-black-hole-canvas aria-hidden="true"></canvas>
  </div>

  <div class="bh-meta">
    <figcaption id="bh-caption">
      <span class="bh-caption-title">The unseen centre</span>
      <span class="bh-caption-copy">A presence known by what it bends.</span>
    </figcaption>
    <FigureMotionToggle figure="black hole" />
  </div>
</figure>

<script>
  import '../../scripts/black-hole';
</script>

<style>
  .bh {
    width: 100%;
    min-width: 0;
    margin: 0;
    isolation: isolate;
  }

  .bh-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background:
      radial-gradient(circle at 52% 50%, color-mix(in srgb, var(--verdigris) 10%, transparent), transparent 54%),
      radial-gradient(ellipse 90% 86% at 50% 50%, color-mix(in srgb, var(--ink) 10%, transparent), transparent 76%);
  }

  .bh-canvas,
  .bh-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bh-canvas {
    display: block;
    opacity: 0;
  }

  .bh[data-renderer='webgl'] .bh-canvas { opacity: 1; }
  .bh[data-renderer='webgl'] .bh-fallback { opacity: 0; }

  .bh-fallback {
    display: grid;
    place-items: center;
    opacity: 1;
  }

  .bh-fallback::before {
    content: '';
    position: absolute;
    width: 108%;
    aspect-ratio: 3.15 / 1;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at center, transparent 0 18%, color-mix(in srgb, var(--paper) 92%, var(--brass)) 25%, color-mix(in srgb, var(--fundus) 74%, transparent) 32%, transparent 61%),
      repeating-radial-gradient(
        ellipse at center,
        transparent 0 4.5%,
        color-mix(in srgb, var(--fundus) 48%, transparent) 5% 5.8%,
        transparent 6.2% 8.4%
      );
    box-shadow:
      0 0 2.8rem color-mix(in srgb, var(--brass) 48%, transparent),
      0 0 7rem color-mix(in srgb, var(--fundus) 30%, transparent);
    transform: rotate(-7deg) scale(1.02);
    transform-origin: 50% 50%;
  }

  .bh-fallback::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: 48%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: clamp(0.42rem, 1.6vw, 0.85rem) solid color-mix(in srgb, var(--paper) 78%, var(--brass));
    border-bottom-color: color-mix(in srgb, var(--fundus) 68%, transparent);
    box-shadow:
      inset 0 0 1.4rem color-mix(in srgb, var(--brass) 66%, transparent),
      0 -0.7rem 2.7rem color-mix(in srgb, var(--paper) 38%, transparent),
      0 0 5rem color-mix(in srgb, var(--fundus) 52%, transparent);
    transform: translateY(-8%);
  }

  .bh-fallback-ring {
    z-index: 2;
    position: relative;
    display: block;
    width: 39%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 94%, #000);
    border: 1px solid color-mix(in srgb, var(--paper) 74%, var(--brass));
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--fundus) 52%, transparent),
      0 0 1.9rem color-mix(in srgb, var(--brass) 82%, transparent),
      0 0 5.6rem color-mix(in srgb, var(--fundus) 35%, transparent);
  }

  .bh-fallback-ring::after {
    content: '';
    position: absolute;
    z-index: 3;
    width: 270%;
    height: 22%;
    left: 50%;
    top: 64%;
    border-radius: 50%;
    background: linear-gradient(90deg, transparent 3%, color-mix(in srgb, var(--fundus) 74%, transparent) 27%, color-mix(in srgb, var(--paper) 96%, var(--brass)) 58%, color-mix(in srgb, var(--fundus) 84%, transparent) 77%, transparent 98%);
    box-shadow: 0 0 1.4rem color-mix(in srgb, var(--brass) 82%, transparent);
    transform: translate(-50%, -50%) rotate(-7deg);
    transform-origin: 50% 50%;
  }

  .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::before {
    animation: bh-disc-turn 15s linear infinite;
  }
  .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::after {
    animation: bh-crown-breathe 4.8s ease-in-out infinite alternate;
  }
  .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback-ring::after {
    animation: bh-sweep-flow 5.6s ease-in-out infinite alternate;
  }

  .bh-meta {
    min-height: 3.7rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 7% 0;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 32%, transparent);
  }

  .bh-meta figcaption { min-width: 0; }
  .bh-caption-title,
  .bh-caption-copy { display: block; }
  .bh-caption-title {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .bh-caption-copy {
    margin-top: 0.16rem;
    font-size: var(--t-sm);
    line-height: 1.45;
    font-style: italic;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .bh {
      width: min(100%, 38rem);
      margin-inline: auto;
    }
    .bh-stage { aspect-ratio: 4 / 5; }
  }

  @media (max-width: 30rem) {
    .bh-stage { width: calc(100% + 1.5rem); margin-left: -0.75rem; }
    .bh-meta { padding-inline: 0; }
    .bh-caption-copy { max-width: 16rem; }
  }

  @keyframes bh-disc-turn {
    to { transform: rotate(353deg) scale(1.04); }
  }

  @keyframes bh-crown-breathe {
    to { transform: translateY(-8%) scale(1.045); opacity: 0.84; }
  }

  @keyframes bh-sweep-flow {
    to { transform: translate(-49%, -48%) rotate(-5deg) scaleX(1.035); opacity: 0.82; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::before {
      animation: bh-disc-turn 15s linear infinite !important;
    }
    .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::after {
      animation: bh-crown-breathe 4.8s ease-in-out infinite alternate !important;
    }
    .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback-ring::after {
      animation: bh-sweep-flow 5.6s ease-in-out infinite alternate !important;
    }
  }
</style>
