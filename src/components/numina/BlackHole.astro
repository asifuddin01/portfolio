---
import FigureMotionToggle from '../ornament/FigureMotionToggle.astro';
---

<figure
  class="bh"
  data-black-hole
  data-motion-figure
  data-reveal
>
  <div
    class="bh-stage"
    role="img"
    aria-label="A luminous accretion disc bends around the dark event horizon of a rotating black hole."
  >
    <div class="bh-fallback" aria-hidden="true">
      <span class="bh-fallback-ring"></span>
    </div>
    <canvas class="bh-canvas" data-black-hole-canvas aria-hidden="true"></canvas>
  </div>

  <div class="bh-meta">
    <figcaption id="bh-caption">
      <span class="bh-caption-title">The unseen centre</span>
      <span class="bh-caption-copy">A presence known by what it bends.</span>
    </figcaption>
    <FigureMotionToggle figure="black hole" />
  </div>
</figure>

<script>
  import '../../scripts/black-hole';
</script>

<style>
  .bh {
    width: 100%;
    min-width: 0;
    margin: 0;
    isolation: isolate;
  }

  .bh-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background: transparent;
  }

  .bh-canvas,
  .bh-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bh-canvas {
    display: block;
    opacity: 0;
  }

  .bh[data-renderer='webgl'] .bh-canvas { opacity: 1; }
  .bh[data-renderer='webgl'] .bh-fallback { opacity: 0; }

  .bh-fallback {
    display: grid;
    place-items: center;
    opacity: 1;
    background:
      radial-gradient(circle at 50% 22%, color-mix(in srgb, var(--paper) 44%, transparent) 0 0.08rem, transparent 0.11rem),
      radial-gradient(circle at 48% 80%, color-mix(in srgb, var(--brass) 58%, transparent) 0 0.09rem, transparent 0.13rem),
      radial-gradient(ellipse 12% 72% at 50% 56%, color-mix(in srgb, var(--verdigris) 8%, transparent), transparent 72%);
  }

  .bh-fallback::before {
    content: '';
    position: absolute;
    width: 82%;
    aspect-ratio: 4.1 / 1;
    border-radius: 50%;
    background:
      repeating-radial-gradient(
        ellipse at center,
        transparent 0 7%,
        color-mix(in srgb, var(--brass) 52%, transparent) 7.4% 8%,
        transparent 8.5% 12%
      );
    box-shadow:
      0 0 1.3rem color-mix(in srgb, var(--brass) 22%, transparent),
      0 0 3.4rem color-mix(in srgb, var(--verdigris) 10%, transparent);
    transform: translateY(7%) rotate(7deg);
    transform-origin: 50% 50%;
  }

  .bh-fallback::after {
    content: '';
    position: absolute;
    width: 16%;
    height: 68%;
    left: 42%;
    top: 24%;
    background:
      radial-gradient(circle at 48% 8%, color-mix(in srgb, var(--paper) 54%, transparent) 0 0.08rem, transparent 0.12rem),
      radial-gradient(circle at 58% 38%, color-mix(in srgb, var(--brass) 62%, transparent) 0 0.09rem, transparent 0.14rem),
      radial-gradient(circle at 43% 72%, color-mix(in srgb, var(--paper) 40%, transparent) 0 0.07rem, transparent 0.11rem),
      radial-gradient(circle at 54% 92%, color-mix(in srgb, var(--fundus) 70%, transparent) 0 0.1rem, transparent 0.15rem);
    opacity: 0.72;
  }

  .bh-fallback-ring {
    z-index: 2;
    position: relative;
    display: block;
    width: 29%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 94%, #000);
    border: 1px solid color-mix(in srgb, var(--paper) 70%, var(--brass));
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--fundus) 30%, transparent),
      0 0 1.2rem color-mix(in srgb, var(--brass) 48%, transparent),
      0 0 3.2rem color-mix(in srgb, var(--fundus) 18%, transparent);
    transform: translateY(7%);
  }

  .bh-fallback-ring::before,
  .bh-fallback-ring::after {
    content: '';
    position: absolute;
    z-index: 3;
    left: 50%;
    border-radius: 50%;
    transform-origin: 50% 50%;
  }

  .bh-fallback-ring::before {
    width: 126%;
    height: 126%;
    top: 50%;
    border-top: 1px solid color-mix(in srgb, var(--paper) 74%, var(--brass));
    border-left: 1px solid color-mix(in srgb, var(--brass) 32%, transparent);
    transform: translate(-50%, -50%) rotate(7deg);
  }

  .bh-fallback-ring::after {
    width: 286%;
    height: 6%;
    top: 64%;
    background: linear-gradient(90deg, transparent 2%, color-mix(in srgb, var(--fundus) 48%, transparent) 29%, color-mix(in srgb, var(--paper) 88%, var(--brass)) 62%, color-mix(in srgb, var(--fundus) 55%, transparent) 78%, transparent 98%);
    box-shadow: 0 0 0.65rem color-mix(in srgb, var(--brass) 44%, transparent);
    transform: translate(-50%, -50%) rotate(7deg);
  }

  .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::before {
    animation: bh-disc-turn 18s linear infinite;
  }
  .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::after {
    animation: bh-plume-drift 6.8s ease-in-out infinite alternate;
  }
  .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback-ring::after {
    animation: bh-sweep-flow 7s ease-in-out infinite alternate;
  }

  .bh-meta {
    min-height: 3.7rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0 0;
  }

  .bh-meta figcaption { min-width: 0; }
  .bh-caption-title,
  .bh-caption-copy { display: block; }
  .bh-caption-title {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .bh-caption-copy {
    margin-top: 0.16rem;
    font-size: var(--t-sm);
    line-height: 1.45;
    font-style: italic;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .bh {
      width: min(100%, 38rem);
      margin-inline: auto;
    }
    .bh-stage { aspect-ratio: 4 / 5; }
  }

  @media (max-width: 30rem) {
    .bh-stage { width: calc(100% + 1.5rem); margin-left: -0.75rem; }
    .bh-meta { padding-inline: 0; }
    .bh-caption-copy { max-width: 16rem; }
  }

  @keyframes bh-disc-turn {
    to { transform: translateY(7%) rotate(367deg); }
  }

  @keyframes bh-plume-drift {
    to { transform: translateY(2%); opacity: 0.42; }
  }

  @keyframes bh-sweep-flow {
    to { transform: translate(-49%, -48%) rotate(9deg) scaleX(1.025); opacity: 0.76; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::before {
      animation: bh-disc-turn 18s linear infinite !important;
    }
    .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback::after {
      animation: bh-plume-drift 6.8s ease-in-out infinite alternate !important;
    }
    .bh[data-motion='running']:not([data-motion-visible='false']) .bh-fallback-ring::after {
      animation: bh-sweep-flow 7s ease-in-out infinite alternate !important;
    }
  }
</style>
