---
import { ClientRouter } from 'astro:transitions';

import '@fontsource-variable/bodoni-moda/wght.css';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import '../styles/global.css';
import '../styles/motion.css';
import '../styles/figures.css';
import '../styles/elementa.css';

import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Colophon from '../components/layout/Colophon.astro';
import GrainOverlay from '../components/layout/GrainOverlay.astro';
import InkWash from '../components/layout/InkWash.astro';
import CursorLens from '../components/layout/CursorLens.astro';
import FolioNumber from '../components/ornament/FolioNumber.astro';
import { sectionFor } from '../lib/section';
import { AUTHOR } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Bottom-outer-corner folio mark. Roman on the scroll, Arabic on chapters. */
  folio?: string | number;
  image?: string;
  type?: 'website' | 'article';
  /** Keeps a page out of search results. For routes behind Cloudflare Access,
      which crawlers cannot reach anyway but should not be advertised. */
  noindex?: boolean;
}

const { title, description, folio, image, type, noindex } = Astro.props;

/**
 * What the search index files this page under. Derived from the path, so a new
 * route is filed correctly without anyone remembering to say where it belongs.
 */
const section = sectionFor(Astro.url.pathname);

/**
 * The title a search result is listed under.
 *
 * Every page's `<title>` carries the author's name, which is right in a
 * browser tab and wrong in a list of twenty results that would then all end
 * the same way. The frontispiece is the one page whose name *is* the author's,
 * so it keeps whatever is left rather than being stripped to nothing.
 */
const listedTitle =
  title
    /* The name is escaped before it becomes a pattern: it contains a full
       stop, which as a regex would match any character. */
    .replace(
      new RegExp(`\\s*[—–-]\\s*${AUTHOR.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}\\s*$`),
      '',
    )
    /* And a trailing section name, when the card and the search result are
       already labelled with it: "Mixture of experts — Marginalia" filed under
       MARGINALIA says it twice, and the space is better spent on the title. */
    .replace(new RegExp(`\\s*[—–-]\\s*${section.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}\\s*$`, 'i'), '')
    .trim() || title;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} noindex={noindex} />
    <ClientRouter />
    <!-- No-flash theme + the `js` gate. Both must land before first paint:
         without `js`, motion.css leaves every element visible, so a broken
         or disabled script can never blank the page. -->
    <script is:inline>
      (function () {
        function apply() {
          var root = document.documentElement;
          root.classList.add('js');
          try {
            var stored = localStorage.getItem('codex-theme');
            if (stored === 'nocturne' || stored === 'vellum') {
              root.dataset.theme = stored;
            } else {
              root.dataset.theme =
                window.matchMedia('(prefers-color-scheme: dark)').matches ? 'nocturne' : 'vellum';
            }
          } catch (e) {
            root.dataset.theme = 'vellum';
          }
        }

        apply();

        // On a soft navigation the router copies the <html> attributes from
        // the incoming document, which is server-rendered and carries neither
        // the theme nor the `js` class. Without this the page reverted to
        // vellum on every click, and the reveal animations stopped firing.
        // after-swap runs before the new page paints, so nothing flashes.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <InkWash />
    <GrainOverlay />
    <CursorLens />

    <Header />

    {/* `data-pagefind-body` is what the index reads: the page's own content,
        without the nav and the colophon that repeat on all four hundred pages
        and would otherwise match every query. It also decides what is indexed
        at all — a document without it is skipped — which is how /admin stays
        out of the results without a rule naming it. */}
    <main id="main" class="page" data-pagefind-body>
      {/* Metadata for a result: the title it is listed under, and the part of
          the book it belongs to, which is also the filter. Empty elements,
          because the `key:value` form takes the value from the attribute — a
          visible label here would be a label on every page of the site. */}
      <span hidden data-pagefind-meta={`title:${listedTitle}`}></span>
      <span hidden data-pagefind-meta={`section:${section}`}></span>
      <span hidden data-pagefind-filter={`section:${section}`}></span>
      <slot />
      {folio !== undefined && <FolioNumber value={folio} />}
    </main>

    <Colophon />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .page { position: relative; padding-bottom: 3rem; }
</style>
