---
/**
 * One project's own page: what it is in a line, why it is worth reading in a
 * few, the demo where there is one, and then the account in short sections.
 * The account is the entry's MDX body, written and edited in /admin; an entry
 * without one falls back to its summary so a new project is never a blank page.
 */
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import Fact from '../../components/projects/Fact.astro';
import { getProjects, projectBrief, projectTeaser, projectVideo } from '../../lib/collections';
import { fillFacts } from '../../lib/facts.mjs';
import { AUTHOR } from '../../consts';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, n: i + 1, total: all.length, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
  n: number;
  total: number;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { entry, n, total, prev, next } = Astro.props;
const d = entry.data;
const { name, line } = projectBrief(entry);
const teaser = projectTeaser(entry);
const video = projectVideo(entry);
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const pad = (x: number) => String(x).padStart(2, '0');
---
<BaseLayout title={`${name} — ${AUTHOR}`} description={teaser} folio="P" type="article">
  <article class="codex pj">
    <header class="pj-head">
      <p class="pj-kicker" data-reveal>
        <a href="/projects">Projects</a><span aria-hidden="true"> · </span>{pad(n)} of {pad(total)}
      </p>
      <h1 class="pj-h1" data-press>{name}</h1>
      <p class="pj-line" data-reveal>{line}</p>
      <p class="pj-teaser" data-reveal>{teaser}</p>
      {((d.link && !video) || d.repo || video) && (
        <p class="pj-go" data-reveal>
          {d.link && !video && (
            <a class="pj-btn" href={d.link}>{d.linkLabel ?? 'Open'}<span aria-hidden="true"> →</span></a>
          )}
          {video && <a class="pj-btn" href="#demo">Watch the demo<span aria-hidden="true"> ↓</span></a>}
          {d.repo && <a class="pj-src" href={d.repo} rel="noopener">Source code</a>}
        </p>
      )}
    </header>

    {video && (
      <figure class="pj-demo" id="demo" data-reveal>
        <video controls playsinline preload="metadata" src={video}>
          <a href={video}>Download the demo video</a>
        </video>
        <figcaption>The demo, as recorded. It plays here; nothing is loaded until you press play.</figcaption>
      </figure>
    )}

    <div class="prose pj-body">
      {hasBody ? <Content components={{ Fact }} /> : <p>{fillFacts(d.summary)}</p>}
    </div>

    <LesionRule />

    <nav class="pj-nav" aria-label="Other projects">
      {prev ? (
        <a class="pj-nav-a" href={`/projects/${prev.id}`}>
          <span class="pj-nav-k">← Previous</span>
          <span class="pj-nav-t">{projectBrief(prev).name}</span>
        </a>
      ) : <span />}
      <a class="pj-nav-all" href="/projects">All projects</a>
      {next ? (
        <a class="pj-nav-a pj-nav-next" href={`/projects/${next.id}`}>
          <span class="pj-nav-k">Next →</span>
          <span class="pj-nav-t">{projectBrief(next).name}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .pj { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .pj-head { max-width: var(--measure); margin-bottom: 2.4rem; }
  .pj-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 1rem;
  }
  .pj-kicker a { color: inherit; border-bottom: 1px solid color-mix(in srgb, var(--brass) 55%, transparent); }
  .pj-h1 { font-size: var(--t-2xl); line-height: 1.05; margin-bottom: 0.8rem; }
  .pj-line {
    font-style: italic;
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 1.4rem;
  }
  .pj-teaser {
    font-size: var(--body-size);
    line-height: var(--body-leading);
    padding-left: 1.1rem;
    border-left: 2px solid var(--brass);
    margin-bottom: 1.6rem;
  }
  .pj-go { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; }
  .pj-btn {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 0.5rem 0.95rem;
    border: var(--rule) solid color-mix(in srgb, var(--brass) 60%, transparent);
    background: var(--paper-raised);
  }
  .pj-btn:hover, .pj-btn:focus-visible {
    background: color-mix(in srgb, var(--brass) 12%, var(--paper-raised));
    border-color: var(--brass);
  }
  .pj-src {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
  }
  .pj-src:hover { color: var(--fundus); border-bottom-color: var(--fundus); }

  .pj-demo { max-width: 52rem; margin: 0 0 2.8rem; scroll-margin-top: 5rem; }
  .pj-demo video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-raised);
    border: var(--rule) solid color-mix(in srgb, var(--brass) 60%, transparent);
  }
  .pj-demo figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }

  /* Short sections read better with a little more air than the textbook. */
  .pj-body :global(h2) { margin-top: 2.2em; }
  .pj-body :global(h2:first-child) { margin-top: 0; }
  .pj-body :global(table) { margin-block: 1.4em; }
  .pj-body { margin-bottom: 3rem; }

  .pj-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 1rem;
    margin: 2rem 0 3rem;
  }
  .pj-nav-a { display: grid; gap: 0.25rem; color: var(--ink); }
  .pj-nav-next { text-align: right; }
  .pj-nav-k, .pj-nav-all {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .pj-nav-t { font-family: var(--font-display); font-size: var(--t-md); line-height: 1.25; }
  .pj-nav-a:hover .pj-nav-t { color: var(--fundus); }
  @media (max-width: 640px) {
    .pj-h1 { font-size: var(--t-xl); }
    .pj-nav { grid-template-columns: 1fr 1fr; }
    .pj-nav-all { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }
</style>
