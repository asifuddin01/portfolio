---
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import ArtInterleaf from '../components/art/ArtInterleaf.astro';
import { getTabulae } from '../lib/collections';

import Frontispiece from '../components/home/Frontispiece.astro';
import Prologue from '../components/home/Prologue.astro';
import Axioms from '../components/home/Axioms.astro';
import Instrumentarium from '../components/home/Instrumentarium.astro';
import Compendium from '../components/home/Compendium.astro';
import InstrumentaPropria from '../components/home/InstrumentaPropria.astro';
import ElementaSection from '../components/home/ElementaSection.astro';
import MarginaliaSection from '../components/home/MarginaliaSection.astro';
import Chronicle from '../components/home/Chronicle.astro';
import Appendix from '../components/home/Appendix.astro';
import Correspondence from '../components/home/Correspondence.astro';

import { AUTHOR, ROLE, toRoman } from '../consts';

/* Each plate declares which chapter it follows, so its position on the page
   is an editorial choice made in /admin rather than an array index here.
   Numerals stay tied to the gallery sequence wherever a plate appears. */
const tabulae = await getTabulae();
const numeral = new Map(tabulae.map((t, i) => [t.id, i + 1]));
const at = (slot: string) =>
  tabulae.find((t) => t.data.onHome && t.data.placement === slot);
---
<BaseLayout
  title={`${AUTHOR} — Deep learning researcher`}
  description={ROLE}
  folio={toRoman(1)}
>
  <Frontispiece />

  <div class="codex">
    <LesionRule />
    <Prologue />
    {at('prologue') && <ArtInterleaf entry={at('prologue')!} n={numeral.get(at('prologue')!.id)} />}

    <LesionRule />
    <Axioms />
    {at('axioms') && <ArtInterleaf entry={at('axioms')!} n={numeral.get(at('axioms')!.id)} />}

    <LesionRule />
    <Instrumentarium />
    {at('instrumentarium') && <ArtInterleaf entry={at('instrumentarium')!} n={numeral.get(at('instrumentarium')!.id)} />}

    <LesionRule />
    <Compendium />
    {at('compendium') && <ArtInterleaf entry={at('compendium')!} n={numeral.get(at('compendium')!.id)} />}

    <LesionRule />
    <InstrumentaPropria />
    {at('instrumenta') && <ArtInterleaf entry={at('instrumenta')!} n={numeral.get(at('instrumenta')!.id)} />}

    <LesionRule />
    <ElementaSection />
    {at('elementa') && <ArtInterleaf entry={at('elementa')!} n={numeral.get(at('elementa')!.id)} />}

    <LesionRule />
    <MarginaliaSection />
    {at('marginalia') && <ArtInterleaf entry={at('marginalia')!} n={numeral.get(at('marginalia')!.id)} />}

    <LesionRule />
    <Chronicle />
    {at('chronicle') && <ArtInterleaf entry={at('chronicle')!} n={numeral.get(at('chronicle')!.id)} />}

    <LesionRule />
    <Appendix />
    {at('appendix') && <ArtInterleaf entry={at('appendix')!} n={numeral.get(at('appendix')!.id)} />}

    <LesionRule />
    <Correspondence />
    {at('correspondence') && <ArtInterleaf entry={at('correspondence')!} n={numeral.get(at('correspondence')!.id)} />}
  </div>
</BaseLayout>
