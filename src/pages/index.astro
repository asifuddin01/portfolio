---
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import ArtInterleaf from '../components/art/ArtInterleaf.astro';

import Frontispiece from '../components/home/Frontispiece.astro';
import Prologue from '../components/home/Prologue.astro';
import Axioms from '../components/home/Axioms.astro';
import Instrumentarium from '../components/home/Instrumentarium.astro';
import Compendium from '../components/home/Compendium.astro';
import InstrumentaPropria from '../components/home/InstrumentaPropria.astro';
import ElementaSection from '../components/home/ElementaSection.astro';
import MarginaliaSection from '../components/home/MarginaliaSection.astro';
import Chronicle from '../components/home/Chronicle.astro';
import Appendix from '../components/home/Appendix.astro';
import Correspondence from '../components/home/Correspondence.astro';

import { AUTHOR, ROLE, toRoman } from '../consts';
---
<BaseLayout
  title={`${AUTHOR} — Deep learning researcher`}
  description={ROLE}
  folio={toRoman(1)}
>
  <Frontispiece />

  <div class="codex">
    <LesionRule />
    <Prologue />
    <ArtInterleaf
      slug="saint-jerome"
      n={2}
      side="right"
      gloss="The scholar's room, drawn as a machine for concentration."
    />

    <LesionRule />
    <Axioms />
    <ArtInterleaf
      slug="knight-death"
      n={3}
      side="left"
      gloss="Proceeding anyway, which is most of method."
    />

    <LesionRule />
    <Instrumentarium />
    <ArtInterleaf
      slug="anatomy"
      n={4}
      side="right"
      gloss="The body, sectioned and numbered — the ancestor of every figure here."
    />

    <LesionRule />
    <Compendium />
    <ArtInterleaf
      slug="carceri"
      n={5}
      side="left"
      gloss="Architecture as an argument that never terminates."
    />

    <LesionRule />
    <InstrumentaPropria />

    <LesionRule />
    <ElementaSection />
    <ArtInterleaf
      slug="meditation"
      n={6}
      side="right"
      gloss="A different tradition, arriving at stillness by a different road."
    />

    <LesionRule />
    <MarginaliaSection />
    <ArtInterleaf
      slug="bust"
      n={7}
      side="left"
      gloss="A face kept for two thousand years because of what was said behind it."
    />

    <LesionRule />
    <Chronicle />
    <ArtInterleaf
      slug="scholar"
      n={8}
      side="right"
      gloss="Light arriving in a room where someone is working."
    />

    <LesionRule />
    <Appendix />

    <LesionRule />
    <Correspondence />
    <ArtInterleaf
      slug="sleep-reason"
      n={9}
      side="left"
      gloss="What reason leaves behind when it stops."
    />
  </div>
</BaseLayout>
