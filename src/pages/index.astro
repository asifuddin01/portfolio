---
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import ArtInterleaf from '../components/art/ArtInterleaf.astro';
import { getTabulae } from '../lib/collections';

import Frontispiece from '../components/home/Frontispiece.astro';
import Prologue from '../components/home/Prologue.astro';
import Axioms from '../components/home/Axioms.astro';
import Instrumentarium from '../components/home/Instrumentarium.astro';
import Compendium from '../components/home/Compendium.astro';
import InstrumentaPropria from '../components/home/InstrumentaPropria.astro';
import ElementaSection from '../components/home/ElementaSection.astro';
import MarginaliaSection from '../components/home/MarginaliaSection.astro';
import Chronicle from '../components/home/Chronicle.astro';
import Appendix from '../components/home/Appendix.astro';
import Correspondence from '../components/home/Correspondence.astro';

import { AUTHOR, ROLE, toRoman } from '../consts';

/* Tabula 1 sits on the frontispiece; the rest interleave the chapters in
   order, so re-ordering them in /admin re-orders the page. */
const [, ...interleaves] = (await getTabulae()).filter((t) => t.data.onHome);
const plate = (i: number) => interleaves[i];
---
<BaseLayout
  title={`${AUTHOR} — Deep learning researcher`}
  description={ROLE}
  folio={toRoman(1)}
>
  <Frontispiece />

  <div class="codex">
    <LesionRule />
    <Prologue />
    {plate(0) && <ArtInterleaf entry={plate(0)!} />}

    <LesionRule />
    <Axioms />
    {plate(1) && <ArtInterleaf entry={plate(1)!} />}

    <LesionRule />
    <Instrumentarium />
    {plate(2) && <ArtInterleaf entry={plate(2)!} />}

    <LesionRule />
    <Compendium />
    {plate(3) && <ArtInterleaf entry={plate(3)!} />}

    <LesionRule />
    <InstrumentaPropria />

    <LesionRule />
    <ElementaSection />
    {plate(4) && <ArtInterleaf entry={plate(4)!} />}

    <LesionRule />
    <MarginaliaSection />
    {plate(5) && <ArtInterleaf entry={plate(5)!} />}

    <LesionRule />
    <Chronicle />
    {plate(6) && <ArtInterleaf entry={plate(6)!} />}

    <LesionRule />
    <Appendix />

    <LesionRule />
    <Correspondence />
    {plate(7) && <ArtInterleaf entry={plate(7)!} />}
  </div>
</BaseLayout>
