---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../../consts';

/**
 * Officina AI — write a Python, C or Java program, trace it, and step
 * through what it actually did.
 *
 * The honest shape of this page:
 *
 * **The trace comes from running the program.** Python runs on the same
 * Pyodide /officina serves, in a worker, under src/lib/officina-ai/python/
 * tracer.py. C and Java are compiled here with the notebook's toolchains,
 * after src/lib/officina-ai/compiled/ has added the calls that make the
 * program report each line, every variable it changed, each condition with
 * the values it compared, and every call and return — as they happen. A
 * language model may later explain a trace; it never writes one.
 *
 * **Stepping is free.** A program is traced once; Next, Previous, the
 * scrubber and Play all read the finished trace in memory
 * (src/lib/officina-ai/trace/store.ts) and never run anything again.
 *
 * **It loads the chosen language straight away**, unlike the notebook, which
 * waits for a Run: somebody who opened this page came to run something, so
 * Python's 13 MB — or C's compiler, or Java's JVM — is fetched while they
 * read or type rather than after they press Trace.
 *
 * The examples are the notebook's, from the `recipes` collection, editable
 * from /admin. Each language's "Tracing" group was written to be stepped
 * through and comes first.
 */
const recipes = (await getCollection('recipes')).filter(
  (r) => ['python', 'c', 'java'].includes(r.data.language) && (import.meta.env.DEV || r.data.status !== 'draft')
);
const EXAMPLES = recipes.flatMap((recipe) => {
  const all = recipe.data.examples;
  const groups = [...new Set(all.map((x) => x.group))].sort(
    (a, b) => Number(b === 'Tracing') - Number(a === 'Tracing')
  );
  return groups.flatMap((group) =>
    all
      .filter((x) => x.group === group)
      .map(({ title, note, code, stdin }) => ({ language: recipe.data.language, title, note, group, code, stdin: stdin ?? '' }))
  );
});
// `<` escaped so an example containing "</script>" cannot end the data block.
const data = JSON.stringify(EXAMPLES).replace(/</g, '\\u003c');
---
<BaseLayout
  title={`Officina AI — ${AUTHOR}`}
  description="Write Python, C or Java, trace it, and step through the lines, variables, calls and output recorded as it runs in your browser."
  folio="O"
>
  <div class="codex oa" id="oa">
    <header class="oa-head">
      <p class="oa-kicker" data-reveal><a href="/officina">Officina</a> · AI</p>
      <h1 class="oa-h1" data-press>Write. Run. Understand.</h1>
      <p class="oa-lede codex-measure" data-reveal>
        Write a Python, C or Java program and press <strong>Trace</strong>. It runs here, in your browser, while
        the tracer records its lines, variables, calls and output. Then step through what happened,
        forwards and back, at your own pace.
      </p>
      <p class="oa-sub" data-reveal>
        Running and tracing stay on your device. The trace records real execution; the optional tutor explains it.
        <a class="link oa-back" href="/officina">Back to the notebook</a>
      </p>
    </header>

    <LesionRule />

    <div class="oa-bench">
      <div class="oa-bar">
        <div class="oa-tabs" role="tablist" aria-label="View">
          <button class="oa-tab" type="button" role="tab" id="oa-tab-code" aria-selected="true" aria-controls="oa-panel-code">Code</button>
          <button class="oa-tab" type="button" role="tab" id="oa-tab-trace" aria-selected="false" aria-controls="oa-panel-trace">Trace</button>
        </div>
        <label class="oa-lang">Language
          <select id="oa-language" aria-label="Programming language">
            <option value="python">Python</option>
            <option value="c">C</option>
            <option value="java">Java</option>
          </select>
        </label>
        <span class="oa-gap"></span>
        <button class="oa-btn" type="button" id="oa-examples" aria-haspopup="dialog">Examples</button>
        <button class="oa-btn oa-btn-go" type="button" id="oa-trace">▶ Trace</button>
        <button class="oa-btn" type="button" id="oa-stop" hidden>Stop trace</button>
      </div>
      <p class="oa-status" id="oa-status" role="status"></p>

      <section class="oa-panel" id="oa-panel-code" role="tabpanel" aria-labelledby="oa-tab-code">
        <div class="oa-editor">
          <div class="oa-gutter" id="oa-gutter" aria-hidden="true"></div>
          <textarea id="oa-code" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Python program"></textarea>
        </div>
        <details class="oa-stdin" id="oa-stdin-wrap">
          <summary>Input <span class="oa-note" id="oa-input-note">— what input() reads, one line per call</span></summary>
          <textarea id="oa-stdin" spellcheck="false" rows="3" aria-label="Program input"></textarea>
        </details>
        <p class="oa-hint">Ctrl/⌘ + Enter traces. In the trace: ← → step, Space plays, and clicking a line jumps to the next time it runs.</p>
        <p class="oa-hint" id="oa-language-note"></p>
      </section>

      <section class="oa-panel" id="oa-panel-trace" role="tabpanel" aria-labelledby="oa-tab-trace" hidden>
        <p class="oa-stale" id="oa-stale" hidden>
          The code or input has changed since this trace. <button class="oa-linkish" type="button" id="oa-retrace">Trace it again</button>
        </p>
        <div id="oa-view"></div>
        <p class="oa-empty" id="oa-none">Nothing traced yet. Write a program on the Code tab and press Trace.</p>
      </section>

      {/* The tutor: below both tabs, so "Ask for a program" is there before
          anything has been traced. Asked for explicitly; it downloads nothing
          until the reader presses its button. */}
      <section id="oa-tutor" aria-label="The tutor"></section>
    </div>

    {/* The example picker. A dialog rather than a <select>: fifty-odd
        examples in ten groups made a native menu taller than the window, and
        this one scrolls inside itself, filters, and closes on Escape — the
        same picker the notebook uses. */}
    <dialog class="oa-modal" id="oa-modal" aria-labelledby="oa-modal-title">
      <div class="oa-modal-head">
        <h2 class="oa-modal-title" id="oa-modal-title">Examples</h2>
        <input class="oa-search" type="search" id="oa-search" placeholder="Filter by name or topic…" aria-label="Filter examples" />
        <button class="oa-btn" type="button" id="oa-modal-close">Close</button>
      </div>
      <div class="oa-modal-body" id="oa-modal-body"></div>
    </dialog>

    <LesionRule />

    <section class="oa-about codex-measure">
      <h2 class="oa-h2">How this works</h2>
      <p>
        Python runs on CPython compiled to WebAssembly, in a background worker. C is compiled by clang and Java by
        the Eclipse compiler — the same toolchains the notebook uses — here in your browser, and Java then runs on
        <a href="https://cheerpj.com/">CheerpJ</a>'s JVM. Before a C or Java program is compiled, the tracer adds
        calls to it, on the lines they belong to, that report each step as it runs. Stepping through the finished
        recording never runs anything again.
      </p>
      <p>
        In C, arrays, strings, structs and enums are shown as values, and a pointer by what it points at; a variable
        not yet given a value shows as <code>?</code>. Indexing past an array, dividing by zero or following a NULL
        pointer stops the trace on the line that did it, where C itself would carry on into undefined behaviour. In
        Java, objects are shown field by field and the JDK's collections by what they hold; code inside a lambda
        runs without being traced. <code>goto</code> and threads are not supported. Every run stops at 50,000 steps or
        five seconds, and a trace cut short says so.
      </p>
      <p>
        C's compiler and Java's JVM are large, so each is fetched the first time you pick its language and kept by
        your browser after that. CheerpJ is the one thing here loaded from another site: its free licence allows it
        only from the vendor's own domain.
      </p>
      <p>
        The tutor under the program is a language model on this site's server. When you ask it something, your
        program and what the interpreter recorded about the step in view are sent to it, and it is asked to put
        those facts into words — it never produces a trace, and every answer is marked as its account. A program
        it writes goes into the editor to be traced like any other, so you can watch whether it works.
      </p>
    </section>
  </div>

  <script type="application/json" id="oa-data" set:html={data} is:inline />
</BaseLayout>

<script>
  import '../../lib/officina-ai/view/trace-view.css';
  import '../../lib/officina-ai/view/tutor-panel.css';
  import { PythonRuntime } from '../../lib/officina-ai/python/runtime.ts';
  import type { CompiledRuntime } from '../../lib/officina-ai/compiled/runtime.ts';
  import { LANGUAGE_NAMES, isTraceLanguage, type TraceLanguage, type TraceExample } from '../../lib/officina-ai/languages.ts';
  import { mountTraceView, type TraceView } from '../../lib/officina-ai/view/trace-view.ts';
  import { mountTutor, type TutorPanel } from '../../lib/officina-ai/view/tutor-panel.ts';
  import { RemoteProvider } from '../../lib/officina-ai/ai/remote.ts';
  import type { TraceResult } from '../../lib/officina-ai/trace/schema.ts';
  import type { TraceStore } from '../../lib/officina-ai/trace/store.ts';

  const STORE = 'officina.ai.v2';

  /**
   * One interpreter for as long as the reader stays on this page. The site
   * navigates without reloading, so this script outlives the page: leaving
   * shuts the workers down (each holds a Python heap), and coming back starts
   * them again.
   */
  let runtime: PythonRuntime | CompiledRuntime | null = null;
  let view: TraceView | null = null;
  /** The tutor's model — on this site's server, so there is nothing to load. */
  let provider: RemoteProvider | null = null;
  let tutor: TutorPanel | null = null;
  let pageGeneration = 0;

  function cleanup() {
    pageGeneration++;
    view?.destroy(); view = null;
    tutor?.destroy(); tutor = null;
    void provider?.unload(); provider = null;
    runtime?.dispose(); runtime = null;
  }

  function start() {
    const root = document.getElementById('oa');
    if (!root) {
      cleanup();
      return;
    }
    if (root.dataset.ready !== undefined) return;
    root.dataset.ready = '';
    const page = pageGeneration;
    const active = () => page === pageGeneration && root.isConnected;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const EXAMPLES: TraceExample[] = JSON.parse($('oa-data')?.textContent || '[]');
    const codeEl = $<HTMLTextAreaElement>('oa-code');
    const gutter = $<HTMLElement>('oa-gutter');
    const stdinEl = $<HTMLTextAreaElement>('oa-stdin');
    const stdinWrap = $<HTMLDetailsElement>('oa-stdin-wrap');
    const statusEl = $<HTMLElement>('oa-status');
    const traceBtn = $<HTMLButtonElement>('oa-trace');
    const stopBtn = $<HTMLButtonElement>('oa-stop');
    const languageEl = $<HTMLSelectElement>('oa-language');
    const examplesBtn = $<HTMLButtonElement>('oa-examples');
    const modal = $<HTMLDialogElement>('oa-modal');
    const modalBody = $<HTMLElement>('oa-modal-body');
    const modalTitle = $<HTMLElement>('oa-modal-title');
    const search = $<HTMLInputElement>('oa-search');
    const viewEl = $<HTMLElement>('oa-view');
    const staleEl = $<HTMLElement>('oa-stale');
    const noTrace = $<HTMLElement>('oa-none');
    const tabs = { code: $<HTMLButtonElement>('oa-tab-code'), trace: $<HTMLButtonElement>('oa-tab-trace') };
    const panels = { code: $<HTMLElement>('oa-panel-code'), trace: $<HTMLElement>('oa-panel-trace') };

    const debug = import.meta.env.DEV || new URLSearchParams(location.search).has('debug');
    let language: TraceLanguage = 'python';
    const buffers: Partial<Record<TraceLanguage, { code: string; stdin: string }>> = {};
    try {
      const saved = JSON.parse(localStorage.getItem(STORE) || 'null');
      if (isTraceLanguage(saved?.language)) language = saved.language;
      for (const lang of ['python', 'c', 'java'] as const) {
        const draft = saved?.buffers?.[lang];
        if (typeof draft?.code === 'string') buffers[lang] = { code: draft.code, stdin: typeof draft.stdin === 'string' ? draft.stdin : '' };
      }
      if (!buffers.python) {
        const legacy = JSON.parse(localStorage.getItem('officina.ai.v1') || 'null');
        if (typeof legacy?.code === 'string') buffers.python = { code: legacy.code, stdin: typeof legacy.stdin === 'string' ? legacy.stdin : '' };
      }
    } catch { /* drafts last this visit when storage is unavailable */ }
    /** The chosen language's runtime; C and Java's is fetched only once one of them is chosen. */
    let rt: Promise<PythonRuntime | CompiledRuntime> = Promise.resolve(null as never);
    let runGeneration = 0;
    view = null;
    let tracedSource: string | null = null;
    let tracedInput: string | null = null;
    let busy = false;
    let store: TraceStore | null = null;
    let lastResult: TraceResult | undefined;

    const status = (text: string, kind: 'idle' | 'busy' | 'error' = 'idle') => {
      statusEl.textContent = text;
      statusEl.dataset.kind = kind;
    };

    // ── Tabs ──
    const select = (tab: 'code' | 'trace') => {
      for (const name of ['code', 'trace'] as const) {
        tabs[name].setAttribute('aria-selected', String(name === tab));
        panels[name].hidden = name !== tab;
      }
      (tab === 'trace' ? viewEl : codeEl).focus({ preventScroll: true });
    };
    tabs.code.addEventListener('click', () => select('code'));
    tabs.trace.addEventListener('click', () => select('trace'));

    // ── The editor ──
    const paintGutter = () => {
      const n = codeEl.value.split('\n').length;
      gutter.textContent = Array.from({ length: n }, (_, i) => i + 1).join('\n');
    };
    const grow = () => {
      codeEl.style.height = 'auto';
      codeEl.style.height = `${Math.max(codeEl.scrollHeight, 240)}px`;
    };
    const save = () => {
      buffers[language] = { code: codeEl.value, stdin: stdinEl.value };
      try {
        localStorage.setItem(STORE, JSON.stringify({ language, buffers }));
      } catch { /* a private window: the work lasts this visit */ }
    };
    const markStale = () => {
      staleEl.hidden = tracedSource === null || (codeEl.value === tracedSource && stdinEl.value === tracedInput);
    };
    const cancelPending = () => {
      runGeneration++;
      runtime?.cancel();
      busy = false;
      traceBtn.disabled = false;
      stopBtn.hidden = true;
    };

    codeEl.addEventListener('input', () => {
      paintGutter();
      grow();
      save();
      markStale();
      // An edit supersedes a trace still being made — cancelled, not ignored.
      if (busy) { cancelPending(); status('Program changed. Trace again to record this version.'); }
      tutor?.refresh();
    });
    stdinEl.addEventListener('input', () => {
      save(); markStale();
      if (busy) { cancelPending(); status('Input changed. Trace again to use it.'); }
      tutor?.refresh();
    });

    // Tab indents rather than leaving the editor; Shift+Tab still leaves it.
    codeEl.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        void trace();
      } else if (e.key === 'Tab' && !e.shiftKey && !e.altKey) {
        e.preventDefault();
        codeEl.setRangeText('    ', codeEl.selectionStart, codeEl.selectionEnd, 'end');
        codeEl.dispatchEvent(new Event('input'));
      }
    });

    // ── Examples, grouped as the notebook groups them ──
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const renderExamples = (filter = '') => {
      const q = filter.trim().toLowerCase();
      const available = EXAMPLES.filter((x) => x.language === language);
      const matches = available.filter(
        (x) => !q || x.title.toLowerCase().includes(q) || x.note.toLowerCase().includes(q) || x.group.toLowerCase().includes(q)
      );
      modalTitle.textContent = `${LANGUAGE_NAMES[language]} examples — ${matches.length}${q ? ` of ${available.length}` : ''}`;
      const groups = [...new Set(matches.map((x) => x.group))];
      modalBody.innerHTML =
        groups
          .map((g) => `
            <section class="oa-ex-group">
              <h3 class="oa-ex-h">${esc(g)}</h3>
              <ul class="oa-ex-list">${matches
                .filter((x) => x.group === g)
                .map((x) => `
                  <li><button class="oa-ex-btn" type="button" data-ex="${EXAMPLES.indexOf(x)}">
                    <span class="oa-ex-t">${esc(x.title)}</span>
                    <span class="oa-ex-n">${esc(x.note)}</span>
                  </button></li>`)
                .join('')}</ul>
            </section>`)
          .join('') || '<p class="oa-ex-none">Nothing matches that.</p>';
    };
    examplesBtn.addEventListener('click', () => {
      search.value = '';
      renderExamples();
      modal.showModal();
      modalBody.scrollTop = 0;
    });
    $<HTMLButtonElement>('oa-modal-close').addEventListener('click', () => modal.close());
    // A click on the dimmed backdrop lands on the dialog element itself.
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
    search.addEventListener('input', () => renderExamples(search.value));
    modalBody.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ex]');
      const x = b && EXAMPLES[Number(b.dataset.ex)];
      if (!x) return;
      modal.close();
      codeEl.value = x.code;
      stdinEl.value = x.stdin;
      stdinWrap.open = Boolean(x.stdin);
      codeEl.dispatchEvent(new Event('input'));
      select('code');
      status(`${x.title}: ${x.note}`);
    });

    // ── Tracing ──
    async function trace() {
      if (busy || !active()) return;
      const source = codeEl.value;
      const input = stdinEl.value;
      if (!source.trim()) {
        status('There is no program to trace yet.', 'error');
        return;
      }
      busy = true;
      traceBtn.disabled = true;
      stopBtn.hidden = false;
      const generation = ++runGeneration;
      const current = () => active() && generation === runGeneration;
      const tracedLanguage = language;
      status(language === 'python' ? 'Preparing Python and tracing…'
        : `Compiling and tracing${runtime?.state === 'ready' ? '' : ` — ${LANGUAGE_NAMES[language]}'s compiler is still arriving`}…`, 'busy');

      try {
      const run = await (await rt).trace({ code: source, stdin: input });
      if (!current()) { run.cancel(); return; }
      view?.destroy();
      tracedSource = source;
      tracedInput = input;
      markStale();
      noTrace.hidden = true;
      store = run.store;
      lastResult = undefined;
      view = mountTraceView(viewEl, {
        source,
        language: tracedLanguage,
        store: run.store,
        // An answer is about the step it was asked about; moving on dates it.
        onStep: () => tutor?.refresh(),
      });
      select('trace');

      const result = await run.result;
      if (!current()) return;
      lastResult = result;
      busy = false;
      traceBtn.disabled = false;
      if (run.store.length === 0) {
        // Nothing ran, so there is nothing to step through — only the reason.
        view.destroy();
        view = null;
        noTrace.hidden = false;
        noTrace.textContent = failure(result);
        select(result.status === 'syntax' ? 'code' : 'trace');
        if (result.status === 'syntax' && result.error?.line) caret(result.error.line, result.error.column ?? 1);
      }
      status(summary(result, run.cached), result.status === 'ok' ? 'idle' : 'error');
      } catch (error) {
        if (current()) status(error instanceof Error ? error.message : 'The program could not be traced. Try again.', 'error');
      } finally {
        if (current()) { busy = false; traceBtn.disabled = false; stopBtn.hidden = true; }
      }
    }

    function summary(r: TraceResult, cached: boolean): string {
      const steps = `${r.steps.toLocaleString()} step${r.steps === 1 ? '' : 's'}`;
      const took = cached ? 'from the cache' : r.timing?.totalMs !== undefined ? `in ${r.timing.totalMs} ms` : '';
      switch (r.status) {
        case 'ok':
          return `Traced ${steps} ${took}.${r.exitCode ? ` The program exited with status ${r.exitCode}.` : ''}`;
        case 'error':
          return `Traced ${steps} ${took}. ${r.error?.message ?? `The program exited with status ${r.exitCode ?? 'unknown'}.`}`;
        case 'stopped':
        case 'cancelled':
          return r.stopped?.message ?? 'Stopped.';
        default:
          return failure(r);
      }
    }

    function failure(r: TraceResult): string {
      const e = r.error;
      if (r.status === 'syntax' && e) {
        const what = r.language === 'python' ? 'Syntax error' : 'Compile error';
        return `${what} on line ${e.line ?? '?'}${e.column ? `, column ${e.column}` : ''}: ${e.message.replace(/\.$/, '')}. Nothing ran, so there is no trace.`;
      }
      if (r.status === 'cancelled') return 'Cancelled before any step was recorded.';
      return e ? e.message : r.stopped?.message ?? 'The program produced no steps.';
    }

    function caret(line: number, column: number) {
      const before = codeEl.value.split('\n').slice(0, line - 1).join('\n').length + (line > 1 ? 1 : 0);
      const at = before + Math.max(0, column - 1);
      codeEl.focus();
      codeEl.setSelectionRange(at, at);
    }

    traceBtn.addEventListener('click', () => void trace());
    stopBtn.addEventListener('click', () => { cancelPending(); status('Trace stopped. Any recorded steps remain available; the trace is incomplete.'); });
    $<HTMLButtonElement>('oa-retrace').addEventListener('click', () => void trace());

    function prepareRuntime() {
      runtime?.dispose();
      runtime = null;
      const chosen = language;
      const name = LANGUAGE_NAMES[chosen];
      const watch = (prepared: PythonRuntime | CompiledRuntime) => {
        runtime = prepared;
        prepared.onStateChange((s) => {
          if (!active() || prepared !== runtime || busy) return;
          if (s === 'loading') status(chosen === 'python' ? 'Preparing Python — you can start writing.'
            : `Fetching ${name}'s ${chosen === 'c' ? 'compiler' : 'compiler and JVM'} — once per browser. You can start writing.`, 'busy');
          else if (s === 'ready') status(`${name} is ready.`);
          else if (s === 'failed') status(`${name} did not load. Check the connection and press Trace to retry.`, 'error');
        });
        void prepared.warm().catch(() => {});
        return prepared;
      };
      rt = chosen === 'python'
        ? Promise.resolve(watch(new PythonRuntime({ indexURL: '/pyodide/', debug })))
        : import('../../lib/officina-ai/compiled/runtime.ts').then(({ CompiledRuntime }) => {
            const prepared = new CompiledRuntime(chosen);
            // The reader may have moved on while the tracer's code arrived.
            if (!active() || language !== chosen) { prepared.dispose(); return prepared; }
            return watch(prepared);
          });
      rt.catch(() => { if (active()) status(`${name} did not load. Check the connection and reload the page.`, 'error'); });
    }

    // ── The tutor ──
    // Answered by the site's Worker (edge/tutor.js), which asks Cloudflare
    // Workers AI. Nothing is sent until the reader asks something.
    provider ??= new RemoteProvider({
      totalSteps: () => store?.length ?? 0,
      read: (i) => {
        if (!store) throw new Error('there is no trace to read');
        return store.at(i);
      },
    });
    tutor?.destroy();
    tutor = mountTutor($<HTMLElement>('oa-tutor'), {
      provider,
      providerName: provider.name,
      notice:
        'Asking sends your program and the facts of the step in view to the tutor on this site\u2019s ' +
        'server (Cloudflare Workers AI) to be answered. Nothing is kept. Running and tracing never leave your browser.',
      step: () => (store && view && view.index >= 0 ? store.at(view.index) : null),
      source: () => tracedSource ?? codeEl.value,
      editorSource: () => codeEl.value,
      language: () => language,
      result: () => lastResult,
      showStep: (index) => {
        view?.show(index);
        select('trace');
      },
      useProgram: (code) => {
        codeEl.value = code;
        codeEl.dispatchEvent(new Event('input'));
        select('code');
        status('The tutor wrote that. Trace it to see what it actually does.');
      },
    });

    // ── Start ──
    const NOTES: Record<TraceLanguage, string> = {
      python: 'Python runs on CPython 3.14 in WebAssembly.',
      c: 'C is compiled by clang (C23), here in your browser. Pointers are shown by what they point at; a value not yet set shows as ?. ' +
        'An index past an array, a division by zero or a NULL pointer stops the trace on the line that did it.',
      java: 'Java 8 is compiled by the Eclipse compiler and run on CheerpJ\u2019s JVM, here in your browser. ' +
        'Objects are shown field by field. Code inside a lambda runs without being traced.',
    };
    function restoreEditor() {
      const draft = buffers[language] ?? EXAMPLES.find((x) => x.language === language);
      codeEl.value = draft?.code ?? '';
      stdinEl.value = draft?.stdin ?? '';
      languageEl.value = language;
