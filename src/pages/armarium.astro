---
import { getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import { ARMARIUM_SHELVES } from '../lib/armarium';
import { AUTHOR } from '../consts';

/**
 * Armarium — the home library.
 *
 * Every book is rendered here as real HTML, so the page reads and searches
 * with the browser's own find even with scripts off. The script below adds the
 * catalogue: search, filters, sorting, grouping, two views, and a card for
 * each book. It never fetches anything; the whole collection is on the page.
 */
type Shelf = keyof typeof ARMARIUM_SHELVES;
const entries = (await getCollection('armarium')).sort(
  (a, b) => (a.data.accession ?? 1e9) - (b.data.accession ?? 1e9) || a.data.title.localeCompare(b.data.title),
);
const meta = await getEntry('site', 'armarium');
const ledes = (meta?.data.lede ?? '').split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);

/** Authors are credited as "A, B and C" or "A; B". The facet wants each name. */
const namesOf = (s: string | null | undefined) =>
  (s ?? '').split(/;|,|\sand\s/).map((n) => n.trim()).filter(Boolean);
/** Sort an author by surname, as a catalogue does. A parenthesis is a gloss. */
const surnameKey = (s: string | null | undefined) => {
  const first = namesOf(s)[0] ?? '';
  const parts = first.replace(/\(.*?\)/g, '').trim().split(/\s+/);
  return `${parts.at(-1) ?? ''} ${first}`.toLowerCase();
};
/** Lowercase, Latin accents folded, Bangla untouched (its vowel signs are marks too). */
const fold = (s: string) => s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase();
/** Publishers are written with and without the generic suffix; facet on the name. */
const pubKey = (p: string) =>
  p.replace(/\s*\((ভারত|India)\)\s*/g, '').split(/\s*\/\s*/)[0]
    .replace(/\s+(প্রকাশনী|প্রকাশন|প্রকাশনা সংস্থা|পাবলিকেশন্স|পাবলিকেশন|Publications?|Publishers?|Prokashoni|Prokashon)$/i, '')
    .trim();

const books = await Promise.all(
  entries.map(async (e) => {
    const d = e.data;
    const cover = d.cover
      ? await getImage({ src: d.cover, width: 360, format: 'webp', quality: 72 })
      : null;
    const shelves = d.shelves as Shelf[];
    return {
      id: e.id,
      acc: d.accession ?? null,
      accEnd: d.accessionEnd ?? null,
      volumes: d.volumes,
      title: d.title,
      titleBn: d.titleBn,
      series: d.series,
      seriesNo: d.seriesNumber ?? null,
      author: d.author,
      authors: namesOf(d.author),
      translator: d.translator,
      editor: d.editor,
      contributors: d.contributors,
      creditBn: d.creditBn,
      shelves,
      shelfNames: shelves.map((s) => ARMARIUM_SHELVES[s]),
      category: d.category,
      categoryBn: d.categoryBn,
      language: d.language,
      translated: d.translated,
      publisher: d.publisher,
      pub: d.publisher ? pubKey(d.publisher) : null,
      description: d.description,
      cover: cover?.src ?? null,
      coverAlt: d.coverAlt ?? `Cover of ${d.title}`,
      status: d.status ?? null,
      favourite: d.favourite,
      added: d.added ? d.added.toISOString().slice(0, 10) : null,
      notes: (e.body ?? '').trim().split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean),
      sortAuthor: surnameKey(d.author || d.editor || d.translator),
      search: fold([
        d.title, d.titleBn, d.series, d.author, d.translator, d.editor, d.contributors, d.creditBn,
        d.category, d.categoryBn, d.publisher, d.description, d.language, d.accession,
        ...shelves.map((s) => ARMARIUM_SHELVES[s]),
      ].filter(Boolean).join(' ')),
    };
  }),
);

/* ---- The collection at a glance. Counted, never typed. ---- */
const volumes = books.reduce((n, b) => n + b.volumes, 0);
const authorCount = new Map<string, number>();
for (const b of books) for (const a of b.authors) authorCount.set(a, (authorCount.get(a) ?? 0) + b.volumes);
const topAuthors = [...authorCount].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 6);
const byLang = Object.entries(
  books.reduce<Record<string, number>>((m, b) => ((m[b.language] = (m[b.language] ?? 0) + b.volumes), m), {}),
).sort((a, b) => b[1] - a[1]);
const translations = books.filter((b) => b.translated).reduce((n, b) => n + b.volumes, 0);
const seriesSet = new Set(books.map((b) => b.series).filter(Boolean));
const pubSet = new Set(books.map((b) => b.pub).filter(Boolean));
const shelfCount = (Object.keys(ARMARIUM_SHELVES) as Shelf[])
  .map((s) => [s, books.filter((b) => b.shelves[0] === s).reduce((n, b) => n + b.volumes, 0)] as const)
  .filter(([, n]) => n > 0)
  .sort((a, b) => b[1] - a[1]);
const nextAccession = Math.max(0, ...books.map((b) => b.accEnd ?? b.acc ?? 0)) + 1;
const hasStatus = books.some((b) => b.status);
const hasFav = books.some((b) => b.favourite);

/* Facet values for the selects, most-held first. */
const tally = (keys: (string | null | undefined)[]) => {
  const m = new Map<string, number>();
  for (const k of keys) if (k) m.set(k, (m.get(k) ?? 0) + 1);
  return [...m].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const authorOpts = tally(books.flatMap((b) => b.authors));
const pubOpts = tally(books.map((b) => b.pub));
const seriesOpts = tally(books.map((b) => b.series));
const langOpts = tally(books.map((b) => b.language));

/* What the script needs, without the derived search and sort keys (it builds
   those itself) and without empty fields, which are most of them. */
const data = Object.fromEntries(
  books.map(({ search, sortAuthor, shelfNames, ...b }) => [
    b.id,
    Object.fromEntries(Object.entries(b).filter(([, v]) => v !== null && v !== false && !(Array.isArray(v) && !v.length))),
  ]),
);
---
<BaseLayout
  title={`${meta?.data.title ?? 'Armarium'} — ${AUTHOR}`}
  description={`The home library: ${volumes} books, catalogued, searchable by title, author, shelf, language and publisher.`}
  folio="A"
>
  <div class="codex am">
    <header class="am-head">
      <p class="am-kicker" data-reveal>{meta?.data.kicker ?? 'Humaniora · the home library'}</p>
      <h1 class="am-h1" data-press>{meta?.data.title ?? 'Armarium'}</h1>
      {ledes.map((t) => <p class="am-lede codex-measure" data-reveal>{t}</p>)}
    </header>

    <section class="am-glance" aria-label="The collection at a glance" data-reveal>
      <dl class="am-figs">
        <div><dt>Books</dt><dd>{volumes}</dd></div>
        <div><dt>Titles</dt><dd>{books.length}</dd></div>
        <div><dt>Authors</dt><dd>{authorCount.size}</dd></div>
        <div><dt>Series</dt><dd>{seriesSet.size}</dd></div>
        <div><dt>Publishers</dt><dd>{pubSet.size}</dd></div>
        <div><dt>In translation</dt><dd>{translations}</dd></div>
      </dl>
      <div class="am-bars">
        <p class="am-bars-h">By shelf</p>
        <ul class="am-shelfbar" aria-label="Books on each shelf">
          {shelfCount.map(([s, n]) => (
            <li style={`flex-grow:${n}`} data-shelf={s} title={`${ARMARIUM_SHELVES[s]}: ${n}`}>
              <button type="button" data-filter-shelf={s} aria-label={`Show ${ARMARIUM_SHELVES[s]}, ${n} books`}></button>
            </li>
          ))}
        </ul>
        <p class="am-langs">
          {byLang.map(([l, n], i) => <>{i > 0 && ' · '}<button type="button" class="am-linkish" data-filter-lang={l}>{l}</button> {n}</>)}
        </p>
        <p class="am-bars-h">Most collected</p>
        <p class="am-top">
          {topAuthors.map(([a, n], i) => <>{i > 0 && ' · '}<button type="button" class="am-linkish" data-filter-author={a}>{a}</button> {n}</>)}
        </p>
      </div>
    </section>

    <LesionRule />

    {/* The catalogue's controls. Hidden until the script is running, since
        without it they would do nothing. */}
    <section class="am-tools" aria-label="Search and filter" data-tools hidden>
      <div class="am-searchrow">
        <div class="am-search">
          <label class="am-lbl" for="am-q">Search</label>
          <div class="am-combo">
            <input id="am-q" type="search" name="q" placeholder="Title, author, translator, publisher, in English or বাংলা" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="am-suggest" />
            <ul class="am-suggest" id="am-suggest" role="listbox" aria-label="Suggestions" data-suggest hidden></ul>
          </div>
        </div>
        <button type="button" class="am-btn" data-surprise title="Open a random book from the current results">Surprise me</button>
      </div>

      <div class="am-chips" role="group" aria-label="Shelf">
        <button type="button" class="am-chip" data-shelf-chip="" aria-pressed="true">All shelves</button>
        {(Object.keys(ARMARIUM_SHELVES) as Shelf[]).filter((s) => books.some((b) => b.shelves.includes(s))).map((s) => (
          <button type="button" class="am-chip" data-shelf-chip={s} data-shelf={s} aria-pressed="false">
            <span class="am-swatch" aria-hidden="true"></span>{ARMARIUM_SHELVES[s]} <span class="am-n" data-count={s}></span>
          </button>
        ))}
      </div>

      <details class="am-more" open>
        <summary>Filters, sorting and view</summary>
        <div class="am-grid">
          <label><span class="am-lbl">Language</span>
            <select name="lang"><option value="">Any</option>{langOpts.map(([l, n]) => <option value={l}>{l} ({n})</option>)}</select>
          </label>
          <label><span class="am-lbl">Edition</span>
            <select name="tr"><option value="">Originals and translations</option><option value="orig">Originals only</option><option value="tr">Translations only</option></select>
          </label>
          <label><span class="am-lbl">Author</span>
            <select name="author"><option value="">Any author</option>{authorOpts.map(([a, n]) => <option value={a}>{a} ({n})</option>)}</select>
          </label>
          <label><span class="am-lbl">Publisher</span>
            <select name="pub"><option value="">Any publisher</option>{pubOpts.map(([p, n]) => <option value={p}>{p} ({n})</option>)}</select>
          </label>
          <label><span class="am-lbl">Series</span>
            <select name="series"><option value="">Any series</option><option value="*">Only books in a series</option>{seriesOpts.map(([s, n]) => <option value={s}>{s} ({n})</option>)}</select>
          </label>
          {(hasStatus || hasFav) && (
            <label><span class="am-lbl">Reading</span>
              <select name="status">
                <option value="">Any</option>
                {hasFav && <option value="fav">Favourites</option>}
                {hasStatus && <><option value="reading">Reading now</option><option value="read">Read</option><option value="unread">Not yet read</option></>}
              </select>
            </label>
          )}
          <label><span class="am-lbl">Sort by</span>
            <select name="sort">
              <option value="acc">Shelf number</option>
              <option value="title">Title, A to Z</option>
              <option value="author">Author, by surname</option>
              <option value="series">Series, in order</option>
              <option value="added">Recently added</option>
            </select>
          </label>
          <label><span class="am-lbl">Group by</span>
            <select name="group">
              <option value="">No grouping</option>
              <option value="shelf">Shelf</option>
              <option value="author">Author</option>
              <option value="series">Series</option>
              <option value="language">Language</option>
              <option value="pub">Publisher</option>
            </select>
          </label>
          <div class="am-view" role="group" aria-label="View">
            <span class="am-lbl">View</span>
            <span>
              <button type="button" class="am-btn" data-view="covers" aria-pressed="true">Covers</button>
              <button type="button" class="am-btn" data-view="list" aria-pressed="false">List</button>
            </span>
          </div>
        </div>
      </details>

      <p class="am-status" aria-live="polite">
        <span data-result-count></span>
        <button type="button" class="am-linkish" data-reset hidden>Clear all filters</button>
      </p>
    </section>

    <div class="am-results" data-results data-view="covers">
      {books.map((b) => (
        <article class="am-book" id={b.id} data-id={b.id} data-shelf={b.shelves[0]}>
          <button type="button" class="am-open" data-open={b.id} aria-label={`${b.title}${b.author ? `, ${b.author}` : ''} — details`}>
            <span class="am-cover">
              {b.cover ? (
                <img src={b.cover} alt="" loading="lazy" decoding="async" width="180" height="270" />
              ) : (
                <span class="am-gen" aria-hidden="true">
                  <span class="am-gen-t" lang={b.language === 'Bangla' && b.titleBn ? 'bn' : 'en'}>
                    {b.language === 'Bangla' && b.titleBn ? b.titleBn : b.title}
                  </span>
                  <span class="am-gen-a">{b.author ?? b.editor ?? b.translator}</span>
                </span>
              )}
              {b.volumes > 1 && <span class="am-vols">{b.volumes} vols</span>}
            </span>
            <span class="am-meta">
              <span class="am-t">{b.title}</span>
              {b.titleBn && b.titleBn !== b.title && <span class="am-tbn" lang="bn">{b.titleBn}</span>}
              <span class="am-a">{b.author ?? b.editor}{b.translator && <span class="am-tr"> · trans. {b.translator}</span>}</span>
              <span class="am-x">
                <span class="am-x-acc">No. {b.acc}{b.accEnd && `–${b.accEnd}`}</span>
                <span class="am-x-shelf">{b.shelfNames.join(' · ')}</span>
                <span class="am-x-lang">{b.language}{b.translated && ' (translation)'}</span>
                {b.series && <span class="am-x-series">{b.series}{b.seriesNo && ` · ${b.seriesNo}`}</span>}
                {b.publisher && <span class="am-x-pub">{b.publisher}</span>}
              </span>
            </span>
          </button>
        </article>
      ))}
    </div>

    <p class="am-foot">
      {volumes} books on {shelfCount.length} shelves. The next accession number is {nextAccession}.
      <span class="am-owner"> <a class="link" href="/admin/#/collections/armarium/new">Add a book</a>.</span>
    </p>
  </div>

  <dialog class="am-dialog" data-dialog aria-labelledby="am-d-title">
    <form method="dialog" class="am-d-close"><button class="am-btn" value="close" aria-label="Close">Close ×</button></form>
    <div class="am-d" data-dialog-body></div>
  </dialog>

  <script is:inline type="application/json" id="am-data" set:html={JSON.stringify({ books: data, shelves: ARMARIUM_SHELVES })}></script>
</BaseLayout>

<script>
  import '../scripts/armarium.ts';
</script>

<style is:global>
  /* Global rather than scoped: the book card is filled in by the script, and
     scoped styles do not reach elements a script creates. Every rule is
     prefixed .am or .am- so nothing leaks. */

  /* Each shelf is a bookcloth colour. Dark enough that the pale title on a
     generated cover reads at well over 7:1 in both themes. */
  [data-shelf] { --cloth: #3B3B52; }
  [data-shelf='classic-bengali'] { --cloth: #6B2230; }
  [data-shelf='contemporary-bengali'] { --cloth: #7A3E2E; }
  [data-shelf='world-classics'] { --cloth: #2F3E5C; }
  [data-shelf='literary-fiction'] { --cloth: #4A5A3C; }
  [data-shelf='thriller'] { --cloth: #2B2B2B; }
  [data-shelf='horror'] { --cloth: #3A1F2B; }
  [data-shelf='fantasy'] { --cloth: #2E4B4F; }
  [data-shelf='science-fiction'] { --cloth: #263E5E; }
  [data-shelf='historical-fiction'] { --cloth: #5C4424; }
  [data-shelf='adventure'] { --cloth: #3F5A2A; }
  [data-shelf='mythology'] { --cloth: #6A4A12; }
  [data-shelf='poetry-drama'] { --cloth: #5A2E4E; }
  [data-shelf='history-politics'] { --cloth: #3B3B52; }
  [data-shelf='philosophy'] { --cloth: #39404A; }
  [data-shelf='religion'] { --cloth: #1F4A3F; }
  [data-shelf='self-development'] { --cloth: #6A5A1E; }
  [data-shelf='science'] { --cloth: #1E3F52; }

  .am [lang='bn'], .am-dialog [lang='bn'] {
    font-family: 'Noto Serif Bengali', 'Noto Sans Bengali', 'Kohinoor Bangla', 'Bangla Sangam MN', 'Hind Siliguri', var(--font-body);
  }

  .am { padding-top: clamp(2.5rem, 7vh, 5rem); padding-bottom: 3rem; }
  .am-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.8rem;
  }
  .am-h1 { font-size: clamp(var(--t-2xl), 5vw, 4rem); line-height: 1.02; margin: 0 0 1.1rem; }
  .am-lede { font-size: var(--body-size); line-height: var(--body-leading); color: var(--ink-soft); }

  /* ---- At a glance ---- */
  .am-glance { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: 2rem; align-items: start; }
  @media (max-width: 52rem) { .am-glance { grid-template-columns: minmax(0, 1fr); } }
  .am-figs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem 1.5rem; margin: 0; }
  .am-figs div { border-top: var(--rule) solid color-mix(in srgb, var(--brass) 55%, transparent); padding-top: 0.5rem; }
  .am-figs dt { font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass-text); }
  .am-figs dd { margin: 0.15rem 0 0; font-family: var(--font-display); font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.1; color: var(--fundus); font-variant-numeric: lining-nums; }
  .am-bars-h { font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass-text); margin: 0 0 0.45rem; }
  .am-bars-h + * { margin-bottom: 1rem; }
  .am-shelfbar { display: flex; list-style: none; margin: 0; padding: 0; height: 1.4rem; border-radius: 2px; overflow: hidden; gap: 1px; background: color-mix(in srgb, var(--brass) 30%, transparent); }
  .am-shelfbar li { flex-basis: 0; min-width: 4px; background: var(--cloth); }
  .am-shelfbar button { display: block; width: 100%; height: 100%; border: 0; padding: 0; background: none; cursor: pointer; }
  .am-shelfbar li:hover { filter: brightness(1.35); }
  .am-langs, .am-top { font-size: var(--t-sm); color: var(--ink-soft); line-height: 1.8; }
  .am-linkish {
    border: 0; padding: 0; background: none; font: inherit; color: var(--fundus); cursor: pointer;
    text-decoration: underline; text-decoration-thickness: 0.5px; text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--fundus) 45%, transparent);
  }
  .am-linkish:hover { text-decoration-color: var(--fundus); }

  /* ---- Tools ---- */
  .am-tools { position: relative; scroll-margin-top: 5rem; }
  .am-searchrow { display: flex; gap: 0.8rem; align-items: end; flex-wrap: wrap; }
  .am-search { flex: 1 1 22rem; display: grid; gap: 0.3rem; }
  .am-lbl { font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass-text); }
  .am-search input, .am-grid select {
    width: 100%;
    font: inherit;
    font-size: var(--t-base);
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
    border-radius: 2px;
    padding: 0.6rem 0.75rem;
  }
  .am-search input { font-size: var(--t-md); padding: 0.7rem 0.9rem; }
  .am-search input:focus, .am-grid select:focus { outline: 2px solid var(--fundus); outline-offset: 1px; }
  .am-combo { position: relative; }
  .am-suggest {
    position: absolute;
    z-index: 20;
    inset: calc(100% + 4px) 0 auto;
    margin: 0;
    padding: 0.3rem 0;
    list-style: none;
    max-height: min(28rem, 62vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--paper-raised);
    border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
    border-radius: 2px;
    box-shadow: 0 14px 36px -14px rgb(0 0 0 / 0.5);
  }
  .am-sg { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem; align-items: baseline; padding: 0.5rem 0.9rem; cursor: pointer; }
  .am-sg[aria-selected='true'], .am-sg:hover { background: color-mix(in srgb, var(--fundus) 13%, transparent); }
  .am-sg-main { color: var(--ink); font-size: var(--t-base); }
  .am-sg-sub { grid-row: 2; font-size: var(--t-sm); color: var(--ink-soft); }
  .am-sg-kind { grid-column: 2; grid-row: 1; font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--brass-text); white-space: nowrap; }
  .am-sg mark { background: none; color: var(--fundus); font-weight: 600; }
  .am-sg-all { border-top: 1px solid color-mix(in srgb, var(--brass) 35%, transparent); margin-top: 0.3rem; }
  .am-sg-all .am-sg-main { font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--fundus); }
  .am-btn {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: 1px solid color-mix(in srgb, var(--brass) 60%, transparent);
    border-radius: 2px;
    padding: 0.65rem 0.95rem;
    cursor: pointer;
  }
  .am-btn:hover { border-color: var(--fundus); color: var(--fundus); }
  .am-btn[aria-pressed='true'] { background: color-mix(in srgb, var(--fundus) 14%, transparent); border-color: var(--fundus); color: var(--fundus); }

  .am-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 1.1rem 0 0.4rem; }
  .am-chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
