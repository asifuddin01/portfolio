---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import FigureFrame from '../../components/elementa/FigureFrame.astro';
import { FIGURES } from '../../lib/figures';

const entries = Object.entries(FIGURES);
---
<BaseLayout
  title="The figure library — Md. Asif Uddin"
  description="Every diagram on the site, each with its own permalink and a copy-SVG button. Figures are the shareable unit of technical writing."
  folio="F"
>
  <div class="codex figs">
    <header class="fg-head">
      <p class="fg-kicker" data-reveal>Elementa</p>
      <h1 class="fg-h1" data-press>The figure library</h1>
      <p class="fg-lede codex-measure" data-reveal>
        Every diagram on this site, at its own address. All are hand-written inline
        SVG using the site palette, so they stay legible in both themes and paste
        into a slide deck without becoming a screenshot of a screenshot.
      </p>
    </header>

    <LesionRule />

    {entries.map(([name, fig], i) => {
      const Figure = fig.component;
      return (
        <section class="fg-item" id={name}>
          <div class="fg-bar">
            <p class="fg-name">{name}</p>
            <div class="fg-actions">
              <span class="fg-source">{fig.source}</span>
              <a class="fg-permalink" href={`/elementa/figures#${name}`}>permalink</a>
              <button class="fg-copy" type="button" data-copy-svg aria-label={`Copy the SVG for ${name}`}>
                copy SVG
              </button>
            </div>
          </div>
          <div class="fig-draw" data-reveal>
            <FigureFrame n={i + 1} numeral="arabic" caption={fig.caption}>
              <Figure />
            </FigureFrame>
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  .figs { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .fg-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .fg-h1 { font-size: var(--t-2xl); margin-bottom: 1.2rem; }
  .fg-lede { font-size: var(--body-size); line-height: var(--body-leading); }
  .fg-item { margin-bottom: 3rem; scroll-margin-top: 5rem; }
  .fg-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    padding-bottom: 0.5rem;
  }
  .fg-name {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--ink);
    margin: 0;
  }
  .fg-actions {
    display: flex;
    gap: 1.1rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    flex-wrap: wrap;
  }
  .fg-source { color: var(--ink-soft); }
  .fg-permalink { color: var(--brass-text); }
  .fg-permalink:hover { color: var(--fundus); }
  .fg-copy {
    font: inherit;
    letter-spacing: 0.04em;
    color: var(--brass-text);
    background: transparent;
    border: var(--rule) solid var(--brass);
    padding: 0.16em 0.55em;
    cursor: pointer;
  }
  .fg-copy:hover { background: color-mix(in srgb, var(--brass) 14%, transparent); }
  .fg-copy[data-done='1'] { color: var(--verdigris); border-color: var(--verdigris); }
</style>

<script>
  function bindCopy(): void {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-svg]')) {
      if (btn.dataset.bound === '1') continue;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const section = btn.closest('section');
        const svg = section?.querySelector('svg');
        if (!svg) return;
        const markup = svg.outerHTML;
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(markup);
          btn.textContent = 'copied';
        } catch {
          btn.textContent = 'copy failed';
        }
        btn.dataset.done = '1';
        window.setTimeout(() => {
          btn.textContent = original;
          delete btn.dataset.done;
        }, 1800);
      });
    }
  }
  document.addEventListener('astro:page-load', bindCopy);
  if (document.readyState !== 'loading') bindCopy();
  else document.addEventListener('DOMContentLoaded', bindCopy);
</script>
