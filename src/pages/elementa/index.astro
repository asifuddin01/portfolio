---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import Progress from '../../components/elementa/Progress.astro';
import MathTier from '../../components/elementa/MathTier.astro';
import { getEntry } from 'astro:content';
import { getElementaTree, getProblems, getApparatus } from '../../lib/collections';
import {
  MATH_TIERS, TIER_RULES, COVERAGE_RULES, type MathTier as Tier,
} from '../../lib/elementa-spec';
// KaTeX's stylesheet, scoped to the Elementa routes — the rest of the
// site has no equations and should not carry it.
import '../../styles/math.css';

const tree = await getElementaTree();
const meta = await getEntry('site', 'elementa');
const items = await getProblems();
const parts = await getApparatus();
const written = tree.reduce((n, b) => n + b.propositions.length, 0);
const chapters = tree.reduce((n, b) => n + b.chapters.length, 0);
const apparatusCount = parts.reduce((n, p) => n + p.entries.length, 0);

/**
 * The tier index (spec §15) — the whole work at a glance.
 *
 * Counted from the chapters themselves rather than transcribed, so it cannot
 * drift from what the corpus actually declares, and so the minimum problem
 * and exercise counts are the ones the guard will enforce.
 */
const rows = tree.map((b) => {
  const byTier = Object.fromEntries(
    MATH_TIERS.map((t) => [t, b.chapters.filter((c) => c.tier === t).length])
  ) as Record<Tier, number>;
  const minProblems = b.chapters.reduce((n, c) => n + TIER_RULES[c.tier].minProblems, 0);
  const minExercises = b.chapters.reduce((n, c) => n + TIER_RULES[c.tier].minExercises, 0);
  const have = items.filter((p) => p.data.id.startsWith(`${b.numeral}.`));
  // §7.2 — definitions are the largest single obligation in the corpus, and
  // the one a mathematics-only table would hide entirely.
  const minDefinitions = b.chapters.reduce((n, c) => n + COVERAGE_RULES[c.tier].definitions, 0);
  const haveDefinitions = b.chapters.reduce(
    (n, c) => n + c.chapter.data.definitions.length, 0
  );
  return {
    b, byTier, minProblems, minExercises, minDefinitions, haveDefinitions,
    haveProblems: have.filter((p) => p.data.kind === 'problem').length,
    haveExercises: have.filter((p) => p.data.kind === 'exercise').length,
  };
});
const total = {
  byTier: Object.fromEntries(
    MATH_TIERS.map((t) => [t, rows.reduce((n, r) => n + r.byTier[t], 0)])
  ) as Record<Tier, number>,
  minProblems: rows.reduce((n, r) => n + r.minProblems, 0),
  minExercises: rows.reduce((n, r) => n + r.minExercises, 0),
  minDefinitions: rows.reduce((n, r) => n + r.minDefinitions, 0),
  haveProblems: rows.reduce((n, r) => n + r.haveProblems, 0),
  haveExercises: rows.reduce((n, r) => n + r.haveExercises, 0),
  haveDefinitions: rows.reduce((n, r) => n + r.haveDefinitions, 0),
};
---
<BaseLayout
  title="Elementa — Md. Asif Uddin"
  description="A course in deep learning written as a sequence of propositions, from foundations through vision, language and causal inference to practice."
  folio="E"
>
  <div class="codex el">
    <header class="el-head">
      {meta?.data.kicker && <p class="el-kicker" data-reveal>{meta.data.kicker}</p>}
      <h1 class="el-h1" data-press>Elementa</h1>
      {meta?.data.lede && <p class="el-lede codex-measure" data-reveal>{meta.data.lede}</p>}
      <div class="el-meta" data-reveal>
        <Progress done={written} label={`${tree.length} books · ${chapters} chapters`} />
        <p class="el-figlink">
          <a class="link" href="/elementa/map">The whole work as a graph →</a><br />
          <a class="link" href="/elementa/figures">Every figure, with permalinks →</a>
        </p>
      </div>
    </header>

    <LesionRule />

    <ol class="el-books" data-reveal-stagger>
      {tree.map((b) => (
        <li class="el-book">
          <a class="el-book-link" href={`/elementa/${b.book.id}`}>
            <span class="el-book-n">Book {b.numeral}</span>
            <span class="el-book-body">
              <span class="el-book-t">{b.book.data.title}</span>
              <span class="el-book-c">{b.book.data.covers}</span>
              {b.book.data.goal && <span class="el-book-goal">{b.book.data.goal}</span>}
            </span>
            <span class="el-book-count">
              {b.chapters.length} {b.chapters.length === 1 ? 'chapter' : 'chapters'}
              <em>{b.propositions.length} propositions written</em>
              <em>{b.chapters.filter((c) => c.tier === 'M3').length} load-bearing</em>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <a class="el-card" href="/elementa/apparatus" data-reveal>
      <span class="el-card-label">Book 0 · Apparatus</span>
      <span class="el-card-t">The mathematics the other seven books assume</span>
      <span class="el-card-s">
        {apparatusCount} entries across seven parts — linear algebra, matrix
        calculus, probability, information, optimisation, statistics, numerics.
        A reference volume, not a linear read, and never a gate: start Book I
        today and follow the links when a step stops making sense.
      </span>
    </a>

    <LesionRule />

    <section class="el-tiers" data-reveal aria-labelledby="el-tiers-h">
      <h2 class="el-label" id="el-tiers-h">The whole work at a glance</h2>
      <p class="el-note codex-measure">
        Every chapter declares how much mathematical load it carries, and the
        declaration has consequences. A load-bearing chapter owes five worked
        problems across four distinct variants, ten solved exercises, eight
        numbered definitions, two named results each with the boundary of its
        guarantee, and two concrete failures — before it can be marked
        published. These minima are summed from what the chapters actually
        declare, so the table cannot drift from the corpus.
      </p>

      <p class="el-legend">
        {MATH_TIERS.map((t) => <MathTier value={t} />)}
      </p>

      <div class="el-tablewrap">
        <table class="el-table">
          <thead>
            <tr>
              <th scope="col">Book</th>
              {MATH_TIERS.map((t) => <th scope="col">{t}</th>)}
              <th scope="col">Definitions</th>
              <th scope="col">Problems</th>
              <th scope="col">Exercises</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">
                  <a class="link" href={`/elementa/${r.b.book.id}`}>{r.b.numeral} · {r.b.book.data.title}</a>
                </th>
                {MATH_TIERS.map((t) => (
                  <td class={r.byTier[t] === 0 ? 'el-zero' : undefined}>{r.byTier[t] || '—'}</td>
                ))}
                <td>{r.haveDefinitions} / {r.minDefinitions}</td>
                <td>{r.haveProblems} / {r.minProblems}</td>
                <td>{r.haveExercises} / {r.minExercises}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">All eight</th>
              {MATH_TIERS.map((t) => <td>{total.byTier[t]}</td>)}
              <td>{total.haveDefinitions} / {total.minDefinitions}</td>
              <td>{total.haveProblems} / {total.minProblems}</td>
              <td>{total.haveExercises} / {total.minExercises}</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="el-note codex-measure">
        That total is not a burden to be reduced. It is the difference between
        a body of knowledge and a set of articles, and it is why the books are
        built one at a time rather than all at once.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .el { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .el-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .el-h1 { font-size: var(--t-2xl); margin-bottom: 1.2rem; }
  .el-lede { font-size: var(--body-size); line-height: var(--body-leading); margin-bottom: 1.6rem; }
  .el-meta { display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; align-items: end; }
  .el-figlink { font-family: var(--font-mono); font-size: var(--t-xs); margin: 0; }

  .el-books {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 64rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .el-book { border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent); }
  .el-book-link {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1.2rem;
    align-items: baseline;
    padding: 1.4rem 0;
    color: var(--ink);
  }
  .el-book-n {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .el-book-body { display: block; }
  .el-book-t { display: block; font-family: var(--font-display); font-size: var(--t-lg); line-height: 1.2; }
  .el-book-link:hover .el-book-t { color: var(--fundus); }
  .el-book-c {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }
  .el-book-goal {
    display: block;
    font-size: var(--t-base);
    color: var(--ink-soft);
    line-height: 1.55;
    margin-top: 0.45rem;
    max-width: 52ch;
  }
  .el-book-count {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--brass-text);
    text-align: right;
    white-space: nowrap;
  }
  .el-book-count em { display: block; font-style: normal; color: var(--ink-soft); margin-top: 0.2rem; }

  .el-card {
    display: block;
    margin-top: 2.4rem;
    padding: 1.4rem 1.6rem;
    max-width: 64rem;
    border: var(--rule) solid color-mix(in srgb, var(--brass) 60%, transparent);
    background: var(--paper-raised);
    color: var(--ink);
  }
  .el-card:hover { border-color: var(--fundus); }
  .el-card-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.5rem;
  }
  .el-card-t { display: block; font-family: var(--font-display); font-size: var(--t-md); }
  .el-card:hover .el-card-t { color: var(--fundus); }
  .el-card-s {
    display: block;
    font-size: var(--t-base);
    color: var(--ink-soft);
    line-height: 1.6;
    margin-top: 0.35rem;
    max-width: 62ch;
  }

  .el-tiers { margin: 2.4rem 0 3rem; }
  .el-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.7rem;
  }
  .el-note { font-size: var(--t-base); color: var(--ink-soft); line-height: 1.65; margin: 0 0 1.1rem; }
  .el-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin: 0 0 1.2rem; }
  .el-tablewrap { max-width: 64rem; overflow-x: auto; margin-bottom: 1.2rem; }
  .el-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
  }
  .el-table th, .el-table td {
    text-align: right;
    padding: 0.5rem 0.7rem;
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 25%, transparent);
    white-space: nowrap;
  }
  .el-table thead th {
    color: var(--brass-text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 400;
    border-bottom-color: color-mix(in srgb, var(--brass) 55%, transparent);
  }
  /* The first column names the book; only the counts are right-aligned. */
  .el-table thead th:first-child,
  .el-table tbody th,
  .el-table tfoot th { text-align: left; font-weight: 400; }
  .el-table tfoot th, .el-table tfoot td {
    color: var(--ink);
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 55%, transparent);
    border-bottom: none;
  }
  .el-zero { color: var(--ink-soft); opacity: 0.5; }

  @media (max-width: 720px) {
    .el-book-link { grid-template-columns: 1fr; gap: 0.3rem; }
    .el-book-count { text-align: left; }
  }
</style>
