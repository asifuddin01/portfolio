---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import GivenList from '../../components/elementa/GivenList.astro';
import FigureFrame from '../../components/elementa/FigureFrame.astro';
import { getPropositions, getBookIndex } from '../../lib/collections';
import { FIGURES, isFigureName } from '../../lib/figures';
import { toRoman } from '../../consts';

export async function getStaticPaths() {
  const props = await getPropositions();
  const index = await getBookIndex();
  const numeral = (e: (typeof props)[number]) => index.get(e.data.book.id)?.n ?? 0;
  return props.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      all: props,
      next: props[i + 1] ?? null,
      bookN: numeral(entry),
      nextBookN: props[i + 1] ? numeral(props[i + 1]!) : 0,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'elementa'>;
  all: CollectionEntry<'elementa'>[];
  next: CollectionEntry<'elementa'> | null;
  bookN: number;
  nextBookN: number;
}
const { entry, all, next, bookN, nextBookN } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const figName = d.figure && isFigureName(d.figure) ? d.figure : null;
const fig = figName ? FIGURES[figName] : null;
const Figure = fig?.component;
---
<BaseLayout
  title={`Book ${toRoman(bookN)}, Prop. ${d.proposition} — ${d.statement}`}
  description={d.statement}
  folio={`${bookN}.${d.proposition}`}
  type="article"
>
  <article class="codex prop">
    <header class="pp-head">
      <p class="pp-ref" data-reveal>
        Book {toRoman(bookN)} · Proposition {d.proposition}
        {d.status === 'draft' && <span class="pp-draft">draft</span>}
      </p>
      <h1 class="pp-st" data-press>{d.statement}</h1>
    </header>

    <GivenList given={d.given} all={all} />

    {Figure && fig && (
      <div class="fig-draw" data-reveal>
        <FigureFrame n={d.proposition} numeral="arabic" caption={fig.caption} id={figName ?? undefined}>
          <Figure />
        </FigureFrame>
      </div>
    )}

    <div class="prose pp-body"><Content /></div>

    <LesionRule />

    <nav class="pp-next" aria-label="Next proposition">
      {next ? (
        <a class="pp-next-link" href={`/elementa/${next.id}`} data-magnet>
          <span class="pp-next-label">
            Next — Book {toRoman(nextBookN)}, Prop. {next.data.proposition}
          </span>
          <span class="pp-next-st">{next.data.statement}</span>
        </a>
      ) : (
        <a class="pp-next-link" href="/elementa" data-magnet>
          <span class="pp-next-label">End of the written corpus</span>
          <span class="pp-next-st">Back to the index</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .prop { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .pp-head { margin-bottom: 1.4rem; }
  .pp-ref {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.9rem;
  }
  .pp-draft {
    margin-left: 0.7rem;
    color: var(--oxblood-text);
    border: var(--rule) solid var(--oxblood);
    padding: 0.05em 0.4em;
  }
  .pp-st { font-size: var(--t-xl); line-height: 1.15; max-width: 24ch; }
  .pp-body { margin-top: 2rem; }
  .pp-next { margin-bottom: 2rem; }
  .pp-next-link { display: inline-block; }
  .pp-next-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.4rem;
  }
  .pp-next-st { font-family: var(--font-display); font-size: var(--t-md); color: var(--fundus); }
  @media (max-width: 640px) { .pp-st { font-size: var(--t-lg); } }
</style>
