---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookReader from '../../../components/book/BookReader.astro';
import { getNumina } from '../../../lib/collections';
import { toRoman } from '../../../consts';

export async function getStaticPaths() {
  const books = await getNumina();
  return books.flatMap((b, bi) => {
    // Previous and next run across the whole book, not just the chapter, so
    // reading straight through works the way it would in a printed one.
    const flat = b.chapters.flatMap((c) => c.topics.map((t) => ({ t, c })));
    return flat.map(({ t, c }, i) => ({
      params: { pantheon: b.slug, slug: t.id },
      props: {
        entry: t,
        bookName: b.entry.data.name,
        bookSlug: b.slug,
        chapterTitle: c.title,
        chapterNumber: `${toRoman(bi + 1)}.${b.chapters.indexOf(c) + 1}`,
        prev: flat[i - 1]?.t ?? null,
        next: flat[i + 1]?.t ?? null,
      },
    }));
  });
}

interface Props {
  entry: CollectionEntry<'numina'>;
  bookName: string;
  bookSlug: string;
  chapterTitle: string;
  chapterNumber: string;
  prev: CollectionEntry<'numina'> | null;
  next: CollectionEntry<'numina'> | null;
}
const { entry, bookName, bookSlug, chapterTitle, chapterNumber, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<BaseLayout
  title={`${d.title} — ${bookName} — Md. Asif Uddin`}
  description={d.summary}
  folio="N"
  type="article"
  book="numina"
>
  <article class="codex nx sheet" data-folio={chapterNumber} data-book-source>
    <p class="nx-trail book-head">
      <a href="/numina">Numina</a>{' · '}<a href={`/numina/${bookSlug}`}>{bookName}</a>{' · '}{chapterNumber} {chapterTitle}
      {d.status !== 'published' && <span class="nx-draft">{d.status}</span>}
    </p>

    <header class="nx-head book-chapter-head">
      <p class="nx-n" data-reveal>Chapter {chapterNumber}</p>
      <h1 class="nx-title" data-press>{d.title}</h1>
      <span class="book-orn book-orn--leaf" aria-hidden="true"></span>
      <p class="nx-summary" data-reveal>{d.summary}</p>
      <p class="nx-read" data-reveal><BookReader head={`Numina · ${bookName}`} title={d.title} /></p>
    </header>

    {d.image && (
      <figure class="nx-figure" data-reveal>
        <Image src={d.image} alt={d.alt ?? ''} widths={[480, 900, 1400]} loading="eager" />
        {d.credit && <figcaption class="nx-credit">{d.credit}</figcaption>}
      </figure>
    )}

    <div class="nx-body prose book-text">
      <Content />
    </div>

    {d.sources.length > 0 && (
      <section class="nx-sources codex-measure">
        <h2 class="nx-h2">Sources</h2>
        <ul class="nx-source-list">
          {d.sources.map((s) => (
            <li>
              {s.url ? <a href={s.url}>{s.label}</a> : s.label}
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="nx-nav codex-measure" aria-label={`Other topics in ${bookName}`} data-book-skip>
      {prev && <a href={`/numina/${bookSlug}/${prev.id}`}>← {prev.data.title}</a>}
      <a class="nx-up" href={`/numina/${bookSlug}`}>Contents of {bookName}</a>
      {next && <a href={`/numina/${bookSlug}/${next.id}`}>{next.data.title} →</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .nx-trail a { color: inherit; }
  .nx-draft {
    margin-left: 0.5rem;
    padding: 0.1em 0.5em;
    border: var(--rule) solid var(--oxblood-text);
    border-radius: 999px;
    color: var(--oxblood-text);
  }
  .nx-n {
    font-size: var(--t-sm);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.9rem;
  }
  .nx-title { font-size: clamp(var(--t-2xl), 5vw, 4rem); line-height: 1.04; margin: 0 auto 0.4rem; }
  .nx-summary {
    font-size: var(--t-md);
    font-style: italic;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 58ch;
    margin: 0 auto;
  }
  .nx-read { margin: 1.6rem 0 0; }

  .nx-figure { margin: 0 auto 2.2rem; max-width: var(--measure); }
  .nx-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule) solid color-mix(in srgb, var(--brass) 35%, transparent);
    border-radius: 3px;
  }
  .nx-credit {
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }

  .nx-body { font-size: var(--body-size); line-height: var(--body-leading); }
  /* A tall plate (a statuette, an amulet) shown at full measure fills more
     than a screen; at this width it still reads, and the caption keeps the
     full line. Opt in with <figure class="is-portrait">. */
  .nx-body :global(figure.is-portrait img) { max-width: 22rem; margin-inline: auto; }
  .nx-body :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    font-size: var(--t-sm);
    line-height: 1.8;
  }
  .nx-body :global(.footnotes ol) { list-style: decimal; }
  .nx-body :global(.footnotes li + li) { margin-top: 0.9em; }
  .nx-body :global(#footnote-label) {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
    overflow: visible;
    white-space: normal;
    margin: 0 0 0.8rem;
    font-size: var(--t-md);
  }

  .nx-sources { margin: 2.6rem auto 0; }
  .nx-h2 {
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--t-lg);
    font-weight: 500;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.2em;
    margin: 0 0 0.8rem;
  }
  .nx-source-list { margin: 0; padding-left: 1.1rem; font-size: var(--t-sm); line-height: 1.8; color: var(--ink-soft); }

  .nx-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin: 2.6rem auto 0;
    padding-top: 1rem;
    border-top: 0.5px solid color-mix(in srgb, var(--brass) 45%, transparent);
    font-size: var(--t-sm);
    letter-spacing: 0.06em;
  }
  .nx-up { color: var(--ink-soft); }
</style>
