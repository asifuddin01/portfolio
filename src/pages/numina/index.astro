---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlackHole from '../../components/numina/BlackHole.astro';
import { getNumina } from '../../lib/collections';
import BookCover from '../../components/book/BookCover.astro';
import { toRoman, AUTHOR } from '../../consts';

/**
 * Numina — the mythology section.
 *
 * Latin for the divine presences: the powers felt in a doorway, a river, a
 * boundary stone. Chosen over Fabulae, which translates "myths" better but
 * sits one letter from Tabulae in the nav, and over anything Greek or Roman,
 * which would have put ten traditions under an eleventh's vocabulary.
 *
 * Eleven books, each with chapters, each chapter holding topics. Laid out as a
 * shelf rather than a grid of cards for the same reason Elementa is: a card
 * says "pick one of these", and a numbered spine says "this is a work with
 * parts, and it is not finished".
 */
const books = await getNumina();

/**
 * Every number on this page is counted from the content, never typed.
 *
 * Adding a book, a chapter or a topic changes these on the next build with
 * nothing to remember — which is the only way a count on a page that fills up
 * over time stays true. The editor's hint for the prose below says not to
 * write a number into it for the same reason.
 */
const topics = books.reduce((n, b) => n + b.topics, 0);
const chapters = books.reduce((n, b) => n + b.chapters.length, 0);

/**
 * The heading and the prose come from /admin. Paragraphs are split on blank
 * lines rather than rendered as one block, so a second paragraph typed in the
 * editor arrives as a second paragraph rather than as a run-on.
 */
const meta = await getEntry('site', 'numina');
const paragraphs = (meta?.data.lede ?? '').split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
---
<BaseLayout
  title="Numina — Md. Asif Uddin"
  description="Eleven books of mythology — Mesopotamian, Egyptian, Hindu, Chinese, Greek, Roman, Mesoamerican, Celtic, Japanese, Norse and Aztec — read as literature and as evidence."
  folio="N"
  book="numina"
>
  <div class="codex nu">
    {/* The opening: the frontispiece on the left, facing the title page, with
        the board closed over it on a first visit. */}
    <section class="sheet sheet--spread nu-open" aria-labelledby="nu-title">
      <BookCover book="numina" title={meta?.data.title ?? 'Numina'} subtitle={meta?.data.kicker} author={AUTHOR} />
      <div class="spread-verso nu-frontis book-frontis">
        <BlackHole />
      </div>
      <header class="spread-recto book-title-page nu-head">
        {meta?.data.kicker && <p class="tp-kicker" data-reveal>{meta.data.kicker}</p>}
        <h1 class="tp-title" id="nu-title" data-press>{meta?.data.title ?? 'Numina'}</h1>
        <span class="book-orn" aria-hidden="true"></span>
        {paragraphs.map((text) => (
          <p class="tp-lede" data-reveal>{text}</p>
        ))}
        <p class="tp-imprint" data-reveal>
          <span class="tp-author">{AUTHOR}</span>
          <span>{books.length} books · {chapters} chapters · {topics} {topics === 1 ? 'topic' : 'topics'} written</span>
          <span class="tp-place">Dhaka · {toRoman(new Date().getFullYear())}</span>
        </p>
      </header>
    </section>

    <section class="sheet nu-contents" data-folio="vii" aria-labelledby="nu-toc-h">
      <h2 class="book-toc-h" id="nu-toc-h">Contents</h2>
      <span class="book-orn" aria-hidden="true"></span>
      <ol class="nu-shelf">
        {books.map((b, i) => (
          <li class="nu-book">
            <a class="nu-link" href={`/numina/${b.slug}`}>
              <span class="nu-n">Book {toRoman(i + 1)}</span>
              <span class="nu-row toc-leader">
                <span class="nu-t">{b.entry.data.name}</span>
                <span class="toc-end nu-count">
                  {b.chapters.length} {b.chapters.length === 1 ? 'chapter' : 'chapters'}
                  {b.topics > 0 && <em> · {b.topics} written</em>}
                </span>
              </span>
              <span class="nu-c">{b.entry.data.region} · {b.entry.data.span}</span>
              <span class="nu-goal">{b.entry.data.gloss}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>

  .nu-shelf {
    list-style: none;
    margin: clamp(1.6rem, 4vh, 2.6rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 clamp(2.5rem, 6vw, 6rem);
  }
  @media (min-width: 64rem) {
    .nu-shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .nu-book { break-inside: avoid; }
  .nu-link {
    display: grid;
    gap: 0.15rem;
    padding: 1.05rem 0 1.2rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 0.5px solid color-mix(in srgb, var(--brass) 30%, transparent);
  }
  .nu-n {
    font-size: var(--t-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .nu-t { font-family: var(--font-display); font-size: var(--t-lg); line-height: 1.2; }
  .nu-link:hover .nu-t { color: var(--fundus); }
  .nu-count {
    font-size: var(--t-sm);
    font-variant-numeric: oldstyle-nums;
    color: var(--ink-soft);
  }
  .nu-count em { font-style: normal; color: var(--brass-text); }
  .nu-c { font-style: italic; font-size: var(--t-base); color: var(--ink-soft); }
  .nu-goal { font-size: var(--t-base); color: var(--ink-soft); line-height: 1.55; max-width: 60ch; }

  @media (max-width: 40rem) {
    .nu-row { flex-wrap: wrap; }
  }
</style>
