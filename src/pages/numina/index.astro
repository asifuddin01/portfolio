---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import BlackHole from '../../components/numina/BlackHole.astro';
import { getNumina } from '../../lib/collections';
import { toRoman } from '../../consts';

/**
 * Numina — the mythology section.
 *
 * Latin for the divine presences: the powers felt in a doorway, a river, a
 * boundary stone. Chosen over Fabulae, which translates "myths" better but
 * sits one letter from Tabulae in the nav, and over anything Greek or Roman,
 * which would have put ten traditions under an eleventh's vocabulary.
 *
 * Eleven books, each with chapters, each chapter holding topics. Laid out as a
 * shelf rather than a grid of cards for the same reason Elementa is: a card
 * says "pick one of these", and a numbered spine says "this is a work with
 * parts, and it is not finished".
 */
const books = await getNumina();

/**
 * Every number on this page is counted from the content, never typed.
 *
 * Adding a book, a chapter or a topic changes these on the next build with
 * nothing to remember — which is the only way a count on a page that fills up
 * over time stays true. The editor's hint for the prose below says not to
 * write a number into it for the same reason.
 */
const topics = books.reduce((n, b) => n + b.topics, 0);
const chapters = books.reduce((n, b) => n + b.chapters.length, 0);

/**
 * The heading and the prose come from /admin. Paragraphs are split on blank
 * lines rather than rendered as one block, so a second paragraph typed in the
 * editor arrives as a second paragraph rather than as a run-on.
 */
const meta = await getEntry('site', 'numina');
const paragraphs = (meta?.data.lede ?? '').split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
---
<BaseLayout
  title="Numina — Md. Asif Uddin"
  description="Eleven books of mythology — Mesopotamian, Egyptian, Hindu, Chinese, Greek, Roman, Mesoamerican, Celtic, Japanese, Norse and Aztec — read as literature and as evidence."
  folio="N"
>
  <div class="codex nu">
    <div class="nu-hero">
      <header class="nu-head">
        {meta?.data.kicker && <p class="nu-kicker" data-reveal>{meta.data.kicker}</p>}
        <h1 class="nu-h1" data-press>{meta?.data.title ?? 'Numina'}</h1>
        {paragraphs.map((text) => (
          <p class="nu-lede" data-reveal>{text}</p>
        ))}
        <p class="nu-sub" data-reveal>
          {books.length} books · {chapters} chapters · {topics} {topics === 1 ? 'topic' : 'topics'} written
        </p>
      </header>

      <BlackHole />
    </div>

    <LesionRule />

    <ol class="nu-shelf">
      {books.map((b, i) => (
        <li class="nu-book">
          <a class="nu-link" href={`/numina/${b.slug}`}>
            <span class="nu-n">Book {toRoman(i + 1)}</span>
            <span class="nu-body">
              <span class="nu-t">{b.entry.data.name}</span>
              <span class="nu-c">{b.entry.data.region} · {b.entry.data.span}</span>
              <span class="nu-goal">{b.entry.data.gloss}</span>
            </span>
            <span class="nu-count">
              {b.chapters.length} {b.chapters.length === 1 ? 'chapter' : 'chapters'}
              <em>{b.topics === 0 ? 'nothing written yet' : `${b.topics} ${b.topics === 1 ? 'topic' : 'topics'}`}</em>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .nu { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .nu-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(23rem, 1.18fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: clamp(28rem, 58vh, 38rem);
  }
  .nu-head { min-width: 0; max-width: 35rem; }
  .nu-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .nu-h1 { font-size: var(--t-2xl); margin-bottom: 1.2rem; }
  .nu-lede {
    max-width: 55ch;
    font-size: var(--body-size);
    line-height: var(--body-leading);
    margin-bottom: 1em;
  }
  .nu-sub {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin: 0.8rem 0 0;
  }

  .nu-shelf { list-style: none; margin: 1.4rem 0 2rem; padding: 0; }
  .nu-book { border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent); }
  .nu-link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: baseline;
    padding: 1.4rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .nu-n {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .nu-body { display: block; }
  .nu-t { display: block; font-family: var(--font-display); font-size: var(--t-lg); line-height: 1.2; }
  .nu-link:hover .nu-t { color: var(--fundus); }
  .nu-c {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }
  .nu-goal {
    display: block;
    font-size: var(--t-base);
    color: var(--ink-soft);
    line-height: 1.55;
    margin-top: 0.45rem;
    max-width: 52ch;
  }
  .nu-count {
    display: block;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .nu-count em { display: block; font-style: normal; color: var(--brass-text); margin-top: 0.25rem; }

  @media (max-width: 56rem) {
    .nu-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.2rem, 7vw, 3.8rem);
      min-height: 0;
    }
    .nu-head { max-width: 38rem; }
  }

  @media (max-width: 40rem) {
    .nu-link { grid-template-columns: minmax(0, 1fr); gap: 0.35rem; padding: 1.1rem 0; }
    .nu-count { text-align: left; margin-top: 0.4rem; }
  }
</style>
