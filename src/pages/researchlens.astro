---
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import { AUTHOR } from '../consts';
import { getLibrary, getPropositionContexts } from '../lib/collections';
import { RESEARCHLENS } from '../lib/facts.mjs';

/**
 * ResearchLens — the public exhibit.
 *
 * The page is prerendered like the rest of the site; only the question box
 * talks to anything. The endpoint is read from an environment variable so the
 * static build carries no hard-coded host, and a deployment can point at a
 * local container, a staging box or the public API without a code change.
 *
 * When nothing is reachable the page says so plainly, and gives the local
 * instructions — but in the answer panel, at the moment a reader asks, rather
 * than in a standing notice above a question box they have not used yet. A
 * demo that fails silently is worse than one that explains itself; one that
 * announces failure before anybody has asked is worse than both.
 */
/**
 * Where to look for a running instance.
 *
 * The page is static and served over HTTPS; the system it talks to usually
 * runs on the reader's own machine. So rather than bake in one host, the page
 * probes a short list at load and uses whichever answers.
 *
 * That makes the demo work for anyone running `docker compose up` with no
 * hosting at all, and it degrades honestly for everyone else — a question box
 * that cannot answer is worse than none. Browsers exempt http://localhost from
 * mixed-content blocking, which is what makes this possible from an HTTPS page.
 */
/**
 * A public instance, called rather than embedded.
 *
 * It was an iframe first, because a Space is served as one and that sidesteps
 * the thing that broke the earlier design: browsers refuse to let a page on
 * the public web open a connection to a server on the visitor's own machine,
 * so the probe below only ever succeeds for a reader running the container
 * *and* opening this page locally.
 *
 * But an embedded Space brings Gradio's entire visual language into the middle
 * of this page, and a reader then meets two designs at once — this one, and a
 * different one inside a box in it. So the Space exposes `ask_json` beside its
 * own UI and this page draws the answer the way it draws everything else.
 * Cross-origin calls are permitted: the Space answers a preflight from
 * https://asifuddin.com with that exact origin.
 *
 * Set to '' until the Space exists. With no Space and no local instance the
 * first question falls through to the answer panel's own "nothing is
 * answering" message, which is where the reader is already looking.
 */
const SPACE = import.meta.env.PUBLIC_RESEARCHLENS_SPACE ?? '';

const API_CANDIDATES = [
  import.meta.env.PUBLIC_RESEARCHLENS_API,
  'http://localhost:8000',
  'http://localhost:8001',
].filter(Boolean);

/* The corpus the public instance is indexed over. Public papers only: the
   embargoed plates never go near a retrieval index.
   Two fields rather than one, on purpose — a query has to discriminate across
   domains, not merely within one, which is a harder and more honest test. */
const CORPUS = {
  /* Read, not written. These said 101 and 9,540 while the findings section
     below said 9,593, because a number typed into a page has nothing checking
     it. `npm run facts` measures them from the running instance; see
     src/lib/facts.ts. */
  papers: RESEARCHLENS.papers,
  passages: RESEARCHLENS.passages,
  field:
    'vision-language models, retrieval-augmented generation and federated ' +
    'learning on one side, single-cell genomics and causal discovery on the other',
};

/**
 * The corpus is no longer the only thing it reads.
 *
 * Counted here rather than written down, because a number typed into a page is
 * a number that goes stale the next time the thing it counts changes — which
 * is exactly what happened to the passage count above.
 */
const PROPOSITIONS = (await getPropositionContexts()).length;

/**
 * Papers added since the bundle was built.
 *
 * The corpus above is fixed at deploy time; these are the ones uploaded
 * through /admin, which the retrieval system fetches and indexes at run time.
 * Not added to the count above, and that was a bug for exactly one afternoon.
 * `CORPUS` is now measured from the running instance, which indexes the
 * library — so the total already includes these, and adding them again would
 * report 105 papers for a corpus of 103. It read as correct only while the
 * measurement predated the library existing.
 *
 * What it is still for: the sentence below, which says the last papers in the
 * list arrived after the index was built and are searchable anyway. That is a
 * fact about the library specifically, and the site is what knows it.
 */
const ADDED = (await getLibrary()).length;

/* Two from each half of the corpus. A question that can only be answered from
   one domain is the useful case to show: it demonstrates that retrieval is
   discriminating, not just returning whatever is topically nearby. */
const EXAMPLES = [
  'How does retrieval-augmented generation reduce hallucination?',
  // Nobody guesses that a literature tool will answer this, so one of the
  // four says it outright. The site is a source like any other here — the
  // answer arrives cited, and the citation is a page anyone can open.
  'What research does the author do, and what is he working on now?',
  // Limitations get a slot because nobody thinks to ask for them, and they
  // are the part of a paper a reader is least likely to reach on their own.
  'What limitations do the authors state for retrieval-augmented generation?',
  'How do vision-language models align image and text representations?',
];

const PIPELINE = [
  { step: 'Parse', detail: 'headings by font geometry; sections and page spans, not flat text' },
  { step: 'Chunk', detail: 'passages that never cross a section, and can cite themselves' },
  { step: 'Retrieve', detail: 'BM25 and dense, fused by rank rather than by score' },
  { step: 'Rerank', detail: 'a cross-encoder that sees query and passage together' },
  { step: 'Reach out', detail: 'arXiv, PubMed and OpenAlex when the question asks what is current' },
  { step: 'Read this site', detail: 'when the question is about me, fetched fresh so it cannot go stale' },
  { step: 'Read the Elementa', detail: 'my own textbook, so a question about the mechanism can be answered from it' },
  { step: 'Concede', detail: 'on a question about limits, the passages where authors state their own' },
  { step: 'Answer', detail: 'markers resolved against the evidence, or a refusal' },
  { step: 'Add', detail: 'your own PDFs, indexed for your session and nobody else’s' },
];

/* The rules that decide whether an answer is shown at all. Each is enforced in
   code rather than asked of the model, because a 3B model will agree to cite
   its sources and then not. */
const GUARANTEES = [
  {
    rule: 'No evidence, no call',
    why: 'A model asked a question with no context answers from its training, fluently. A reader cannot tell that from a grounded answer, so the model is never invoked.',
  },
  {
    rule: 'Citations are checked, not trusted',
    why: 'A marker pointing at a passage that was never retrieved is deleted after generation. An invented [7] does not reach the page.',
  },
  {
    rule: 'Unsupported becomes refusal',
    why: 'An answer left with no surviving citation is replaced by a refusal. A fluent unsourced paragraph is worse than none.',
  },
  {
    rule: 'One paper cannot fill the context',
    why: 'Passages per paper are capped. Otherwise a synthesis and a paraphrase of one document look identical, because both arrive with citations.',
  },
  {
    rule: 'Your papers stay yours',
    why: 'A paper you add is indexed for your session alone — held in memory, never written to disk, never merged into the shared corpus. The demo is one process serving everyone, so a global index would put a stranger\u2019s manuscript in someone else\u2019s answers, with a citation.',
  },
  {
    rule: 'Live evidence is labelled',
    why: 'An abstract fetched from arXiv, PubMed or OpenAlex supports what a paper claims, not what it measured. It is marked, dated, and never given a page number.',
  },
];

/* Findings that changed the build. Every one came from running the thing on
   real papers; none would have been found by reading the code. */
const FINDINGS = [
  {
    n: '19 → 0',
    what: 'papers with broken titles, twice',
    detail: 'The first fix walked size tiers downward, because the largest glyph on page one is often a drop cap and titles extracted as “M”, “w”, “1 3”. That claim was premature: an audit later found nineteen still wrong for three other reasons. Small-caps titles lost every word’s first letter — “N MAGE IS ORTH X ORDS” — because a capital and its small caps share a baseline, not a top. arXiv’s sideways margin stamp scattered into seven titles. And Elsevier sets its own masthead half a point larger than the paper’s title.',
  },
  {
    n: '77%',
    what: 'of passages changed by that fix',
    detail: 'Grouping lines by baseline rather than by top was meant to repair titles. It repaired the body too: columns had been interleaving mid-sentence, rotated axis labels landed in paragraphs, and subscripts were flung to the end of the line. Fewer passages now — 9,870 to 9,593 — because there is less rubbish to cut up.',
  },
  {
    n: '2×',
    what: 'faster embedding, from one number',
    detail: 'Batches of 32 embed 43 passages in 6.7s; batches of 64 take 11.2s. A batch is padded to its longest member, and past about thirty the odds of catching a 512-token passage approach one, so the whole batch pays for it. The vectors agree to seven decimal places.',
  },
  {
    n: '111s → 855ms',
    what: 'retrieval latency',
    detail: 'CoreML is 2.6× faster for the bi-encoder and 24× slower for the cross-encoder, which splits into 39 partitions and thrashes. A provider is a property of the model, not the machine.',
  },
  {
    n: '45 → 3',
    what: 'line-break hyphens per paper',
    detail: '“expres- sion” matches nothing. Whether to rejoin is decided against the document’s own vocabulary, so “single- cell” keeps its hyphen and “con- trol” does not.',
  },
  {
    n: '13% → 70%',
    what: 'passages in a named section',
    detail: 'Sections were flat, so “3.2 Training details” lost its parent. Font size already encoded the hierarchy and was being discarded.',
  },
];
---
<BaseLayout
  title="ResearchLens — evidence-grounded literature retrieval"
  description="An open-source research assistant that answers questions about scientific papers and traces every claim back to the passage, section and page it came from."
  folio="RL"
>
  <div class="codex rl">

    <header class="rl-head" data-reveal>
      <p class="rl-eyebrow">Instrumentum · open source</p>
      <h1 class="rl-title">ResearchLens</h1>
      <p class="rl-lede">
        A research assistant that reads papers and shows its working. Ask it
        something — or hand it your own PDF — and every claim comes back bound
        to the passage it came from. When nothing supports an answer it says
        so, which is the harder half. It will also answer questions about me:
        it reads this site, so it knows what I am working on as of the last
        time I changed anything here.
      </p>
      <p class="rl-sub" id="rl-stats">
        {CORPUS.papers} papers · {CORPUS.passages.toLocaleString('en')} passages —
        {' '}{CORPUS.field}.
      </p>
      <p class="rl-sub rl-sub-2">
        It also reads this site and the {PROPOSITIONS} propositions of the
        Elementa, so a question about me, or about a mechanism I have written
        up, is answered from those and cited to them.
        {ADDED > 0 && (
          <>
            {' '}The last {ADDED === 1 ? 'paper' : `${ADDED} papers`} in the
            list below {ADDED === 1 ? 'was' : 'were'} added after the index was
            built, and {ADDED === 1 ? 'is' : 'are'} searchable anyway: the
            system fetches and indexes new papers at run time rather than
            being retrained on them.
          </>
        )}
      </p>
    </header>

    <section class="rl-ask" id="rl-ask" data-reveal data-space={SPACE}>
      <h2 class="rl-h2">Ask it something</h2>
      <script type="application/json" id="rl-endpoints" set:html={JSON.stringify(API_CANDIDATES)} is:inline />

      <form class="rl-form" id="rl-form">
        <label class="rl-label" for="rl-q">Your question</label>
        <div class="rl-row">
          <input
            class="rl-input"
            id="rl-q"
            name="q"
            type="text"
            autocomplete="off"
            placeholder="What does the literature say about…"
            required
          />
          <button class="rl-send" type="submit">Ask</button>
        </div>

        {/* Not a model switch — a scope switch. The model is the same either
            way; what changes is where the evidence is allowed to come from,
            which is the choice that actually alters an answer. */}
        <fieldset class="rl-scope" id="rl-scope">
          <legend class="rl-legend">Search</legend>
          <label class="rl-radio">
            <input type="radio" name="scope" value="local" checked />
            <span>Local · <em>the {CORPUS.papers} indexed papers</em></span>
          </label>
          <label class="rl-radio">
            <input type="radio" name="scope" value="global" />
            <span>Global · <em>also arXiv, PubMed and OpenAlex</em></span>
          </label>
        </fieldset>

        <div class="rl-papers">
          <label class="rl-file">
            <input type="file" id="rl-file" accept="application/pdf,.pdf" multiple />
            <span>Add your own PDFs</span>
          </label>
          {/* Indexing a 42-page paper took 58 seconds on the hosted demo,
              during which the only feedback was one line of text that never
              changed. That is indistinguishable from broken, and it is why
              this exists. The upload half is a real percentage from the
              browser's own progress events; the reading half cannot be, so it
              says what it is doing and how long it has been doing it rather
              than inventing a number. */}
          <div class="rl-prog" id="rl-prog" hidden>
            <div class="rl-prog-head">
              <span class="rl-prog-stage" id="rl-prog-stage">Uploading</span>
              <span class="rl-prog-of" id="rl-prog-of"></span>
              <span class="rl-prog-time" id="rl-prog-time"></span>
            </div>
            <div class="rl-prog-track">
              <div class="rl-prog-bar" id="rl-prog-bar"></div>
            </div>
            <p class="rl-prog-file" id="rl-prog-file"></p>
          </div>
          <p class="rl-file-note" id="rl-file-note">
            Parsed and indexed for your session only — never written to disk,
            never added to the public corpus, dropped after an hour idle.
          </p>
          <ul class="rl-mine" id="rl-mine" hidden></ul>
        </div>

        <p class="rl-hint" id="rl-hint">
          Local answers only from the indexed corpus, which is fixed and cannot
          say what a field is doing now. Global also searches the live
          literature; those results are abstracts, not full text, and are
          marked as such. A question about me is answered from this site under
          either setting — it is not a literature, so the switch does not apply
          to it — and those passages are marked <em>site</em>, because what a
          person writes about their own work is not a reviewed finding.
        </p>
        <fieldset class="rl-models" id="rl-models" hidden>
          <legend class="rl-legend">Answer with</legend>
        </fieldset>
      </form>

      <ul class="rl-examples" data-reveal-stagger>
        {EXAMPLES.map((q) => (
          <li><button class="rl-example" type="button" data-q={q} disabled>{q}</button></li>
        ))}
      </ul>

      <div class="rl-answer" id="rl-answer" hidden aria-live="polite"></div>
    </section>

    <LesionRule />

    <section class="rl-how" data-reveal>
      <h2 class="rl-h2">How it answers</h2>
      <p class="rl-note codex-measure">
        Every part of the retrieval stack had to justify itself with a measured
        number before it was kept. What follows is what survived.
      </p>
      <ol class="rl-pipe">
        {PIPELINE.map((p, i) => (
          <li class="rl-pipe-item">
            {/* The trailing spaces are for the search index, not the eye.
                Astro strips whitespace between sibling elements, so the three
                ran together into the index as one word — "04Reranka
                cross-encoder" — and showed that way in search excerpts. A
                space inside the span renders as nothing at the end of a grid
                cell and gives the indexer the word boundary it needs. */}
            <span class="rl-pipe-n">{`${String(i + 1).padStart(2, '0')} `}</span>
            <span class="rl-pipe-step">{`${p.step} `}</span>
            <span class="rl-pipe-detail">{p.detail}</span>
          </li>
        ))}
      </ol>
      <p class="rl-note codex-measure">
        A PDF is not a string. Headings are found by font geometry, so a passage
        knows which section it came from and which page it was printed on —
        which is what lets a citation name a place rather than gesture at a
        document.
      </p>
      <p class="rl-note codex-measure">
        A fixed corpus cannot say what a field is doing <em>now</em>, and
        answering as though it could is the failure that looks most like
        success — asked for current trends in large language models, an earlier
        version answered from <em>Attention Is All You Need</em> (2017) and
        BERT (2018), with real citations and no sign its evidence was eight
        years old.
      </p>
      <p class="rl-note codex-measure">
        The first fix was to detect thin coverage from the retrieval scores,
        and it does not work. A question the corpus cannot answer at all —
        gaps in automated renal CT reporting — scored a cosine of 0.829, above
        questions it answers well; a good encoder returns high similarity for
        topically adjacent text whether or not the answer is present, which is
        the property that makes it a good retriever and a useless coverage
        detector. The reliable signal was the question's own wording.
        <em> What is current</em> is a question about a field, not about these
        papers, and is worth two seconds of live search whatever the corpus
        happens to hold.
      </p>
      <p class="rl-note codex-measure">
        arXiv is preprints, mostly machine learning and physics; PubMed is the
        life sciences. Between them they miss the engineering and
        computer-science <em>journal</em> literature almost entirely, so
        OpenAlex is searched too — which is also why there is no IEEE Xplore
        here. Xplore's own API needs an institutional key and so cannot be a
        default, but its records are in OpenAlex, and the coverage arrives
        without the key. What does not arrive is full text: live results are
        marked as abstracts, dated, and never shown with a page number, because
        an abstract supports what a paper claims and not what it measured.
      </p>
      <p class="rl-note codex-measure">
        A paper you attach goes through the same parser, chunker and encoder as
        the hundred and one — into an index belonging to your browser session
        and nothing else. It is never written to disk and never joins the
        shared corpus; that is a correctness requirement rather than a
        courtesy, because the demo is a single process serving every visitor
        and a global index would quote a stranger's manuscript back at someone
        who never uploaded it, indistinguishable from a paper that belongs
        there. Your passages then get guaranteed room in the evidence: someone
        who hands over a paper is asking about <em>that paper</em>, and the
        cross-encoder ranks a corpus passage above it more often than not.
      </p>
      <p class="rl-note codex-measure">
        The two retrievers fail differently. A dense encoder maps
        <em> Dice 0.91</em> and <em>scGPT</em> into neighbourhoods of things
        that mean something similar, which for a metric value or a model name is
        exactly wrong. BM25 matches them literally and is helpless at paraphrase.
        Fusing them by rank rather than score means no normalisation has to be
        tuned per corpus.
      </p>
    </section>

    <LesionRule />

    <section class="rl-rules" data-reveal>
      <h2 class="rl-h2">What it will not do</h2>
      <p class="rl-note codex-measure">
        Grounding is not a line in the prompt. A 3B model will agree to cite its
        sources and then not, so each of these is enforced in code, after
        generation, where the model has no say.
      </p>
      <dl class="rl-rulelist" data-reveal-stagger>
        {GUARANTEES.map((g) => (
          <div class="rl-rule">
            <dt class="rl-rule-t">{g.rule}</dt>
            <dd class="rl-rule-d">{g.why}</dd>
          </div>
        ))}
      </dl>
    </section>

    <LesionRule />

    <section class="rl-findings" data-reveal>
      <h2 class="rl-h2">Found by running it</h2>
      <p class="rl-note codex-measure">
        A corpus of a hundred real papers breaks a parser in ways no test
        anticipates. Each of these was a silent fault — nothing raised, the
        output merely got quietly worse.
      </p>
      <ol class="rl-finds" data-reveal-stagger>
        {FINDINGS.map((f) => (
          <li class="rl-find">
            <p class="rl-find-n">{f.n}</p>
            <p class="rl-find-w">{f.what}</p>
            <p class="rl-find-d">{f.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <LesionRule />

    <section class="rl-measured" data-reveal>
      <h2 class="rl-h2">What is measured</h2>
      <p class="rl-note codex-measure">
        Sixty questions over the corpus, each hand-labelled with the passages
        that genuinely answer it. Written before the retrieval code, against a
        deliberately weak baseline, so every component added afterwards arrives
        with a delta rather than an intuition. If a model wrote the questions and
        a model judged the answers, the table would measure a model's agreement
        with itself.
      </p>
      <p class="rl-pending">
        The ablation is still being labelled. It will report Recall@5, MRR and
        nDCG@10 across four configurations — dense only, BM25 only, hybrid, and
        hybrid with reranking — emitted by the harness rather than written by
        hand, so the published numbers cannot drift from the code.
      </p>
      <p class="rl-note codex-measure">
        Reranking may turn out not to help on a corpus this size. If so, that row
        goes in unchanged: it is the only result here that could be surprising.
      </p>
    </section>

    <LesionRule />

    <section class="rl-links" data-reveal>
      <a class="rl-cta" href="https://github.com/asifuddin01/researchlens">
        Source on GitHub <span aria-hidden="true">→</span>
      </a>
      <p class="rl-colophon">Built by {AUTHOR}. MIT licensed. Runs with no API key.</p>
    </section>

  </div>
</BaseLayout>

<script>
  /**
   * Find a running instance, then wire the question box to it.
   *
   * The page is prerendered; this is the only part that talks to anything.
   * It probes the candidate hosts in order and uses the first that answers
   * /health, which is also where the corpus size and available models come
   * from — so the page never states a figure the running system disagrees with.
   */
  const CANDIDATES: string[] = JSON.parse(
    document.getElementById('rl-endpoints')?.textContent ?? '[]'
  );
  const SPACE_URL: string =
    document.getElementById('rl-ask')?.dataset.space ?? '';

  const form = document.getElementById('rl-form') as HTMLFormElement | null;
  const models = document.getElementById('rl-models');
  const out = document.getElementById('rl-answer');
  const input = document.getElementById('rl-q') as HTMLInputElement | null;

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
    );

  type Health = {
    status: string;
    papers: number;
    passages: number;
    providers: { name: string; model: string; ready: boolean }[];
  };

  async function findInstance(): Promise<{ api: string; health: Health } | null> {
    for (const api of CANDIDATES) {
      try {
        // Short timeout: an unreachable host should cost a moment, not a wait.
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2500);
        const res = await fetch(`${api}/health`, { signal: controller.signal });
        clearTimeout(timer);
        if (!res.ok) continue;
        const health = (await res.json()) as Health;
        if (health.status === 'ok') return { api, health };
      } catch {
        // Nothing there. Try the next candidate.
      }
    }
    return null;
  }

  /**
   * Call a Gradio endpoint on the Space and return its single result.
   *
   * Gradio's HTTP API is two requests: a POST that queues the call and hands
   * back an event id, then an event stream that carries the result. The
   * stream is read to completion rather than rendered as it arrives, because
   * these endpoints return one final object rather than a growing answer.
   */
  async function callSpace(base: string, name: string, data: unknown[]): Promise<any> {
    const queued = await fetch(`${base}/gradio_api/call/${name}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data }),
    });
    if (!queued.ok) throw new Error(`queue ${queued.status}`);
    const { event_id } = await queued.json();

    const stream = await fetch(`${base}/gradio_api/call/${name}/${event_id}`);
    if (!stream.ok || !stream.body) throw new Error(`stream ${stream.status}`);

    const reader = stream.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    let last: any = null;
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      // Events are separated by a blank line; the payload line starts "data:".
      for (const line of buffer.split('\n')) {
        if (line.startsWith('data:')) {
          try {
            last = JSON.parse(line.slice(5).trim());
          } catch {
            // A partial line — the next read completes it.
          }
        }
      }
      buffer = buffer.slice(buffer.lastIndexOf('\n') + 1);
    }
    if (last === null) throw new Error('the Space returned nothing');
    return Array.isArray(last) ? last[0] : last;
  }

  /**
   * Which instance to ask, resolved once and reused.
   *
   * Resolved on the first question rather than on page load. That keeps the
   * property the site's own audit exists to protect — the page contacts
   * nothing until the reader acts — while dropping the button that used to
   * enforce it, which made a reader ask for permission to use the thing they
   * came for. Asking a question *is* the request.
   */
  type Backend = { api: string; viaSpace: boolean };
  let backend: Backend | null = null;
  let connecting: Promise<Backend> | null = null;

  async function connect(): Promise<Backend> {
    if (backend) return backend;
    if (connecting) return connecting;

    connecting = (async () => {
      // A local instance is the better experience — the reader's own papers,
      // their own model, nothing leaving the machine — so it is tried first.
      const found = await findInstance();
      if (found) {
        backend = { api: found.api, viaSpace: false };
        describe(found.health, false);
        void refreshMine(backend);
        return backend;
      }
      const url = SPACE_URL;
      if (!url) throw new Error('no instance is reachable');
      const stats = await callSpace(url, 'corpus_stats', []);
      backend = { api: url, viaSpace: true };
      describe(
        { status: 'ok', papers: stats.papers, passages: stats.passages, providers: [] },
        true
      );
      // A reload keeps the session id, so the papers it names come back with
      // it rather than appearing to have been lost.
      void refreshMine(backend);
      return backend;
    })();

    try {
      return await connecting;
    } finally {
      connecting = null;
    }
  }

  /** Report what answered, so the page never states a figure it disagrees with. */
  function describe(health: Health, viaSpace: boolean) {
    const stats = document.getElementById('rl-stats');
    if (stats) {
      stats.textContent =
        `${health.papers} papers · ${health.passages.toLocaleString('en')} passages · ` +
        (viaSpace ? 'hosted demo' : 'connected to your own instance');
    }
    if (!viaSpace && models) {
      const ready = health.providers.filter((p) => p.ready);
      const choices = ready.length ? ready : health.providers;
      if (choices.length > 1) {
        models.removeAttribute('hidden');
        models.insertAdjacentHTML(
          'beforeend',
          choices
            .map(
              (p, i) => `
              <label class="rl-radio">
                <input type="radio" name="provider" value="${escape(p.name)}" ${i === 0 ? 'checked' : ''} />
                <span>${p.name === 'local' ? 'Local' : 'Hosted'} · <em>${escape(p.model)}</em></span>
              </label>`
            )
            .join('')
        );
      }
    }
  }

  /**
   * Point the question box at an instance.
   *
   * `viaSpace` chooses which shape of call to make — the local build serves
   * this project's own REST API, the Space serves Gradio's. One form, one
   * rendering, two transports: a second answer panel for the hosted case is
   * the beginning of the second implementation that drifts.
   */
  /**
   * Papers the reader adds, held for their session only.
   *
   * The id is minted by whichever instance answered and carried on every later
   * call. Nothing about it is stored on this page beyond the tab's lifetime,
   * and nothing is written anywhere the reader has not asked for.
   */
  // Kept in sessionStorage, not just in a variable. A reload used to lose the
  // id while the instance still held the papers for another hour, so they had
  // not gone anywhere — the page had simply forgotten how to ask for them,
  // which is indistinguishable from their having vanished.
  const SESSION_KEY = 'researchlens.session';
  let session = (() => {
    try {
      return sessionStorage.getItem(SESSION_KEY) ?? '';
    } catch {
      return '';   // private mode, or storage disabled
    }
  })();

  function rememberSession(id: string) {
    session = id;
    try {
      sessionStorage.setItem(SESSION_KEY, id);
    } catch {
      // Not being able to remember is survivable; the papers last the tab.
    }
  }

  const fileInput = document.getElementById('rl-file') as HTMLInputElement | null;
  const fileNote = document.getElementById('rl-file-note');
  const mineList = document.getElementById('rl-mine');

  /** Draw the reader's papers, so they can see the thing they added is there. */
  function renderMine(papers: { doc_id: string; title: string; pages: number }[]) {
    if (!mineList) return;
    if (!papers.length) {
      mineList.setAttribute('hidden', '');
      mineList.innerHTML = '';
      return;
    }
    mineList.removeAttribute('hidden');
    mineList.innerHTML = papers
      .map(
        (d) => `
        <li>
          <span class="rl-mine-t">${escape(d.title)}</span>
          <span>· ${d.pages} pages ·</span>
          <button type="button" data-similar="${escape(d.doc_id)}">find similar work</button>
        </li>`
      )
      .join('');
  }

  /** Ask the instance what this session still holds. */
  async function refreshMine(where: Backend) {
    if (!session) return;
    try {
      const r = where.viaSpace
        ? await callSpace(where.api, 'my_papers', [session])
        : await (await fetch(`${where.api}/library?session=${encodeURIComponent(session)}`)).json();
      const papers = where.viaSpace
        ? r.papers ?? []
        : (r.papers ?? []).filter((d: any) => d.uploaded);
      renderMine(papers);
    } catch {
      // The list is a convenience; failing to draw it must not break asking.
    }
  }

  async function addPaper(
    where: Backend,
    file: File,
    onProgress?: (fraction: number) => void,
  ): Promise<any> {
    if (!where.viaSpace) {
      const body = new FormData();
      body.append('file', file);
      if (session) body.append('session', session);
      const res = await fetch(`${where.api}/ingest`, { method: 'POST', body });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail ?? String(res.status));
      return data;
    }
    // Gradio takes an upload first and gives back a server-side path, which is
    // then passed to the endpoint like any other argument.
    //
    // XHR rather than fetch, for one reason: `upload.onprogress` reports bytes
    // actually sent. fetch() has no equivalent that is usable here, and a
    // 32MB paper over a slow line is exactly when a reader needs to see that
    // something is happening.
    const path = await new Promise<string>((resolve, reject) => {
      const body = new FormData();
      body.append('files', file);
      const xhr = new XMLHttpRequest();
      xhr.open('POST', `${where.api}/gradio_api/upload`);
      xhr.upload.addEventListener('progress', (e) => {
        if (e.lengthComputable) onProgress?.(e.loaded / e.total);
      });
      xhr.addEventListener('load', () => {
        if (xhr.status !== 200) return reject(new Error(`upload ${xhr.status}`));
        try {
          resolve(JSON.parse(xhr.responseText)[0]);
        } catch {
          reject(new Error('the upload returned something unreadable'));
        }
      });
      xhr.addEventListener('error', () => reject(new Error('the upload failed')));
      xhr.addEventListener('abort', () => reject(new Error('the upload was cancelled')));
      xhr.send(body);
    });
    onProgress?.(1);
    return callSpace(where.api, 'add_paper', [path, session]);
  }

  /**
   * The upload progress bar.
   *
   * Two stages, honest about which is which. Uploading is a real fraction
   * from the browser's own progress events. Reading is not — the Space
   * parses, chunks and embeds behind one call that returns when it is done,
   * and there is no progress to report from inside it. So that stage shows an
   * indeterminate bar and a running clock instead of a number nobody
   * measured. A bar that pretends to know is worse than one that says it
   * does not: this system's whole claim is that it does not make things up.
   */
  const progress = (() => {
    const box = document.getElementById('rl-prog');
    const stage = document.getElementById('rl-prog-stage');
    const ofEl = document.getElementById('rl-prog-of');
    const timeEl = document.getElementById('rl-prog-time');
    const bar = document.getElementById('rl-prog-bar');
    const nameEl = document.getElementById('rl-prog-file');
    let total = 0;
    let startedAt = 0;
    let ticker: ReturnType<typeof setInterval> | undefined;

    const tick = () => {
      if (!timeEl) return;
      const s = Math.round((Date.now() - startedAt) / 1000);
      timeEl.textContent = s >= 1 ? `${s}s` : '';
    };

    return {
      start(files: File[]) {
        total = files.length;
        startedAt = Date.now();
        if (box) box.hidden = false;
        clearInterval(ticker);
        ticker = setInterval(tick, 1000);
        tick();
      },
      file(i: number, f: File) {
        if (ofEl) ofEl.textContent = total > 1 ? `${i + 1} of ${total}` : '';
        if (nameEl) nameEl.textContent = `${f.name} · ${(f.size / 1e6).toFixed(1)} MB`;
        if (bar) {
          bar.classList.remove('is-reading');
          bar.style.width = '0%';
        }
        if (stage) stage.textContent = 'Uploading';
      },
      uploading(fraction: number) {
        if (stage) stage.textContent = 'Uploading';
        if (bar) {
          bar.classList.remove('is-reading');
          bar.style.width = `${Math.round(fraction * 100)}%`;
        }
      },
      reading() {
        // Sent, and now being read. The bar goes indeterminate because the
        // honest answer to "how far along" is that nobody knows — a 42-page
        // paper took 58 seconds on the hosted demo and a short one takes two.
        if (stage) stage.textContent = 'Reading the paper — parsing, chunking, indexing';
        if (bar) {
          bar.style.width = '100%';
          bar.classList.add('is-reading');
        }
      },
      stop() {
        clearInterval(ticker);
        ticker = undefined;
        if (box) box.hidden = true;
        if (bar) {
          bar.classList.remove('is-reading');
          bar.style.width = '0%';
        }
      },
    };
  })();

  fileInput?.addEventListener('change', async () => {
    const files = [...(fileInput.files ?? [])];
    if (!files.length || !fileNote) return;

    progress.start(files);
    let where: Backend;
    try {
      where = await connect();
    } catch {
      progress.stop();
      fileNote.textContent = 'Nothing is answering right now, so there is nowhere to put a paper yet.';
      return;
    }

    const added: string[] = [];
    const failed: string[] = [];
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      progress.file(i, f);
      try {
        const r = await addPaper(where, f, (frac) => progress.uploading(frac));
        progress.reading();
        if (r.error) {
          failed.push(`${f.name}: ${r.error}`);
        } else {
          if (r.session) rememberSession(r.session);
          added.push(`${r.title ?? f.name} (${r.pages ?? '?'} pages)`);
        }
      } catch (err) {
        failed.push(`${f.name}: ${String(err)}`);
      }
    }
    progress.stop();

    fileInput.value = '';
    await refreshMine(where);
    const parts: string[] = [];
    if (added.length) {
      parts.push(
        `Indexed ${escape(added.join('; '))}. Ask about them — your passages get ` +
          `guaranteed room in the evidence.`
      );
    }
    for (const m of failed) parts.push(`\u26a0 ${escape(m)}`);
    parts.push(
      'Held in memory for your session only — never written to disk, never ' +
        'added to the public corpus, dropped after an hour idle.'
    );
    fileNote.innerHTML = parts.join('<br />');
  });

  /**
   * Related work for a paper the reader added.
   *
   * The corpus cannot answer this — it is fixed, and the question is about
   * what else exists — so it goes straight to arXiv, PubMed and OpenAlex.
   * What comes back is abstracts, and is labelled as such: a paper found this
   * way is a lead, not a finding.
   */
  mineList?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('button[data-similar]');
    if (!btn || !out) return;

    const docId = btn.dataset.similar ?? '';
    out.hidden = false;
    out.innerHTML = '<p class="rl-status">Searching arXiv, PubMed and OpenAlex for work like it…</p>';

    let where: Backend;
    try {
      where = await connect();
    } catch {
      out.innerHTML = '<p class="rl-status rl-error">Nothing is answering right now.</p>';
      return;
    }

    try {
      const r = where.viaSpace
        ? await callSpace(where.api, 'find_similar', [session, docId, 9])
        : await (async () => {
            const res = await fetch(`${where.api}/similar`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ session, doc_id: docId }),
            });
            if (!res.ok) throw new Error(String(res.status));
            return res.json();
          })();

      if (r.error) throw new Error(r.error);

      const items = (r.results ?? [])
        .map(
          (x: Record<string, any>) => `
          <li class="rl-cite">
            <span class="rl-cite-n"><span class="rl-live">${escape(x.source ?? 'live')}</span></span>
            <span class="rl-cite-src">${escape(x.title ?? '')}</span>
            <span class="rl-cite-loc">${escape((x.authors ?? []).join(', '))} · ${escape(x.published ?? '')} · abstract</span>
            <blockquote class="rl-quote">${escape(x.abstract ?? '')}</blockquote>
          </li>`
        )
        .join('');

      out.innerHTML = items
        ? `<p class="rl-status">Work related to <em>${escape(r.for_title ?? '')}</em>. ` +
          `These are abstracts from the live literature, not passages from a read paper — ` +
          `a lead rather than a finding.</p>` +
          `<p class="rl-cite-h">Related work</p><ol class="rl-cites">${items}</ol>`
        : `<p class="rl-status">Nothing close enough to be worth showing. That is a real ` +
          `answer for a specific paper — these indexes hold what they hold.</p>`;
    } catch (err) {
      out.innerHTML = `<p class="rl-status rl-error">The search failed (${escape(String(err))}).</p>`;
    }
  });

  for (const b of document.querySelectorAll<HTMLButtonElement>('.rl-example')) {
    b.disabled = false;
    b.addEventListener('click', () => {
      if (input) input.value = b.dataset.q ?? '';
      form?.requestSubmit();
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input?.value?.trim();
    if (!question || !out) return;

    // Local searches the indexed corpus alone; global also reaches arXiv,
    // PubMed and OpenAlex. This is the choice that changes an answer — a fixed
    // corpus cannot say what a field is doing now, and letting it try is the
    // failure that looks most like success.
    const scope =
      form.querySelector<HTMLInputElement>('input[name="scope"]:checked')?.value ?? 'local';
    const live = scope === 'global' ? 'always' : 'never';
    const provider =
      form.querySelector<HTMLInputElement>('input[name="provider"]:checked')?.value ?? 'local';

    out.hidden = false;
    out.innerHTML = '<p class="rl-status">Connecting…</p>';

    let where: Backend;
    try {
      where = await connect();
    } catch {
      out.innerHTML =
        `<p class="rl-status rl-error">Nothing is answering right now. The hosted demo sleeps when idle — asking again usually wakes it — or run it yourself with <code>docker compose up</code> and reload this page.</p>`;
      return;
    }

    out.innerHTML =
      `<p class="rl-status">${
        scope === 'global'
          ? 'Searching the indexed papers and the live literature, then writing an answer.'
          : 'Retrieving evidence, then writing an answer.'
      } ${
        where.viaSpace
          ? 'The demo runs on shared hardware and takes twenty seconds or so.'
          : 'A local model takes a few seconds.'
      }</p>`;

    try {
      const data = where.viaSpace
        ? await callSpace(where.api, 'ask_json', [question, '', [], live, session])
        : await (async () => {
            const res = await fetch(`${where.api}/ask`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                question,
                provider,
                live,
                ...(session ? { session } : {}),
              }),
            });
            if (!res.ok) throw new Error(String(res.status));
            return res.json();
          })();

      if (data.error) throw new Error(data.error);

      const cites = (data.citations ?? [])
        .map((c: Record<string, any>) => {
          // A live result is an abstract from arXiv, PubMed or OpenAlex, not a
          // passage from an indexed paper, and is labelled so a reader is
          // never shown one as though it were the other. The Space says so
          // outright; the local API is read from the chunk id.
          const isLive =
            c.live === true || /^(arxiv|pubmed|openalex):/.test(String(c.chunk_id ?? ''));
          // The author's own site, which is a self-description and not a
          // finding. Badged separately from `live` so the two are never
          // conflated: one is a paper's abstract, the other is a person
          // writing about themselves.
          const isSite =
            c.site === true || /^site:/.test(String(c.chunk_id ?? ''));
          // A proposition from the Elementa. Badged apart from `site` because
          // teaching and self-description are different kinds of claim.
          const isBook =
            c.textbook === true || /^elementa:/.test(String(c.chunk_id ?? ''));
          // "p" belongs in front of a page number and nowhere else. Without
          // this the label read "pabstract" for live results and "pwebsite"
          // for the site.
          const where = String(c.pages ?? '');
          const loc = /^\d/.test(where) ? `p${where}` : where;
          const title = escape(c.doc_title ?? '');
          return `
            <li class="rl-cite">
              <span class="rl-cite-n">[${c.marker}]${
                isLive ? ' <span class="rl-live">live</span>' : ''
              }${isSite ? ' <span class="rl-site">site</span>' : ''
              }${isBook ? ' <span class="rl-book">elementa</span>' : ''
              }${c.yours ? ' <span class="rl-yours">yours</span>' : ''}</span>
              <span class="rl-cite-src">${
                c.url ? `<a class="link" href="${escape(c.url)}">${title}</a>` : title
              }</span>
              <span class="rl-cite-loc">${escape(c.section_heading ?? '')} · ${escape(loc)}</span>
              <blockquote class="rl-quote">${escape(c.quote ?? '')}</blockquote>
            </li>`;
        })
        .join('');

      const liveCount = (data.citations ?? []).filter(
        (c: Record<string, any>) =>
          c.live === true || /^(arxiv|pubmed|openalex):/.test(String(c.chunk_id ?? ''))
      ).length;

      // Says who wrote the answer and what it was written from. When the
      // evidence is the site, that is named outright rather than left for a
      // reader to infer from the citations: an answer about a person, sourced
      // from that person's own page, should say so under itself.
      const aboutAuthor =
        data.about_author === true ||
        (data.citations ?? []).some((c: Record<string, any>) =>
          c.site === true || /^site:/.test(String(c.chunk_id ?? ''))
        );

      const timing =
        `<p class="rl-timing">${escape(data.model ?? '')} · retrieval ${Math.round(data.retrieval_ms)} ms · generation ${Math.round(data.generation_ms)} ms${
          liveCount ? ` · ${liveCount} live` : ''
        }${
          aboutAuthor ? ' · about the author, from asifuddin.com' : ''
        }</p>`;

      // A recency question asked in Local. The corpus is fixed, so the honest
      // answer is that it cannot say — which the model does say, in a clause
      // buried at the end of a paragraph that offers no way out. The server
      // decides this, not a copy of the word list kept here: three copies of
      // that judgement had already drifted apart once inside the engine.
      const stranded = data.asks_current_but_local === true;
      const strandedNote = stranded
        ? `<p class="rl-stranded">This asks what is <em>current</em>, and Local
             answers only from the indexed corpus, which is fixed and cannot
             say what a field is doing now.
             <button class="rl-again" type="button">Ask again with Global</button></p>`
        : '';

      // The writer can be unavailable while retrieval is fine — a spent GPU
      // quota on the hosted demo is the usual reason. The passages are most of
      // what this system is for, so they are shown rather than swallowed by an
      // error, and labelled as what they are: evidence with nothing written
      // over it.
      const head = data.evidence_only
        ? `<p class="rl-status">The hosted demo's free GPU allowance is spent, so nothing wrote an answer. ` +
          `These are the passages retrieval found for your question — the evidence, ` +
          `unsummarised. The allowance refills; running it yourself has none.</p>`
        : `<div class="rl-text">${escape(data.text ?? '')}</div>`;

      out.innerHTML =
        head +
        (cites
          ? `<p class="rl-cite-h">${data.evidence_only ? 'Retrieved passages' : 'Evidence'}</p><ol class="rl-cites">${cites}</ol>`
          : '') +
        strandedNote +
        (data.evidence_only ? '' : timing);

      // Switch the scope and ask the same question again. Wired here rather
      // than inline in the template string because the answer is rebuilt on
      // every question and an inline handler would be re-parsed each time.
      out.querySelector<HTMLButtonElement>('.rl-again')?.addEventListener('click', () => {
        const g = form.querySelector<HTMLInputElement>('input[name="scope"][value="global"]');
        if (g) g.checked = true;
        form.requestSubmit();
      });
    } catch (err) {
      // Pass the real reason through rather than wrapping every failure in one
      // guess. A quota limit and a cold start need different things from the
      // reader — waiting, or coming back later — and telling someone to try
      // again when the answer is "not for another few minutes" wastes their
      // time and makes the system look broken rather than rationed.
      const detail = String(err);
      const quota = /quota|exceeded|rate limit|429/i.test(detail);
      out.innerHTML =
        `<p class="rl-status rl-error">${
          !where.viaSpace
            ? `The instance stopped answering (${escape(detail)}). Check the terminal running it.`
            : quota
              ? 'The hosted demo has used up its free GPU allowance for now — it is a shared, unpaid tier, and the quota refills after a while. Running it yourself has no such limit: <code>docker compose up</code>.'
              : `The demo stopped answering (${escape(detail)}). It sleeps when idle; asking again usually wakes it.`
        }</p>`;
    }
  });

</script>

<style>
  /* minmax(0, 1fr), not the implicit `auto`: an auto column floors at the
     widest child's min-content, and .rl-row's 22rem input basis set that floor
     at 558px. Every section then stretched to 558 inside a 335px phone and the
     page scrolled sideways. A definite column also lets the percentages inside
     resolve against the real width, so the input wraps instead of overflowing. */
  .rl { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.4rem; }

  .rl-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.5rem;
  }
  .rl-title {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.05;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  .rl-lede {
    font-size: var(--t-md);
    line-height: 1.65;
    color: var(--ink);
    max-width: var(--measure);
    margin: 0 0 0.7rem;
  }
  .rl-sub { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); margin: 0; }
  .rl-sub-2 { margin-top: 0.5rem; max-width: var(--measure); line-height: 1.6; }

  .rl-h2 {
    font-family: var(--font-body);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.07em;
    font-size: var(--t-lg);
    margin: 0 0 1rem;
  }

  /* The ask panel is the page's instrument, so it is given a plate of its own:
     a raised ground, a brass rule, and enough room that it reads as the thing
     you came for rather than a form beneath an essay. */
  .rl-ask {
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--brass) 7%, var(--paper-raised)),
        var(--paper-raised)
      );
    border: var(--rule) solid color-mix(in srgb, var(--brass) 52%, transparent);
    padding: clamp(1.2rem, 3.5vw, 2rem);
    display: grid;
    gap: 1rem;
  }
  .rl-ask .rl-h2 { margin-bottom: 0.2rem; }

  /* No max-width here. The heading above and the example cards below both run
     the full width of the panel, so a 46rem cap made the form the one child
     that stopped short and left the box looking ragged down its right edge. */
  .rl-form { display: grid; gap: 0.9rem; }
  .rl-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rl-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .rl-input {
    flex: 1 1 22rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--t-md);
    line-height: 1.5;
    padding: 0.85rem 1rem;
    color: var(--ink);
    background: var(--paper);
    border: var(--rule) solid color-mix(in srgb, var(--brass) 58%, transparent);
    transition: border-color 140ms ease;
  }
  .rl-input::placeholder { color: var(--ink-soft); opacity: 0.75; }
  .rl-input:hover { border-color: var(--brass); }
  .rl-input:focus-visible { outline: 2px solid var(--brass); outline-offset: 1px; }
  .rl-send {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.85rem 1.7rem;
    color: var(--paper);
    background: var(--ink);
    border: var(--rule) solid var(--ink);
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease;
  }
  .rl-send:hover { background: var(--oxblood); border-color: var(--oxblood); }

