---
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import { AUTHOR } from '../consts';

/**
 * ResearchLens — the public exhibit.
 *
 * The page is prerendered like the rest of the site; only the question box
 * talks to anything. The endpoint is read from an environment variable so the
 * static build carries no hard-coded host, and a deployment can point at a
 * local container, a staging box or the public API without a code change.
 *
 * When no endpoint is configured — the state until the demo backend is
 * deployed — the page says so plainly and gives the local instructions instead
 * of presenting a chat box that cannot answer. A demo that fails silently is
 * worse than one that explains itself.
 */
/**
 * Where to look for a running instance.
 *
 * The page is static and served over HTTPS; the system it talks to usually
 * runs on the reader's own machine. So rather than bake in one host, the page
 * probes a short list at load and uses whichever answers.
 *
 * That makes the demo work for anyone running `docker compose up` with no
 * hosting at all, and it degrades honestly for everyone else — a question box
 * that cannot answer is worse than none. Browsers exempt http://localhost from
 * mixed-content blocking, which is what makes this possible from an HTTPS page.
 */
/**
 * A public instance, embedded rather than called.
 *
 * Hugging Face serves a Space in an iframe, which sidesteps the thing that
 * broke the earlier design: browsers refuse to let a page on the public web
 * open a connection to a server on the visitor's own machine, so the probe
 * below only ever succeeds for a reader running the container *and* opening
 * this page locally. An embedded Space works for everyone else.
 *
 * Set to '' until the Space exists; the page then falls back to the offline
 * message, which is what it should say when there is nothing to show.
 */
const SPACE = import.meta.env.PUBLIC_RESEARCHLENS_SPACE ?? '';

const API_CANDIDATES = [
  import.meta.env.PUBLIC_RESEARCHLENS_API,
  'http://localhost:8000',
  'http://localhost:8001',
].filter(Boolean);

/* The corpus the public instance is indexed over. Public papers only: the
   embargoed plates never go near a retrieval index.
   Two fields rather than one, on purpose — a query has to discriminate across
   domains, not merely within one, which is a harder and more honest test. */
const CORPUS = {
  papers: 101,
  passages: 9540,
  field:
    'vision-language models, retrieval-augmented generation and federated ' +
    'learning on one side, single-cell genomics and causal discovery on the other',
};

/* Two from each half of the corpus. A question that can only be answered from
   one domain is the useful case to show: it demonstrates that retrieval is
   discriminating, not just returning whatever is topically nearby. */
const EXAMPLES = [
  'How does retrieval-augmented generation reduce hallucination?',
  'Do deep-learning models outperform linear baselines at predicting perturbation effects?',
  'What approaches exist for privacy-preserving diabetic retinopathy classification?',
  'How do vision-language models align image and text representations?',
];

const PIPELINE = [
  { step: 'Parse', detail: 'sections and page spans, not flat text' },
  { step: 'Chunk', detail: 'passages that never span two sections' },
  { step: 'Retrieve', detail: 'BM25 and dense, fused by reciprocal rank' },
  { step: 'Rerank', detail: 'cross-encoder over the fused candidates' },
  { step: 'Reach out', detail: 'arXiv and PubMed, when the corpus is thin' },
  { step: 'Answer', detail: 'every claim bound to a passage' },
];
---
<BaseLayout
  title="ResearchLens — evidence-grounded literature retrieval"
  description="An open-source research assistant that answers questions about scientific papers and traces every claim back to the passage, section and page it came from."
  folio="RL"
>
  <div class="codex rl">

    <header class="rl-head" data-reveal>
      <p class="rl-eyebrow">Instrumentum · open source</p>
      <h1 class="rl-title">ResearchLens</h1>
      <p class="rl-lede">
        A research assistant that reads papers and shows its working. Every
        claim it makes resolves to a passage — a paper, a section, a page — and
        every part of its retrieval stack had to justify itself with a measured
        number before it was kept.
      </p>
      <p class="rl-sub" id="rl-stats">
        {CORPUS.papers} papers · {CORPUS.passages.toLocaleString('en')} passages —
        {' '}{CORPUS.field}.
      </p>
    </header>

    <LesionRule />

    <section class="rl-ask" data-reveal>
      <h2 class="rl-h2">Ask it something</h2>
      <script type="application/json" id="rl-endpoints" set:html={JSON.stringify(API_CANDIDATES)} is:inline />

      <div class="rl-probe" id="rl-probe">
        <p class="rl-status">Looking for a running instance…</p>
      </div>

      <form class="rl-form" id="rl-form" hidden>
        <label class="rl-label" for="rl-q">Your question</label>
        <div class="rl-row">
          <input
            class="rl-input"
            id="rl-q"
            name="q"
            type="text"
            autocomplete="off"
            placeholder="What does the literature say about…"
            required
          />
          <button class="rl-send" type="submit">Ask</button>
        </div>
        <fieldset class="rl-models" id="rl-models">
          <legend class="rl-legend">Answer with</legend>
        </fieldset>
        <p class="rl-hint">
          Retrieval is identical either way, so switching model changes only the
          writing — the evidence below stays the same. Questions about what is
          current also search arXiv and PubMed, and those results are marked as
          abstracts.
        </p>
      </form>

      {SPACE && (
        <div class="rl-space" id="rl-space" hidden>
          <p class="rl-space-note">
            Running on a fixed corpus with a hosted model. For your own papers,
            on your own machine, with no API key — run it locally and open this
            page from there.
          </p>
          <iframe
            class="rl-frame"
            src={SPACE}
            title="ResearchLens"
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        </div>
      )}

      <div class="rl-offline" id="rl-offline" hidden>
        <p class="rl-offline-h">Not connected</p>
        <p>
          Nothing is answering. The hosted instance is not deployed yet, and
          browsers block a page on the public web from reaching a server on
          your own machine — so running it locally means opening it locally
          too:
        </p>
        <pre class="rl-code"><code>git clone https://github.com/asifuddin01/researchlens
cd researchlens
docker compose up</code></pre>
        <p class="rl-offline-note">
          Then open <code>localhost:8000</code>. Your papers stay on your
          machine, the default model is local, and no API key is needed.
        </p>
      </div>

      <ul class="rl-examples" data-reveal-stagger>
        {EXAMPLES.map((q) => (
          <li><button class="rl-example" type="button" data-q={q} disabled>{q}</button></li>
        ))}
      </ul>

      <div class="rl-answer" id="rl-answer" hidden aria-live="polite"></div>
    </section>

    <LesionRule />

    <section class="rl-how" data-reveal>
      <h2 class="rl-h2">How it answers</h2>
      <ol class="rl-pipe">
        {PIPELINE.map((p, i) => (
          <li class="rl-pipe-item">
            <span class="rl-pipe-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="rl-pipe-step">{p.step}</span>
            <span class="rl-pipe-detail">{p.detail}</span>
          </li>
        ))}
      </ol>
      <p class="rl-note codex-measure">
        A PDF is not a string. Headings are found by font geometry, so a passage
        knows which section it came from and which page it was printed on —
        which is what lets a citation name a place rather than gesture at a
        document.
      </p>
      <p class="rl-note codex-measure">
        A fixed corpus cannot say what a field is doing <em>now</em>, and
        answering as though it could is the failure that looks most like
        success — asked for current trends in large language models, an earlier
        version answered from <em>Attention Is All You Need</em> (2017) and
        BERT (2018), with real citations and no sign its evidence was eight
        years old. So when the corpus holds fewer than four papers on a
        question, arXiv and PubMed are searched for recent work. Those results
        are marked as abstracts, dated, and never shown with a page number,
        because an abstract supports what a paper claims and not what it
        measured.
      </p>
      <p class="rl-note codex-measure">
        The two retrievers fail differently. A dense encoder maps
        <em> Dice 0.91</em> and <em>scGPT</em> into neighbourhoods of things
        that mean something similar, which for a metric value or a model name is
        exactly wrong. BM25 matches them literally and is helpless at paraphrase.
        Fusing them by rank rather than score means no normalisation has to be
        tuned per corpus.
      </p>
    </section>

    <LesionRule />

    <section class="rl-measured" data-reveal>
      <h2 class="rl-h2">What is measured</h2>
      <p class="rl-note codex-measure">
        Sixty questions over the corpus, each hand-labelled with the passages
        that genuinely answer it. Written before the retrieval code, against a
        deliberately weak baseline, so every component added afterwards arrives
        with a delta rather than an intuition. If a model wrote the questions and
        a model judged the answers, the table would measure a model's agreement
        with itself.
      </p>
      <p class="rl-pending">
        The ablation is still being labelled. It will report Recall@5, MRR and
        nDCG@10 across four configurations — dense only, BM25 only, hybrid, and
        hybrid with reranking — emitted by the harness rather than written by
        hand, so the published numbers cannot drift from the code.
      </p>
      <p class="rl-note codex-measure">
        Reranking may turn out not to help on a corpus this size. If so, that row
        goes in unchanged: it is the only result here that could be surprising.
      </p>
    </section>

    <LesionRule />

    <section class="rl-links" data-reveal>
      <a class="rl-cta" href="https://github.com/asifuddin01/researchlens">
        Source on GitHub <span aria-hidden="true">→</span>
      </a>
      <p class="rl-colophon">Built by {AUTHOR}. MIT licensed. Runs with no API key.</p>
    </section>

  </div>
</BaseLayout>

<script>
  /**
   * Find a running instance, then wire the question box to it.
   *
   * The page is prerendered; this is the only part that talks to anything.
   * It probes the candidate hosts in order and uses the first that answers
   * /health, which is also where the corpus size and available models come
   * from — so the page never states a figure the running system disagrees with.
   */
  const CANDIDATES: string[] = JSON.parse(
    document.getElementById('rl-endpoints')?.textContent ?? '[]'
  );

  const probe = document.getElementById('rl-probe');
  const form = document.getElementById('rl-form') as HTMLFormElement | null;
  const offline = document.getElementById('rl-offline');
  const models = document.getElementById('rl-models');
  const out = document.getElementById('rl-answer');
  const input = document.getElementById('rl-q') as HTMLInputElement | null;

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
    );

  type Health = {
    status: string;
    papers: number;
    passages: number;
    providers: { name: string; model: string; ready: boolean }[];
  };

  async function findInstance(): Promise<{ api: string; health: Health } | null> {
    for (const api of CANDIDATES) {
      try {
        // Short timeout: an unreachable host should cost a moment, not a wait.
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2500);
        const res = await fetch(`${api}/health`, { signal: controller.signal });
        clearTimeout(timer);
        if (!res.ok) continue;
        const health = (await res.json()) as Health;
        if (health.status === 'ok') return { api, health };
      } catch {
        // Nothing there. Try the next candidate.
      }
    }
    return null;
  }

  function showFallback() {
    probe?.setAttribute('hidden', '');
    // A local instance is the better experience — the reader's own papers, and
    // a model on their own machine — so it is tried first. The embedded Space
    // is what everyone else gets, and the offline message is for when there is
    // neither.
    const space = document.getElementById('rl-space');
    if (space) space.removeAttribute('hidden');
    else offline?.removeAttribute('hidden');
  }

  function wire(api: string, health: Health) {
    probe?.setAttribute('hidden', '');
    form?.removeAttribute('hidden');

    // Model choices come from the instance, not from the page. An instance
    // with no hosted provider configured must not offer one.
    if (models) {
      const ready = health.providers.filter((p) => p.ready);
      const choices = ready.length ? ready : health.providers;
      models.insertAdjacentHTML(
        'beforeend',
        choices
          .map(
            (p, i) => `
            <label class="rl-radio">
              <input type="radio" name="provider" value="${escape(p.name)}" ${i === 0 ? 'checked' : ''} />
              <span>${p.name === 'local' ? 'Local' : 'Hosted'} · <em>${escape(p.model)}</em></span>
            </label>`
          )
          .join('')
      );
    }

    const stats = document.getElementById('rl-stats');
    if (stats) {
      stats.textContent =
        `${health.papers} papers · ${health.passages.toLocaleString('en')} passages · connected`;
    }

    for (const b of document.querySelectorAll<HTMLButtonElement>('.rl-example')) {
      b.disabled = false;
      b.addEventListener('click', () => {
        if (input) input.value = b.dataset.q ?? '';
        form?.requestSubmit();
      });
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const question = input?.value?.trim();
      if (!question || !out) return;

      const provider =
        form.querySelector<HTMLInputElement>('input[name="provider"]:checked')?.value ?? 'local';

      out.hidden = false;
      out.innerHTML =
        '<p class="rl-status">Retrieving evidence, then writing an answer. A local model takes a few seconds.</p>';

      try {
        const res = await fetch(`${api}/ask`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question, provider }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();

        const cites = (data.citations ?? [])
          .map((c: Record<string, string>) => {
            // A live result is an abstract from arXiv or PubMed, not a passage
            // from an indexed paper, and is labelled so a reader is never shown
            // one as though it were the other.
            const live = /^(arxiv|pubmed):/.test(String(c.chunk_id ?? ''));
            return `
              <li class="rl-cite">
                <span class="rl-cite-n">[${c.marker}]${live ? ' <span class="rl-live">live</span>' : ''}</span>
                <span class="rl-cite-src">${escape(c.doc_title ?? '')}</span>
                <span class="rl-cite-loc">${escape(c.section_heading ?? '')} · p${escape(c.pages ?? '')}</span>
                <blockquote class="rl-quote">${escape(c.quote ?? '')}</blockquote>
              </li>`;
          })
          .join('');

        const timing =
          `<p class="rl-timing">${escape(data.model ?? '')} · retrieval ${Math.round(data.retrieval_ms)} ms · generation ${Math.round(data.generation_ms)} ms</p>`;

        out.innerHTML =
          `<div class="rl-text">${escape(data.text ?? '')}</div>` +
          (cites ? `<p class="rl-cite-h">Evidence</p><ol class="rl-cites">${cites}</ol>` : '') +
          timing;
      } catch (err) {
        out.innerHTML =
          `<p class="rl-status rl-error">The instance stopped answering (${escape(String(err))}). Check the terminal running it.</p>`;
      }
    });
  }

  findInstance().then((found) => (found ? wire(found.api, found.health) : showFallback()));
</script>

<style>
  .rl { display: grid; gap: 2.4rem; }

  .rl-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.5rem;
  }
  .rl-title {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.05;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  .rl-lede {
    font-size: var(--t-md);
    line-height: 1.65;
    color: var(--ink);
    max-width: var(--measure);
    margin: 0 0 0.7rem;
  }
  .rl-sub { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); margin: 0; }

  .rl-h2 {
    font-family: var(--font-body);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.07em;
    font-size: var(--t-lg);
    margin: 0 0 1rem;
  }

  .rl-form { display: grid; gap: 0.7rem; max-width: 46rem; }
  .rl-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rl-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .rl-input {
    flex: 1 1 20rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--t-base);
    padding: 0.6rem 0.8rem;
    color: var(--ink);
    background: var(--paper-raised);
    border: var(--rule) solid color-mix(in srgb, var(--brass) 50%, transparent);
  }
  .rl-input:focus-visible { outline: 2px solid var(--brass); outline-offset: 1px; }
  .rl-send {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.6rem 1.3rem;
    color: var(--paper);
    background: var(--ink);
    border: var(--rule) solid var(--ink);
    cursor: pointer;
  }
  .rl-send:hover { background: var(--oxblood); border-color: var(--oxblood); }

  .rl-models { border: 0; padding: 0; margin: 0; display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: center; }
  .rl-legend {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0;
  }
  .rl-radio { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--t-sm); color: var(--ink); }
  .rl-radio em { color: var(--ink-soft); font-style: italic; }
  .rl-hint { font-size: var(--t-xs); color: var(--ink-soft); margin: 0; max-width: 60ch; }

  .rl-offline {
    border-left: 2px solid var(--oxblood);
    background: var(--paper-raised);
    padding: 1.1rem 1.3rem;
    max-width: var(--measure);
    display: grid;
    gap: 0.7rem;
  }
  .rl-offline p { margin: 0; font-size: var(--t-sm); line-height: 1.7; color: var(--ink-soft); }
  .rl-offline-h {
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oxblood-text);
  }
  .rl-code {
    margin: 0;
    padding: 0.8rem 1rem;
    background: var(--paper);
    border: var(--rule) solid color-mix(in srgb, var(--brass) 40%, transparent);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.8;
  }
  .rl-offline-note code { font-family: var(--font-mono); font-size: 0.95em; }

  /* The embedded Space. Tall enough that a question and its evidence are
     visible together — a shorter frame turns reading the evidence into
     scrolling inside a scroll, which nobody does. */
  .rl-space { display: grid; gap: 0.8rem; }
  .rl-space-note {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
    max-width: var(--measure);
  }
  .rl-frame {
    width: 100%;
    height: min(78vh, 46rem);
    border: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    background: var(--paper-raised);
  }

  .rl-examples { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .rl-example {
    font-family: var(--font-body);
    font-size: var(--t-xs);
    text-align: left;
    padding: 0.45rem 0.8rem;
    color: var(--ink-soft);
    background: transparent;
    border: var(--rule) dashed color-mix(in srgb, var(--brass) 45%, transparent);
    cursor: pointer;
    max-width: 34ch;
  }
  .rl-example:hover:not(:disabled) { color: var(--ink); border-style: solid; }
  .rl-example:disabled { cursor: default; opacity: 0.55; }

  .rl-answer { margin-top: 1.6rem; max-width: var(--measure); }
  .rl-status { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); }
  .rl-error { color: var(--oxblood-text); }
  .rl-text { font-size: var(--t-base); line-height: 1.75; }
  .rl-cite-h {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 1.4rem 0 0.6rem;
  }
  .rl-cites { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .rl-cite {
    display: grid;
    gap: 0.2rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 34%, transparent);
    padding-top: 0.6rem;
  }
  .rl-cite-n { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--brass-text); }
  /* Marks a citation that came from a live search rather than the indexed
     corpus, so an abstract is never mistaken for a passage from a full paper. */
  .rl-live {
    font-family: var(--font-mono);
    font-size: 0.85em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--verdigris);
    border: 1px solid color-mix(in srgb, var(--verdigris) 45%, transparent);
    padding: 0 0.3em;
    border-radius: 2px;
  }
  .rl-timing {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin: 1.1rem 0 0;
  }
  .rl-cite-src { font-size: var(--t-sm); color: var(--ink); }
  .rl-cite-loc { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); }
  .rl-quote {
    margin: 0.35rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid color-mix(in srgb, var(--brass) 55%, transparent);
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .rl-pipe { list-style: none; margin: 0 0 1.4rem; padding: 0; display: grid; gap: 0.5rem; max-width: 44rem; }
  .rl-pipe-item {
    display: grid;
    grid-template-columns: 2.2rem 6.5rem 1fr;
    gap: 0.8rem;
    align-items: baseline;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 30%, transparent);
    padding-top: 0.45rem;
  }
  .rl-pipe-n { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--brass-text); }
  .rl-pipe-step {
    font-family: var(--font-body);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: var(--t-base);
    color: var(--ink);
  }
  .rl-pipe-detail { font-size: var(--t-sm); color: var(--ink-soft); line-height: 1.6; }
  @media (max-width: 34rem) {
    .rl-pipe-item { grid-template-columns: 2rem 1fr; }
    .rl-pipe-detail { grid-column: 2; }
  }

  .rl-note { font-size: var(--t-sm); line-height: 1.75; color: var(--ink-soft); margin: 0 0 0.9rem; }
  .rl-note em { font-family: var(--font-mono); font-style: normal; font-size: 0.92em; color: var(--ink); }
  .rl-pending {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.8;
    color: var(--ink-soft);
    background: var(--paper-raised);
