---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LesionRule from '../../../components/ornament/LesionRule.astro';
import { getLectiones } from '../../../lib/collections';
import { toRoman, AUTHOR } from '../../../consts';

export async function getStaticPaths() {
  const parts = await getLectiones();
  return parts.map((entry, i) => ({
    params: { part: String(entry.data.part) },
    props: { entry, prev: parts[i - 1] ?? null, next: parts[i + 1] ?? null },
  }));
}

interface Props {
  entry: CollectionEntry<'lectiones'>;
  prev: CollectionEntry<'lectiones'> | null;
  next: CollectionEntry<'lectiones'> | null;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

/** Where a paper appeared, in the form a citation takes: venue, then year. */
const provenance = (r: (typeof d.readings)[number]) =>
  [r.authors, r.venue, r.year].filter(Boolean).join(' · ');
---
<BaseLayout
  title={`Lectio ${toRoman(d.part)} · ${d.title} — ${AUTHOR}`}
  description={d.summary}
  folio={d.part}
  type="article"
>
  <article class="codex lp">
    <header class="lp-head">
      <p class="lp-kicker" data-reveal>
        <a class="lp-up" href="/marginalia/lectiones">Lectiones</a>
        <span aria-hidden="true"> · </span>Part {toRoman(d.part)}
      </p>
      <h1 class="lp-h1" data-press>{d.title}</h1>
      <p class="lp-gloss codex-measure" data-reveal>{d.gloss}</p>
    </header>

    <div class="prose lp-intro codex-measure"><Content /></div>

    <LesionRule />

    <h2 class="lp-h2">The reading</h2>

    <ol class="lp-list" data-reveal-stagger>
      {d.readings.map((r, i) => (
        <li class="lp-item">
          <div class="lp-item-head">
            <span class="lp-i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="lp-alias">{r.alias}</span>
          </div>
          <h3 class="lp-title">
            {r.url ? (
              <a class="lp-paper" href={r.url} rel="noopener">{r.title}</a>
            ) : (
              r.title
            )}
          </h3>
          <p class="lp-prov">{provenance(r)}</p>
          <dl class="lp-notes">
            <div class="lp-note">
              <dt>Claim</dt>
              <dd>{r.claim}</dd>
            </div>
            <div class="lp-note">
              <dt>Why</dt>
              <dd>{r.why}</dd>
            </div>
            {r.readFor && (
              <div class="lp-note">
                <dt>Read</dt>
                <dd>{r.readFor}</dd>
              </div>
            )}
          </dl>
        </li>
      ))}
    </ol>

    <LesionRule />

    <nav class="lp-nav" aria-label="Parts">
      {prev ? (
        <a class="lp-nav-link" href={`/marginalia/lectiones/${prev.data.part}`}>
          <span class="lp-nav-label">Part {toRoman(prev.data.part)}</span>
          <span class="lp-nav-title">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="lp-nav-link lp-nav-next" href={`/marginalia/lectiones/${next.data.part}`}>
          <span class="lp-nav-label">Part {toRoman(next.data.part)}</span>
          <span class="lp-nav-title">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .lp { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .lp-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.9rem;
  }
  .lp-up { color: inherit; }
  .lp-up:hover { color: var(--fundus); }
  .lp-h1 { font-size: var(--t-2xl); line-height: 1.08; margin-bottom: 0.7rem; max-width: 24ch; }
  .lp-gloss {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--t-md);
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }
  .lp-intro { margin-bottom: 1rem; }

  .lp-h2 {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 1.4rem;
  }

  .lp-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    max-width: 52rem;
  }
  .lp-item {
    padding: 1.6rem 0 1.8rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 40%, transparent);
  }
  .lp-item:last-child {
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 40%, transparent);
  }
  .lp-item-head {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .lp-i {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: color-mix(in srgb, var(--brass-text) 75%, transparent);
    font-variant-numeric: lining-nums;
  }
  .lp-alias {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
    border: var(--rule) solid color-mix(in srgb, var(--brass) 50%, transparent);
    padding: 0.22em 0.6em 0.16em;
  }
  .lp-title {
    font-family: var(--font-display);
    font-size: var(--t-md);
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }
  .lp-paper { color: var(--ink); }
  .lp-paper:hover { color: var(--fundus); }
  .lp-prov {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
  }

  .lp-notes { margin: 0; }
  .lp-note {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 0.4rem 0;
  }
  .lp-note dt {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .lp-note dd {
    margin: 0;
    font-size: var(--t-base);
    line-height: 1.62;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .lp-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .lp-nav-next { text-align: right; }
  .lp-nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.4rem;
  }
  .lp-nav-title { font-family: var(--font-display); font-size: var(--t-md); color: var(--fundus); }

  @media (max-width: 640px) {
    .lp-h1 { font-size: var(--t-xl); }
    .lp-note { grid-template-columns: 1fr; gap: 0.15rem; }
    .lp-nav { flex-direction: column; gap: 1.4rem; }
    .lp-nav-next { text-align: left; }
  }
</style>
