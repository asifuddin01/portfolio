---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookReader from '../../components/book/BookReader.astro';
import { getTabulae } from '../../lib/collections';
import { toRoman } from '../../consts';

export async function getStaticPaths() {
  const tabulae = await getTabulae();
  return tabulae.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      n: i + 1,
      next: tabulae[(i + 1) % tabulae.length],
      nextN: ((i + 1) % tabulae.length) + 1,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'art'>;
  n: number;
  next: CollectionEntry<'art'>;
  nextN: number;
}
const { entry, n, next, nextN } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const alt =
  d.alt && d.alt.trim() !== ''
    ? d.alt
    : `${d.title}${d.artist ? `, ${d.artist}` : ''}`;

const meta = [
  { label: 'Artist', value: d.artist },
  { label: 'Date', value: d.date },
].filter((m) => m.value);
---
<BaseLayout
  title={`Tabula ${toRoman(n)} · ${d.title} — Md. Asif Uddin`}
  description={d.gloss || `${d.title}, ${d.artist}`}
  folio={n}
  type="article"
  book="tabulae"
>
  {/* An art book's opening: the plate on the right-hand page, its text
      facing it on the left. The plate is first in the source so that it is
      also first in the reader and on a phone. */}
  <article class="codex tab sheet sheet--spread" data-folio={toRoman(n).toLowerCase()} data-book-source>
    <figure class:list={['spread-recto', 'tab-fig', `art--${d.treatment}`]} data-reveal>
      <div class="tab-frame plate-art">
        <Image
          src={d.image}
          alt={alt}
          widths={[420, 720, 1000, 1400]}
          sizes="(max-width: 900px) 92vw, 42vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={74}
        />
      </div>
      <figcaption class="tab-cap">
        <span class="tab-cap-n">Tabula {toRoman(n)}</span>
        {d.gloss && <span class="tab-gloss">{d.gloss}</span>}
      </figcaption>
    </figure>

    <div class="spread-verso tab-text">
      <p class="tab-trail book-head"><a href="/tabulae">Tabulae</a> · Tabula {toRoman(n)}</p>
      <header class="tab-head book-chapter-head">
        <p class="tab-n" data-reveal>Tabula {toRoman(n)}</p>
        <h1 class="tab-title" data-press>{d.title}</h1>
        {d.subtitle && <p class="tab-sub" data-reveal>{d.subtitle}</p>}
        <p class="tab-attr" data-reveal>{[d.artist, d.date].filter(Boolean).join(', ')}</p>
        <span class="book-orn" aria-hidden="true"></span>
        <p class="tab-read"><BookReader head="Tabulae" title={d.title} /></p>
      </header>

      <dl class="tab-meta" data-reveal-stagger>
        {meta.map((m) => (
          <div class="tab-meta-row"><dt>{m.label}</dt><dd>{m.value}</dd></div>
        ))}
        <div class="tab-meta-row">
          <dt>Source</dt>
          <dd>
            {d.source ? <a class="link" href={d.source} rel="noopener">{d.credit}</a> : d.credit}
          </dd>
        </div>
      </dl>

      <div class="prose tab-body book-text"><Content /></div>

      <nav class="tab-next" aria-label="Next plate" data-book-skip>
        <a class="tab-next-link" href={`/tabulae/${next.id}`} data-magnet>
          <span class="tab-next-label">Turn the page — Tabula {toRoman(nextN)}</span>
          <span class="tab-next-title">{next.data.title}</span>
        </a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .tab.sheet--spread { align-items: start; }
  .tab-fig { grid-column: 2; grid-row: 1; margin: 0; position: sticky; top: 5.5rem; display: grid; gap: 1rem; justify-items: center; }
  .tab-text { grid-column: 1; grid-row: 1; }
  @media (max-width: 56rem) {
    .tab-fig, .tab-text { grid-column: 1; grid-row: auto; }
    .tab-fig { position: static; }
  }
  /* The reader sets the page as a column flow, and a sticky box there stops
     following its own column: it pins and paints over the next one, which
     put the plate's caption across the title. Nothing to stick to anyway —
     the reader's pages do not scroll. The plate's own 74vh is taller than a
     reader page, so a tall plate overflowed its column onto the next page's
     text; it is scoped out of the reader above, which caps a captioned
     figure's image at a fraction of the page so the caption keeps its place
     under the plate instead of being pushed onto the facing page. */
  :global(.br-flow) .tab-fig { position: static; }
  /* On the page the plate's number sits under the plate and again over the
     title, a spread apart. The reader sets them in one flow, where they can
     land a line apart and read as a stutter. The number belongs to the plate
     it labels, so the title keeps the name and gives the number up. */
  :global(.br-flow) .tab-n { display: none; }
  /* ...which leaves the caption and the title in one column, a line apart. */
  :global(.br-flow) .tab-cap { margin-bottom: 1.4rem; }
  .tab-frame {
    width: 100%;
    padding: clamp(1rem, 2.4vw, 1.8rem);
    border: 0.5px solid color-mix(in srgb, var(--brass) 70%, transparent);
    outline: 0.5px solid color-mix(in srgb, var(--brass) 45%, transparent);
  outline-offset: -6px;
    overflow: hidden;
  }
  .tab-frame :global(img) { width: 100%; height: auto; display: block; object-fit: contain; }
  /* A plate fills most of the window, but not past it. Scoped away from the
     reader, which measures against the page it is drawing, not the viewport. */
  :global(html:not(.br-is-open)) .tab-frame :global(img) { max-height: 74vh; }
  .tab-cap { display: grid; gap: 0.4rem; justify-items: center; text-align: center; }
  .tab-cap-n { font-size: var(--t-sm); letter-spacing: 0.3em; text-transform: uppercase; color: var(--brass-text); }
  .tab-gloss { font-style: italic; font-size: var(--t-md); color: var(--ink-soft); max-width: 44ch; line-height: 1.5; }

  .tab-trail a { color: inherit; }
  .tab-n { font-size: var(--t-sm); letter-spacing: 0.3em; text-transform: uppercase; color: var(--brass-text); margin: 0 0 0.8rem; }
  .tab-title { font-size: clamp(var(--t-xl), 3.6vw, 3.2rem); line-height: 1.08; margin: 0 auto 0.6rem; max-width: 22ch; }
  .tab-sub { font-family: var(--font-display); font-style: italic; font-size: var(--t-lg); line-height: 1.3; max-width: 30ch; margin: 0 auto 0.8rem; }
  .tab-attr { font-size: var(--t-sm); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); margin: 0; }
  .tab-read { margin: 0.4rem 0 0; }

  .tab-meta {
    margin: 0 auto 2.2rem;
    max-width: var(--measure);
    border-top: 0.5px solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .tab-meta-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 0.5px solid color-mix(in srgb, var(--brass) 28%, transparent);
  }
  .tab-meta dt { font-size: var(--t-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass-text); }
  .tab-meta dd { margin: 0; font-size: var(--t-sm); color: var(--ink-soft); }
  /* The body is set by .book-text; it only needs to fill the left page. */
  .tab-body { max-width: none; }

  .tab-next { margin: 2.6rem 0 0; padding-top: 1rem; border-top: 0.5px solid color-mix(in srgb, var(--brass) 40%, transparent); text-align: right; }
  .tab-next-link { display: inline-block; }
  .tab-next-label {
    display: block;
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.35rem;
  }
  .tab-next-title { font-family: var(--font-display); font-size: var(--t-md); color: var(--fundus); }

  @media (max-width: 640px) {
    .tab-meta-row { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
