---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import ArtPlate from '../../components/art/ArtPlate.astro';
import { getEntry } from 'astro:content';
import { getTabulae } from '../../lib/collections';

const tabulae = await getTabulae();
const meta = await getEntry('site', 'tabulae');
---
<BaseLayout
  title="Tabulae — Md. Asif Uddin"
  description="The interleaved plates: engravings, drawings and sculpture that sit between the chapters, each with a note on where it came from."
  folio="T"
>
  <div class="codex tb">
    <header class="tb-head">
      {meta?.data.kicker && <p class="tb-kicker" data-reveal>{meta.data.kicker}</p>}
      <h1 class="tb-h1" data-press>{meta?.data.title ?? 'Tabulae'}</h1>
      {meta?.data.lede && <p class="tb-lede codex-measure" data-reveal>{meta.data.lede}</p>}
    </header>

    <LesionRule />

    {tabulae.length === 0 ? (
      <p class="tb-empty">No plates yet.</p>
    ) : (
      <div class="tb-grid" data-reveal-stagger>
        {tabulae.map((t, i) => (
          <ArtPlate entry={t} n={i + 1} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 44vw, 22rem" />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .tb { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .tb-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .tb-h1 { font-size: var(--t-2xl); margin-bottom: 1.2rem; }
  .tb-lede { font-size: var(--body-size); line-height: var(--body-leading); }
  .tb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 3rem 2.5rem;
    align-items: start;
  }
  .tb-empty { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); }
</style>
