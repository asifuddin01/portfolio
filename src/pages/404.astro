---
import BaseLayout from '../layouts/BaseLayout.astro';
import LesionRule from '../components/ornament/LesionRule.astro';
import { AUTHOR } from '../consts';
---
<BaseLayout
  title={`Not found — ${AUTHOR}`}
  description="No page at this address."
  folio="—"
>
  <div class="codex nf">
    <p class="nf-kicker" data-reveal>Folio wanting</p>
    <h1 class="nf-h1" data-press>No page here</h1>
    <p class="nf-lede codex-measure" data-reveal>
      The address is wrong, or the page it named has been renamed since
      somebody wrote the link down. Nothing is broken.
    </p>

    <LesionRule />

    <nav class="nf-nav" aria-label="Elsewhere on the site" data-reveal-stagger>
      <a class="nf-link" href="/home"><span>The codex</span><em>Everything, in order</em></a>
      <a class="nf-link" href="/papers"><span>Papers</span><em>Published work and manuscripts</em></a>
      <a class="nf-link" href="/elementa"><span>Elementa</span><em>A course in deep learning</em></a>
      <a class="nf-link" href="/marginalia"><span>Marginalia</span><em>Reviews and notes</em></a>
      <a class="nf-link" href="/tabulae"><span>Tabulae</span><em>The plates</em></a>
      <a class="nf-link" href="/vitae"><span>Vitae</span><em>The curriculum vitae</em></a>
    </nav>
  </div>
</BaseLayout>

<style>
  .nf { padding-top: clamp(3rem, 12vh, 7rem); }
  .nf-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .nf-h1 { font-size: var(--t-2xl); margin-bottom: 1.2rem; }
  .nf-lede { font-size: var(--body-size); line-height: var(--body-leading); }
  .nf-nav {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 0;
    max-width: 62rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .nf-link {
    display: block;
    padding: 1rem 1.2rem 1rem 0;
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent);
    color: var(--ink);
  }
  .nf-link span { display: block; font-family: var(--font-display); font-size: var(--t-md); }
  .nf-link em {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-style: normal;
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }
  .nf-link:hover span { color: var(--fundus); }
</style>
