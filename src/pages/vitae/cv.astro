---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProofSheet from '../../components/cv/ProofSheet.astro';
import { loadCv, CV_PDF } from '../../lib/cv-page.mjs';
import { AUTHOR } from '../../consts';

const cv = await loadCv();
---
<BaseLayout
  title={`Curriculum vitae, in proof — ${AUTHOR}`}
  description={`The curriculum vitae of ${AUTHOR}, section by section, with the PDF generated from it.`}
  folio="V.i"
>
  <div class="codex pf">
    <ProofSheet cv={cv} pdfHref={CV_PDF} />
  </div>
</BaseLayout>

<style>
  .pf { padding-top: clamp(2.5rem, 7vh, 5rem); }
</style>
