---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import { buildCv, type CvItem, type CvSection } from '../../lib/cv-data.mjs';
import { AUTHOR, SITE, EMAIL, GITHUB, LINKEDIN, LOCATION } from '../../consts';

const [site, works, papers, education, projects, skills] = await Promise.all([
  getCollection('site'),
  getCollection('works'),
  getCollection('papers'),
  getCollection('education'),
  getCollection('projects'),
  getCollection('instrumentarium'),
]);

/* The same shaping function the build script uses, so the proof on screen and
   the published PDF are the same document. */
const cv = buildCv({
  site, works, papers, education, projects, skills,
  author: AUTHOR,
  siteUrl: SITE,
  fallback: { email: EMAIL, github: GITHUB, linkedin: LINKEDIN, location: LOCATION },
});

const PDF = '/cv/Md-Asif-Uddin-CV.pdf';

/**
 * Flattened for the template: each entry becomes a list of labelled fields
 * with the path the editor writes back to. Doing it here rather than inline
 * keeps the markup free of casts, and means the page renders any section
 * cv-data produces without knowing what kind it is.
 */
const LABELS: Record<string, string> = {
  title: 'Title', right: 'Date', subtitle: 'What it does', detail: 'Detail',
};
const FIELDS = ['title', 'right', 'subtitle', 'detail'];

interface ProofField { key: string; label: string; value: string; path: string }
interface ProofItem { path: string; fields: ProofField[] }
interface ProofBox { id: string; heading: string; items: ProofItem[] }

const boxes: ProofBox[] = cv.sections.map((sec: CvSection, si: number) => ({
  id: sec.id,
  heading: sec.heading,
  items: sec.items.map((item: CvItem, ii: number) => ({
    path: `sections.${si}.items.${ii}`,
    fields: FIELDS
      .filter((f) => (item as Record<string, string | undefined>)[f])
      .map((f) => ({
        key: f,
        label: LABELS[f] ?? f,
        value: (item as Record<string, string>)[f],
        path: `sections.${si}.items.${ii}.${f}`,
      })),
  })),
}));
---
<BaseLayout
  title={`Curriculum vitae, in proof — ${AUTHOR}`}
  description={`The curriculum vitae of ${AUTHOR}, section by section, with the PDF generated from it.`}
  folio="V.i"
>
  <div class="codex pf">
    <header class="pf-head">
      <p class="pf-kicker" data-reveal>Vitae</p>
      <h1 class="pf-h1" data-press>The curriculum vitae, in proof</h1>
      <p class="pf-lede codex-measure" data-reveal>
        Every section of the CV as it will be set, drawn from the same content as
        the rest of this site. The PDF below is generated from exactly this.
      </p>

      <div class="pf-actions" data-reveal>
        <a class="pf-btn" href={PDF} download>Download the PDF</a>
        <button class="pf-btn pf-owner" type="button" data-generate hidden>Generate PDF from this proof</button>
        <button class="pf-btn pf-owner pf-quiet" type="button" data-reset hidden>Reset to the site</button>
        <button class="pf-btn pf-owner pf-quiet" type="button" data-lock hidden>Stop editing</button>
        <span class="pf-state pf-owner" data-state hidden></span>
        <span class="pf-status" data-status role="status" aria-live="polite"></span>
      </div>

      <p class="pf-note pf-owner codex-measure" data-reveal hidden>
        Editing is on. Changes stay in this browser and shape only the PDF you
        generate here — the published file and the site itself are untouched.
        To change those, edit the content in <a class="link" href="/admin">/admin</a>.
        Stop editing hides all of this again; add <code>#edit</code> to the address to bring it back.
      </p>
    </header>

    <LesionRule />

    <div class="pf-sheet" data-proof>
      <section class="pf-box" aria-labelledby="pf-mast">
        <h2 class="pf-box-h" id="pf-mast">Masthead</h2>
        <div class="pf-grid">
          <div class="pf-f">
            <span class="pf-lab">Name</span>
            <div class="pf-v pf-v-lg" data-path="author">{cv.author}</div>
          </div>
          {cv.contact.map((line: string, i: number) => (
            <div class="pf-f">
              <span class="pf-lab">Contact {i + 1}</span>
              <div class="pf-v" data-path={`contact.${i}`}>{line}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="pf-box" aria-labelledby="pf-sum">
        <h2 class="pf-box-h" id="pf-sum">Summary</h2>
        <div class="pf-f">
          <div class="pf-v" data-path="summary">{cv.summary}</div>
        </div>
      </section>

      {boxes.map((sec) => (
        <section class="pf-box" aria-labelledby={`pf-${sec.id}`}>
          <div class="pf-box-bar">
            <h2 class="pf-box-h" id={`pf-${sec.id}`}>{sec.heading}</h2>
            <span class="pf-count">{sec.items.length} {sec.items.length === 1 ? 'entry' : 'entries'}</span>
          </div>
          <ol class="pf-items">
            {sec.items.map((item) => (
              <li class="pf-item">
                <label class="pf-omit pf-owner" hidden>
                  <input type="checkbox" checked data-include={item.path} />
                  <span>include</span>
                </label>
                <div class="pf-grid">
                  {item.fields.map((f) => (
                    <div class="pf-f">
                      <span class="pf-lab">{f.label}</span>
                      <div
                        class:list={['pf-v', { 'pf-v-t': f.key === 'title' }]}
                        data-path={f.path}
                      >{f.value}</div>
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <LesionRule />

    <p class="pf-foot codex-measure">
      No phone number appears here or in the PDF: this page is public, and a
      number on a public page is a different exposure from one on a CV handed to
      a person. <a class="link" href="/vitae">The vitae page</a> reads the same
      content in full.
    </p>
  </div>

  <script is:inline type="application/json" id="pf-data" set:html={JSON.stringify(cv)} />
</BaseLayout>

<script>
  /**
   * The proof page. Read-only for everyone; editing appears once the page has
   * been unlocked with #edit, which is a courtesy gate rather than a security
   * boundary — nothing on a static page can stop a determined person editing
   * the DOM. What it does prevent is a stranger generating a CV under someone
   * else's name in one click.
   *
   * Edits never leave the browser. They are applied to a copy of the data on
   * the way into the PDF renderer, which is the same module the build script
   * uses, so a tailored CV is set exactly like the published one.
   */
  const UNLOCK = 'codex-cv-edit';
  const DRAFT = 'codex-cv-draft';

  function setup() {
    const holder = document.getElementById('pf-data');
    const root = document.querySelector('[data-proof]');
    if (!holder || !root) return;

    const base = JSON.parse(holder.textContent || '{}');
    const status = document.querySelector('[data-status]');
    const fields = [...document.querySelectorAll('[data-path]')] as HTMLElement[];

    const state = document.querySelector('[data-state]');
    const say = (msg: string) => { if (status) status.textContent = msg; };
    const mark = (msg: string) => { if (state) state.textContent = msg; };

    /* ---- unlocking ---- */
    if (location.hash === '#edit') {
      try { localStorage.setItem(UNLOCK, 'on'); } catch {}
      history.replaceState(null, '', location.pathname);
    }
    let unlocked = false;
    try { unlocked = localStorage.getItem(UNLOCK) === 'on'; } catch {}
    if (!unlocked) return;

    /* Unlocking from the address bar arrives as a hashchange on a page that is
       already wired, so bail rather than binding every listener twice. */
    if (root.classList.contains('is-editable')) return;
    for (const el of document.querySelectorAll('.pf-owner')) el.removeAttribute('hidden');
    root.classList.add('is-editable');

    /* plaintext-only keeps pasted markup out; older engines fall back to true
       and the value is read with textContent either way. */
    const mode = 'plaintext-only';
    for (const el of fields) {
      el.setAttribute('contenteditable', mode);
      el.setAttribute('spellcheck', 'false');
      if (el.contentEditable !== mode) el.setAttribute('contenteditable', 'true');
    }

    /* ---- drafts, kept in this browser only ---- */
    const readDraft = () => {
      try { return JSON.parse(localStorage.getItem(DRAFT) || '{}'); } catch { return {}; }
    };
    const writeDraft = (d: Record<string, unknown>) => {
      try { localStorage.setItem(DRAFT, JSON.stringify(d)); } catch {}
    };

    const draft = readDraft();
    for (const el of fields) {
      const path = el.dataset.path!;
      if (typeof draft[path] === 'string') el.textContent = draft[path] as string;
    }
    for (const box of document.querySelectorAll<HTMLInputElement>('[data-include]')) {
      if (draft[`!${box.dataset.include}`] === false) box.checked = false;
    }
    const dirty = Object.keys(draft).length > 0;
    mark(dirty ? 'edited in this browser' : 'matches the site');

    let timer: number | undefined;
    const save = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        const d: Record<string, unknown> = {};
        for (const el of fields) {
          const path = el.dataset.path!;
          const value = (el.textContent || '').trim();
          if (value !== String(get(base, path) ?? '').trim()) d[path] = value;
        }
        for (const box of document.querySelectorAll<HTMLInputElement>('[data-include]')) {
          if (!box.checked) d[`!${box.dataset.include}`] = false;
        }
        writeDraft(d);
        mark(Object.keys(d).length ? 'edited in this browser' : 'matches the site');
      }, 350);
    };
    root.addEventListener('input', save);
    root.addEventListener('change', save);

    /* ---- path helpers ---- */
    function get(obj: any, path: string) {
      return path.split('.').reduce((o, k) => (o == null ? o : o[k]), obj);
    }
    function set(obj: any, path: string, value: unknown) {
      const keys = path.split('.');
      const last = keys.pop()!;
      const target = keys.reduce((o, k) => (o == null ? o : o[k]), obj);
      if (target) target[last] = value;
    }

    /* ---- generate ---- */
    document.querySelector('[data-generate]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      say('setting the type…');
      try {
        const data = JSON.parse(JSON.stringify(base));
        for (const el of fields) set(data, el.dataset.path!, (el.textContent || '').trim());

        /* Drop excluded entries back to front so the indices stay valid. */
        const drops = [...document.querySelectorAll<HTMLInputElement>('[data-include]')]
          .filter((b) => !b.checked)
          .map((b) => b.dataset.include!)
          .sort()
          .reverse();
        for (const path of drops) {
          const m = path.match(/^sections\.(\d+)\.items\.(\d+)$/);
          if (m) data.sections[+m[1]].items.splice(+m[2], 1);
        }
        data.sections = data.sections.filter((s: any) => s.items.length);

        const { renderCv } = await import('../../lib/cv-layout.mjs');
        const { bytes, pages } = await renderCv(data);
        const blob = new Blob([bytes as BlobPart], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${String(data.author).replace(/[^\w]+/g, '-')}-CV.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 4000);
        say(`${pages} page${pages === 1 ? '' : 's'} — downloaded`);
      } catch (err) {
        console.error(err);
        say('could not generate the PDF — see the console');
      } finally {
        btn.disabled = false;
      }
    });

    /* ---- lock again ---- */
    document.querySelector('[data-lock]')?.addEventListener('click', () => {
      try { localStorage.removeItem(UNLOCK); } catch {}
      location.reload();
    });

    /* ---- reset ---- */
    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      try { localStorage.removeItem(DRAFT); } catch {}
      for (const el of fields) el.textContent = String(get(base, el.dataset.path!) ?? '');
      for (const box of document.querySelectorAll<HTMLInputElement>('[data-include]')) box.checked = true;
      mark('matches the site');
      say('reset to the site');
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
  /* #edit on a page that is already open changes only the hash, which does not
     re-run this module on its own. */
  window.addEventListener('hashchange', setup);
</script>

<style>
  .pf { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .pf-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .pf-h1 { font-size: var(--t-2xl); margin-bottom: 0.9rem; }
  .pf-lede { font-size: var(--body-size); line-height: var(--body-leading); }

  .pf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  .pf-btn {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: var(--rule) solid var(--brass);
    padding: 0.55em 1.1em;
    cursor: pointer;
  }
  .pf-btn:hover { border-color: var(--fundus); color: var(--fundus); }
  .pf-btn[disabled] { opacity: 0.5; cursor: progress; }
  .pf-quiet { border-color: color-mix(in srgb, var(--brass) 45%, transparent); }
  .pf-status, .pf-state {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }
  .pf-state {
    border: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    padding: 0.4em 0.7em;
    letter-spacing: 0.06em;
  }
  .pf-note {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.75;
    color: var(--ink-soft);
    border-left: 2px solid color-mix(in srgb, var(--brass) 60%, transparent);
    padding-left: 0.9rem;
  }

  .pf-sheet { display: grid; gap: 1.6rem; max-width: 64rem; }
  .pf-box {
    border: var(--rule) solid color-mix(in srgb, var(--brass) 55%, transparent);
    background: var(--paper-raised);
    padding: 1.2rem 1.4rem 1.4rem;
  }
  .pf-box-bar { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .pf-box-h {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin: 0 0 0.9rem;
  }
  .pf-box-bar .pf-box-h { margin-bottom: 0.9rem; }
  .pf-count { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); }

  .pf-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .pf-item {
    position: relative;
    padding-top: 1.1rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent);
  }
  .pf-item:first-child { padding-top: 0; border-top: 0; }

  .pf-grid { display: grid; gap: 0.6rem; }
  .pf-f { display: grid; gap: 0.2rem; }
  .pf-lab {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--brass-text) 80%, transparent);
  }
  .pf-v {
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 62ch;
    white-space: pre-wrap;
  }
  .pf-v-t { font-family: var(--font-display); font-size: var(--t-md); color: var(--ink); line-height: 1.35; }
  .pf-v-lg { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink); }

  /* Only once editing is unlocked does a field look like somewhere to type. */
  .is-editable .pf-v {
    border: var(--rule) dashed color-mix(in srgb, var(--brass) 45%, transparent);
    padding: 0.35rem 0.5rem;
    margin-left: -0.5rem;
  }
  .is-editable .pf-v:hover { border-style: solid; }
  .is-editable .pf-v:focus {
    outline: none;
    border-color: var(--fundus);
    border-style: solid;
    background: color-mix(in srgb, var(--brass) 8%, transparent);
  }

  .pf-omit {
    float: right;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .pf-omit input { accent-color: var(--brass); }
  .pf-item:has(input[data-include]:not(:checked)) { opacity: 0.42; }

  .pf-foot {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.8;
    color: var(--ink-soft);
    margin-bottom: 2.5rem;
  }

  @media (max-width: 640px) {
    .pf-h1 { font-size: var(--t-xl); }
    .pf-box { padding: 1rem; }
  }
</style>
