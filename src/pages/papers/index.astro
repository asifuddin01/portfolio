---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LesionRule from '../../components/ornament/LesionRule.astro';
import { getPapers, getLectiones, getReviews } from '../../lib/collections';
import { AUTHOR, toRoman } from '../../consts';

const papers = await getPapers();
const parts = await getLectiones();
const lectPapers = parts.reduce((n, p) => n + p.data.readings.length, 0);
const reviews = await getReviews();

/* A protocol is not a manuscript, and the label says which. */
const STAGE: Record<string, string> = {
  protocol: 'Protocol',
  registered: 'Registered',
  screening: 'Screening',
  charting: 'Charting',
  drafting: 'Drafting',
};

const LABEL: Record<string, string> = {
  published: 'Published',
  preprint: 'Preprint',
  'under-review': 'Under review',
  'in-preparation': 'In preparation',
};
---
<BaseLayout
  title={`Published papers — ${AUTHOR}`}
  description="Papers and manuscripts, with links where they are available."
  folio="P"
>
  <div class="codex pp">
    <header class="pp-head">
      <p class="pp-kicker" data-reveal>The record</p>
      <h1 class="pp-h1" data-press>Published papers</h1>
      <p class="pp-lede codex-measure" data-reveal>
        Papers and manuscripts, with a link wherever there is one to give. What a
        piece of work argues lives on its plate; this page is only the citation.
      </p>
      <p class="pp-lede codex-measure" data-reveal>
        Three parts. The first is mine. The second is the reviews under way —
        method rather than manuscript, since nothing is registered until it is.
        The third is everyone else's, in the order they make sense.
      </p>
    </header>

    <LesionRule />

    <h2 class="pp-part" id="mine">
      <span class="pp-part-n" aria-hidden="true">I</span>
      <span class="pp-part-name">The record</span>
      <span class="pp-part-gloss">Mine</span>
    </h2>

    {papers.length === 0 ? (
      <p class="pp-empty">Nothing published yet.</p>
    ) : (
      <ol class="pp-list" data-reveal-stagger>
        {papers.map((p) => (
          <li class="pp-item">
            <div class="pp-top">
              <span class="pp-state">{LABEL[p.data.state]}</span>
              <span class="pp-year">{p.data.year}</span>
            </div>
            <h2 class="pp-title">
              {p.data.url ? (
                <a class="pp-link" href={p.data.url} rel="noopener">{p.data.title}</a>
              ) : (
                p.data.title
              )}
            </h2>
            {p.data.authors.length > 0 && (
              <p class="pp-authors">{p.data.authors.join(', ')}</p>
            )}
            {p.data.venue && <p class="pp-venue">{p.data.venue}</p>}
            <p class="pp-summary">{p.data.summary}</p>
            {(p.data.url || p.data.doi) && (
              <p class="pp-refs">
                {p.data.url && <a class="link" href={p.data.url} rel="noopener">Read it</a>}
                {p.data.url && p.data.doi && <span class="pp-sep"> · </span>}
                {p.data.doi && (
                  <a class="link" href={`https://doi.org/${p.data.doi}`} rel="noopener">
                    doi:{p.data.doi}
                  </a>
                )}
              </p>
            )}
          </li>
        ))}
      </ol>
    )}

    <LesionRule />

    {reviews.length > 0 && (
      <>
        <h2 class="pp-part" id="reviews">
          <span class="pp-part-n" aria-hidden="true">II</span>
          <span class="pp-part-name">Reviews</span>
          <span class="pp-part-gloss">Under way</span>
        </h2>

        <ol class="pp-rv" data-reveal-stagger>
          {reviews.map((r) => (
            <li class="pp-rv-i">
              <p class="pp-rv-top">
                <span class="pp-rv-stage">{STAGE[r.data.stage] ?? r.data.stage}</span>
                <span class="pp-rv-dom">{r.data.domain}</span>
              </p>
              <h3 class="pp-rv-t">{r.data.title}</h3>
              <p class="pp-rv-q">{r.data.question}</p>

              <dl class="pp-rv-meta">
                <div><dt>Reporting</dt><dd>{r.data.framework}</dd></div>
                {r.data.registry && <div><dt>Registry</dt><dd>{r.data.registry}</dd></div>}
                {r.data.instrument && <div><dt>Instrument</dt><dd>{r.data.instrument}</dd></div>}
                {r.data.scale && <div><dt>Scale</dt><dd>{r.data.scale}</dd></div>}
                {r.data.related && (
                  <div>
                    <dt>Supports</dt>
                    <dd><a class="link" href={r.data.related}>{r.data.relatedLabel ?? r.data.related}</a></dd>
                  </div>
                )}
              </dl>
            </li>
          ))}
        </ol>

        <LesionRule />
      </>
    )}

    <h2 class="pp-part" id="lectiones">
      <span class="pp-part-n" aria-hidden="true">III</span>
      <span class="pp-part-name">Lectiones</span>
      <span class="pp-part-gloss">Everyone else's, in order</span>
    </h2>

    <p class="pp-lede codex-measure">
      A reading course, published in parts of three to five papers. Every paper
      appears exactly once, so finishing a part means something. {parts.length} parts
      so far, {lectPapers} papers, each with what it claims and why it is on the list.
    </p>

    {parts.length > 0 && (
      <ol class="pp-parts" data-reveal-stagger>
        {parts.map((p) => (
          <li class="pp-pitem">
            <a class="pp-plink" href={`/marginalia/lectiones/${p.data.part}`}>
              <span class="pp-pnum" aria-hidden="true">{toRoman(p.data.part)}</span>
              <span class="pp-pmain">
                <span class="pp-ptitle">{p.data.title}</span>
                <span class="pp-pgloss">{p.data.gloss}</span>
              </span>
              <span class="pp-pn">{p.data.readings.length}</span>
            </a>
          </li>
        ))}
      </ol>
    )}

    <p class="pp-all">
      <a class="link" href="/marginalia/lectiones">The whole course</a>
    </p>
  </div>
</BaseLayout>

<style>
  /* ---- Reviews under way -------------------------------------------
     A protocol has no abstract to quote and no result to report, so the
     block is a label, a question and a short table of what it commits to.
     Prose here would be longer than the commitments it described. */
  .pp-rv { list-style: none; margin: 0 0 2.4rem; padding: 0; display: grid; gap: 2.2rem; max-width: 64rem; }
  .pp-rv-i {
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
    padding-top: 1rem;
  }
  .pp-rv-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pp-rv-stage {
    color: var(--brass-text);
    border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
    padding: 0 0.4em;
    border-radius: 2px;
  }
  .pp-rv-dom { color: var(--ink-soft); letter-spacing: 0.08em; }
  .pp-rv-t {
    font-family: var(--font-display);
    font-size: var(--t-md);
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 0.35rem;
  }
  .pp-rv-q {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    max-width: var(--measure);
  }
  .pp-rv-meta { margin: 0; display: grid; gap: 0.5rem; }
  .pp-rv-meta > div { display: grid; gap: 0.15rem 1.2rem; }
  @media (min-width: 700px) {
    .pp-rv-meta > div { grid-template-columns: 7.5rem minmax(0, 1fr); }
  }
  .pp-rv-meta dt {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .pp-rv-meta dd {
    margin: 0;
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--ink);
    max-width: var(--measure);
  }

  .pp { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .pp-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.8rem;
  }
  .pp-h1 { font-size: var(--t-2xl); margin-bottom: 1.2rem; }
  .pp-lede { font-size: var(--body-size); line-height: var(--body-leading); }
  .pp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 64rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .pp-item {
    padding: 1.5rem 0;
    border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent);
  }
  .pp-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
    margin-bottom: 0.5rem;
  }
  .pp-title { font-size: var(--t-md); line-height: 1.35; margin-bottom: 0.4rem; max-width: 56ch; }
  .pp-link { color: var(--ink); }
  .pp-link:hover { color: var(--fundus); }
  .pp-authors, .pp-venue {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    margin: 0 0 0.2rem;
  }
  .pp-summary {
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0.5rem 0 0;
    max-width: var(--measure);
  }
  .pp-refs { margin: 0.6rem 0 0; font-family: var(--font-mono); font-size: var(--t-xs); }
  .pp-sep { color: var(--brass-text); }
  .pp-empty { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); }

  /* Numbered halves, matching Marginalia. Two pages carry the same division
     and it should look like the same division. */
  .pp-part {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .pp-part-n {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    color: var(--brass-text);
    min-width: 4rem;
  }
  .pp-part-name { font-family: var(--font-display); font-size: var(--t-lg); color: var(--fundus); }
  .pp-part-gloss {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pp-parts {
    list-style: none;
    margin: 1.4rem 0 1.2rem;
    padding: 0;
    max-width: 64rem;
    border-top: var(--rule) solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  .pp-pitem { border-bottom: var(--rule) solid color-mix(in srgb, var(--brass) 28%, transparent); }
  .pp-plink {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1.2rem;
    align-items: baseline;
    padding: 0.85rem 0;
    color: var(--ink);
  }
  .pp-pnum {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    color: var(--brass-text);
  }
  .pp-pmain { display: block; }
  .pp-ptitle { display: block; font-family: var(--font-display); font-size: var(--t-md); line-height: 1.35; }
  .pp-plink:hover .pp-ptitle { color: var(--fundus); }
  .pp-pgloss { display: block; font-size: var(--t-base); color: var(--ink-soft); margin-top: 0.2rem; line-height: 1.55; }
  .pp-pn { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--ink-soft); white-space: nowrap; }
  .pp-all { font-family: var(--font-mono); font-size: var(--t-xs); margin-bottom: 2rem; }
  .pp-lede + .pp-lede { margin-top: 0.9em; }

  @media (max-width: 700px) {
    .pp-plink { grid-template-columns: 1fr; gap: 0.3rem; }
    .pp-pn { grid-row: 1; }
    .pp-part-n { min-width: 0; }
  }
</style>
